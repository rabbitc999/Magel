import std::sql;
import std::reflect;
import std::json;
import std::parse;

@Reflect
@std::sql::ModelClass("students")
struct Student
{
    @std::sql::ModelField(id: true)
    int64 id;
    String name;
    int64 age;
    String className;
    int64 score;
};

/**
 * @brief 检查学生字段的业务范围，返回可显示的错误。
 * @param student 待保存的学生记录。
 * @return 合法时为空字符串，否则返回校验错误。
 */
String validate(Student const& student)
{
    if (student.id <= 0)
    {
        return "学号必须是正整数";
    }
    if (student.name.trim().isEmpty() || len(student.name) > 120)
    {
        return "姓名必须为 1 到 120 字节的非空文本";
    }
    if (student.className.trim().isEmpty() || len(student.className) > 120)
    {
        return "班级必须为 1 到 120 字节的非空文本";
    }
    if (student.age < 1 || student.age > 150)
    {
        return "年龄必须在 1 到 150 之间";
    }
    if (student.score < 0 || student.score > 100)
    {
        return "成绩必须在 0 到 100 之间";
    }
    return "";
}

/**
 * @brief 从数据库结果按反射字段类型生成 JSON，避免重复列出学生字段。
 * @param rows 参数化查询得到的完整结果。
 * @return 每个学生为一个 JSON 对象的数组文本。
 */
Result<String, String> encodeRows(std::sql::ResultSet const& rows)
{
    auto fields = std::reflect::getStructInfo<Student>().unwrap().fields;
    List<String> records;
    for (int64 row in std::lang::range(0, rows.rowCount()))
    {
        List<String> values;
        for (auto field in fields)
        {
            int64 column = rows.columnIndex(field.name);
            if (column < 0)
            {
                return Result<String, String>::Err("数据库缺少字段：" + field.name);
            }
            String value = rows.textAt(row, column);
            if (field.typeId == std::reflect::getTypeId<String>())
            {
                value = std::reflect::__serdeQuote(value);
            }
            values.push(std::reflect::__serdeQuote(field.name) + ":" + value);
        }
        String separator = ",";
        String text = "{" + separator.join(values) + "}";
        auto checked = std::json::deserialize<Student>(text);
        if (checked.isErr())
        {
            return Result<String, String>::Err("数据库记录不符合学生模型：" + checked.error());
        }
        Student student = checked.unwrap();
        String error = validate(&student);
        if (error != "")
        {
            return Result<String, String>::Err(error);
        }
        String encoded = std::json::serialize<Student>(&student)?;
        records.push(encoded);
    }
    String separator = ",";
    return Result<String, String>::Ok("[" + separator.join(records) + "]");
}

/**
 * @brief 执行一条学生管理命令，所有用户值均由生成器绑定为 SQL 参数。
 * @param database 独占连接的可变借用。
 * @param args 数据库路径、命令及其参数。
 * @return 成功时为输出文本，否则返回原始数据库或业务诊断。
 */
Result<String, String> execute(std::sql::Database mut& database, List<String> const& args)
{
    auto query = std::sql::query<Student>()?;
    String command = args[1];
    if (command == "schema" && args.len() == 2)
    {
        auto fields = std::reflect::getStructInfo<Student>().unwrap().fields;
        List<String> names;
        for (auto field in fields)
        {
            names.push(field.name);
        }
        String separator = ", ";
        return Result<String, String>::Ok("Student: " + separator.join(names));
    }
    if ((command == "add" || command == "update") && args.len() == 3)
    {
        Student student = std::json::deserialize<Student>(args[2])?;
        String error = validate(&student);
        if (error != "")
        {
            return Result<String, String>::Err(error);
        }
        if (command == "update")
        {
            std::sql::filter<int64>(&query, "id", student.id)?;
        }
        auto statement = std::sql::insert<Student>(&query, &student);
        if (command == "update")
        {
            statement = std::sql::update<Student>(&query, &student);
        }
        auto prepared = statement?;
        auto rows = database.exec(prepared);
        if (!rows.ok)
        {
            return Result<String, String>::Err(rows.error);
        }
        if (rows.affected != 1)
        {
            return Result<String, String>::Err("学生不存在");
        }
        String encoded = std::json::serialize<Student>(&student)?;
        return Result<String, String>::Ok(encoded);
    }
    if ((command == "get" || command == "delete") && args.len() == 3)
    {
        auto parsed = std::parse::Parse::parseInt64(args[2]);
        if (parsed.isErr() || parsed.unwrap() <= 0)
        {
            return Result<String, String>::Err("学号必须是正整数");
        }
        std::sql::filter<int64>(&query, "id", parsed.unwrap())?;
        String operation = "select";
        if (command == "delete")
        {
            operation = "delete";
        }
        auto prepared = query.build(operation)?;
        auto rows = database.exec(prepared);
        if (!rows.ok)
        {
            return Result<String, String>::Err(rows.error);
        }
        if (command == "delete")
        {
            if (rows.affected != 1)
            {
                return Result<String, String>::Err("学生不存在");
            }
            return Result<String, String>::Ok("已删除");
        }
        if (rows.isEmpty())
        {
            return Result<String, String>::Err("学生不存在");
        }
        return encodeRows(&rows);
    }
    if ((command == "list" && args.len() <= 4) || (command == "search" && args.len() == 3))
    {
        if (command == "search")
        {
            std::sql::filter<String>(&query, "name", args[2], 6)?;
        }
        String field = "id";
        bool descending = false;
        if (command == "list" && args.len() >= 3)
        {
            field = args[2];
        }
        if (command == "list" && args.len() == 4)
        {
            if (args[3] != "asc" && args[3] != "desc")
            {
                return Result<String, String>::Err("排序方向必须是 asc 或 desc");
            }
            descending = args[3] == "desc";
        }
        query.orderBy(field, descending);
        auto prepared = query.build()?;
        auto rows = database.exec(prepared);
        if (!rows.ok)
        {
            return Result<String, String>::Err(rows.error);
        }
        return encodeRows(&rows);
    }
    return Result<String, String>::Err("命令或参数错误：add/update JSON；get/delete 学号；list [字段 [asc|desc]]；search 姓名；schema");
}

/**
 * @brief 打开 SQLite，创建反射学生模型对应的表并执行单次命令。
 * @param args 数据库路径与操作参数。
 * @return 成功返回零，业务或参数错误返回一。
 */
int64 main(List<String> args)
{
    if (args.len() < 2)
    {
        println("用法：magel main.mgl 数据库路径 命令 [参数]");
        return 1;
    }
    auto database = std::sql::Database::sqlite(args[0]);
    if (!database.isOpen())
    {
        println("错误：{}", database.lastError());
        return 1;
    }
    auto query = std::sql::query<Student>().unwrap();
    auto created = database.exec(query.build("create").unwrap());
    if (!created.ok)
    {
        println("错误：{}", created.error);
        database.close();
        return 1;
    }
    auto result = execute(&database, &args);
    database.close();
    if (result.isErr())
    {
        println("错误：{}", result.error());
        return 1;
    }
    println("{}", result.unwrap());
    return 0;
}
