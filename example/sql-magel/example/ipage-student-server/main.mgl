/** @brief 成绩模块分派（含两个统计子资源）。 */
Response dispatchSelections(App mut& app, Session const& session, Request const& request, String rest) {
    Response denial;
    if (rest == "stats/course") {
        if (request.method != "GET") { return errorResponse(405, "该接口不支持此方法"); }
        if (!allow(session.level, "selection", "statCourse", &denial)) { return denial; }
        String raw = queryParam(request.query, "courseId");
        int64 courseId = 0;
        if (len(raw) > 0) {
            auto parsed = decimal(raw, 2147483647);
            if (parsed.isNone()) { return errorResponse(400, "courseId 必须是非负整数"); }
            courseId = parsed.unwrap();
        }
        return app.statSelectionByCourse(courseId);
    }
    if (rest == "stats/class") {
        if (request.method != "GET") { return errorResponse(405, "该接口不支持此方法"); }
        if (!allow(session.level, "selection", "statClass", &denial)) { return denial; }
        return app.statSelectionByClass();
    }
    if (rest == "query") {
        if (request.method != "POST") { return errorResponse(405, "该接口不支持此方法"); }
        if (!allow(session.level, "selection", "query", &denial)) { return denial; }
        JsonValue root;
        Response failure;
        if (!readJsonBody(&request, &root, &failure)) { return failure; }
        String mode = textField(&root, "mode");
        String keyword = textField(&root, "keyword");
        root.close();
        return app.listSelections(mode, keyword);
    }
    if (rest == "") {
        if (request.method == "GET") {
            if (!allow(session.level, "selection", "list", &denial)) { return denial; }
            return app.listSelections("", "");
        }
        if (request.method == "POST") {
            if (!allow(session.level, "selection", "add", &denial)) { return denial; }
            return app.createSelection(&request);
        }
        return errorResponse(405, "该接口不支持此方法");
    }
    int64 id = resourceId(rest);
    if (id < 0) { return errorResponse(400, "成绩 id 必须为正整数"); }
    if (request.method == "PUT") {
        if (!allow(session.level, "selection", "update", &denial)) { return denial; }
        return app.updateSelection(id, &request);
    }
    if (request.method == "DELETE") {
        if (!allow(session.level, "selection", "delete", &denial)) { return denial; }
        return app.deleteSelection(id);
    }
    return errorResponse(405, "该接口不支持此方法");
}

/** @brief 用户模块分派（含 `{id}/permission` 与 `{id}/password` 子资源）。 */
Response dispatchUsers(App mut& app, Session const& session, Request const& request, String rest) {
    Response denial;
    if (rest == "") {
        if (request.method == "GET") {
            if (!allow(session.level, "user", "list", &denial)) { return denial; }
            return app.listUsers();
        }
        if (request.method == "POST") {
            if (!allow(session.level, "user", "add", &denial)) { return denial; }
            return app.createUser(&request);
        }
        return errorResponse(405, "该接口不支持此方法");
    }
    int64 slash = Text::find(rest, "/");
    if (slash > 0) {
        int64 id = resourceId(rest[0:slash]);
        if (id < 0) { return errorResponse(400, "用户 id 必须为正整数"); }
        String tail = rest[(slash + 1):];
        if (request.method != "PUT") { return errorResponse(405, "该接口不支持此方法"); }
        if (tail == "permission") {
            if (!allow(session.level, "user", "permission", &denial)) { return denial; }
            return app.updateUserPermission(id, &request);
        }
        if (tail == "password") {
            if (!allow(session.level, "user", "password", &denial)) { return denial; }
            return app.resetUserPassword(id, &request);
        }
        return errorResponse(404, "接口不存在");
    }
    int64 id = resourceId(rest);
    if (id < 0) { return errorResponse(400, "用户 id 必须为正整数"); }
    if (request.method == "DELETE") {
        if (!allow(session.level, "user", "delete", &denial)) { return denial; }
        return app.deleteUser(&session, id);
    }
    return errorResponse(405, "该接口不支持此方法");
}

/** @brief 下拉选项分派（门槛与该模块的「查看」一致）。 */
Response dispatchOptions(App mut& app, Session const& session, Request const& request, String rest) {
    Response denial;
    if (request.method != "GET") { return errorResponse(405, "该接口不支持此方法"); }
    if (rest == "sclasses") {
        if (!allow(session.level, "sclass", "list", &denial)) { return denial; }
        return app.sclassOptions();
    }
    if (rest == "courses") {
        if (!allow(session.level, "course", "list", &denial)) { return denial; }
        return app.courseOptions();
    }
    return errorResponse(404, "接口不存在");
}

/**
 * @brief 路由总入口。
 *
 * 只有 `/api/health` 与 `/api/login` 是公开的；其余一律先要有效令牌。
 * 权限判定分两层：这里先过滤模块/动作（`allow`），接口内部不再重复判定。
 * @param app 服务引用。 @param request 请求引用。 @return HTTP 响应。
 */
Response route(App mut& app, Request const& request) {
    if (request.status != 0) {
        return errorResponse(request.status, "HTTP 请求格式或长度不受支持");
    }
    /* 跨域预检：浏览器在跨源发 JSON 请求前会先发 OPTIONS，这里直接放行。 */
    if (request.method == "OPTIONS") { return noContentResponse(); }

    if (request.path == "/api/health" && request.method == "GET") {
        ResultSet health = app.db.exec("SELECT 1");
        if (!health.ok) { return errorResponse(503, "数据库不可用"); }
        return jsonResponse(200, "{\"status\":\"ok\",\"database\":\"mysql\"}");
    }
    if (request.path == "/api/login") {
        if (request.method != "POST") { return errorResponse(405, "该接口不支持此方法"); }
        return app.login(&request);
    }
    if (!Text::startsWith(request.path, "/api/")) {
        return errorResponse(404, "接口不存在：本服务只提供 /api/* 接口，前端页面请用静态服务器托管");
    }

    Session session = app.findSession(bearerToken(request.authorization));
    if (!session.valid) { return errorResponse(401, "未登录或会话已失效，请重新登录"); }

    if (request.path == "/api/logout") {
        if (request.method != "POST") { return errorResponse(405, "该接口不支持此方法"); }
        return app.logout(&session);
    }
    if (request.path == "/api/session") {
        if (request.method != "GET") { return errorResponse(405, "该接口不支持此方法"); }
        return app.sessionResponse(&session);
    }
    if (request.path == "/api/password") {
        if (request.method != "POST") { return errorResponse(405, "该接口不支持此方法"); }
        return app.changeOwnPassword(&session, &request);
    }

    Route route = splitResource(request.path, "students");
    if (route.matched) { return dispatchStudents(&app, &session, &request, route.rest); }
    route = splitResource(request.path, "sclasses");
    if (route.matched) { return dispatchSclasses(&app, &session, &request, route.rest); }
    route = splitResource(request.path, "courses");
    if (route.matched) { return dispatchCourses(&app, &session, &request, route.rest); }
    route = splitResource(request.path, "selections");
    if (route.matched) { return dispatchSelections(&app, &session, &request, route.rest); }
    route = splitResource(request.path, "users");
    if (route.matched) { return dispatchUsers(&app, &session, &request, route.rest); }
    route = splitResource(request.path, "options");
    if (route.matched) { return dispatchOptions(&app, &session, &request, route.rest); }
    return errorResponse(404, "接口不存在");
}

/* ── HTTP 收发 ────────────────────────────────────────────────────────── */

/**
 * @brief 判断 `Host` 头是否指本服务。
 *
 * 比 web-students 示例放宽了一点：前端由独立静态服务器托管，用户可能用
 * `127.0.0.1:端口` 也可能用 `localhost:端口` 访问后端，两种都接受；主机名或
 * 端口对不上仍然拒绝（防 DNS 重绑定式的跨站直连）。
 * @param value Host 头的值。 @param port 本服务实际监听端口。 @return 是否接受。
 */
bool hostAllowed(String value, int64 port) {
    int64 colon = Text::find(value, ":");
    if (colon <= 0) { return false; }
    String host = Text::toLower(value[0:colon]);
    if (host != "127.0.0.1" && host != "localhost") { return false; }
    auto parsed = decimal(value[(colon + 1):], 65535);
    if (parsed.isNone()) { return false; }
    return parsed.unwrap() == port;
}

/** @brief 读取一个 Content-Length 请求；每条连接只处理一次。
 * @param socket 可写连接引用。 @param port 本服务监听端口（校验 Host）。 @return 请求及解析状态。 */
Request readRequest(TcpSocket mut& socket, int64 port) {
    Request request;
    request.status = 0;
    request.method = "";
    request.path = "";
    request.query = "";
    request.body = "";
    request.contentType = "";
    request.authorization = "";

    String raw = "";
    int64 split = -1;
    while (split < 0) {
        String chunk = socket.receive((int32)4096);
        if (chunk == "") { request.status = 400; return request; }
        raw = raw + chunk;
        split = Text::find(raw, "\r\n\r\n");
        if ((split < 0 && len(raw) > HEADER_LIMIT) || split > HEADER_LIMIT) {
            request.status = 431;
            return request;
        }
    }
    if (split == 0) { request.status = 400; return request; }
    List<String> lines = Text::split(raw[0:split], "\r\n");
    List<String> start = Text::split(lines[0], " ");
    if (len(start) != 3) { request.status = 400; return request; }
    if ((start[2] != "HTTP/1.1" && start[2] != "HTTP/1.0") || !Text::startsWith(start[1], "/")) {
        request.status = 400;
        return request;
    }
    request.method = start[0];
    String target = start[1];
    int64 mark = Text::find(target, "?");
    if (mark < 0) {
        request.path = target;
        request.query = "";
    } else {
        request.path = target[0:mark];
        request.query = target[(mark + 1):];
    }

    int64 length = 0;
    bool hasLength = false;
    bool hasHost = false;
    for (int64 i = 1; i < len(lines); i = i + 1) {
        String line = lines[i];
        int64 colon = Text::find(line, ":");
        if (colon <= 0) { request.status = 400; return request; }
        String key = Text::toLower(line[0:colon]);
        String value = Text::trim(line[(colon + 1):]);
        if (key == "content-length") {
            if (hasLength) { request.status = 400; return request; }
            auto parsed = decimal(value, BODY_LIMIT);
            if (parsed.isNone()) { request.status = 413; return request; }
            length = parsed.unwrap();
            hasLength = true;
        }
        elif (key == "host") {
            if (hasHost || !hostAllowed(value, port)) { request.status = 400; return request; }
            hasHost = true;
        }
        elif (key == "transfer-encoding") { request.status = 501; return request; }
        elif (key == "expect") { request.status = 417; return request; }
        elif (key == "content-type") { request.contentType = Text::toLower(value); }
        elif (key == "authorization") { request.authorization = value; }
    }
    if (start[2] == "HTTP/1.1" && !hasHost) { request.status = 400; return request; }
    if ((request.method == "POST" || request.method == "PUT") && !hasLength) {
        request.status = 411;
        return request;
    }
    request.body = raw[(split + 4):];
    while (len(request.body) < length) {
        String chunk = socket.receive((int32)4096);
        if (chunk == "") { request.status = 400; return request; }
        request.body = request.body + chunk;
    }
    request.body = request.body[0:length];
    return request;
}

/**
 * @brief 发送 UTF-8 响应；Content-Length 按字节计数。
 *
 * 除 web-students 示例已有的头以外，这里**恒发**一组 CORS 头：前端跑在另一个
 * 源上（独立静态服务器），跨源 `fetch` 必须靠它们才放行。`allowOrigin` 默认 `*`，
 * 可用 `--allow-origin` 收紧到具体的静态站点地址。
 * @param socket 连接引用。 @param response 响应引用。 @param allowOrigin 允许的源。 @return 是否完整发送。
 */
bool sendResponse(TcpSocket mut& socket, Response const& response, String allowOrigin) {
    String text = "HTTP/1.1 " + format("{}", response.status) + " " + reason(response.status)
    + "\r\nContent-Type: " + response.contentType
    + "\r\nContent-Length: " + format("{}", len(response.body))
    + "\r\nAccess-Control-Allow-Origin: " + allowOrigin
    + "\r\nAccess-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS"
    + "\r\nAccess-Control-Allow-Headers: Content-Type, Authorization"
    + "\r\nAccess-Control-Max-Age: 600"
    + "\r\nConnection: close"
    + "\r\nCache-Control: no-store"
    + "\r\nX-Content-Type-Options: nosniff"
    + "\r\n\r\n" + response.body;
    return socket.send(text) == len(text);
}

/* ── 入口 ─────────────────────────────────────────────────────────────── */

/**
 * @brief 程序入口。
 *
 * 支持的开关：
 *   --listen-host / --listen-port    HTTP 监听地址与端口（端口 0 = 由系统分配）
 *   --mysql-host / --mysql-user / --mysql-password / --mysql-port   MySQL 连接参数
 *   --db / --init / --reinit         库名与建库脚本
 *   --allow-origin                   跨域头里的允许源，默认 `*`
 *   --ready FILE                     监听成功后把实际端口写进该文件（自检用）
 *   --max-requests N                 处理 N 个请求后正常退出（0 = 不限，自检用）
 */
int64 main(List<String> arguments) {
    String listenHost = "127.0.0.1";
    String allowOrigin = "*";
    String readyPath = "";
    String database = "student";
    String mysqlHost = "127.0.0.1";
    String mysqlUser = "root";
    String mysqlPassword = "123456";
    String initPath = "";
    bool forceInit = false;
    int64 listenPort = 8080;
    int64 mysqlPort = 3306;
    int64 maximum = 0;

    for (int64 i = 0; i < len(arguments); i = i + 1) {
        String argument = arguments[i];
        bool hasValue = i + 1 < len(arguments);
        if (argument == "--listen-host" && hasValue) { listenHost = arguments[i + 1]; i = i + 1; }
        elif (argument == "--listen-port" && hasValue) {
            auto value = decimal(arguments[i + 1], 65535);
            if (value.isNone()) { println("--listen-port 需要 0-65535 的整数"); return 1; }
            listenPort = value.unwrap();
            i = i + 1;
        }
        elif (argument == "--mysql-host" && hasValue) { mysqlHost = arguments[i + 1]; i = i + 1; }
        elif (argument == "--mysql-user" && hasValue) { mysqlUser = arguments[i + 1]; i = i + 1; }
        elif (argument == "--mysql-password" && hasValue) { mysqlPassword = arguments[i + 1]; i = i + 1; }
        elif (argument == "--mysql-port" && hasValue) {
            auto value = decimal(arguments[i + 1], 65535);
            if (value.isNone()) { println("--mysql-port 需要 0-65535 的整数"); return 1; }
            mysqlPort = value.unwrap();
            i = i + 1;
        }
        elif (argument == "--db" && hasValue) { database = arguments[i + 1]; i = i + 1; }
        elif (argument == "--init" && hasValue) { initPath = arguments[i + 1]; i = i + 1; }
        elif (argument == "--reinit") { forceInit = true; }
        elif (argument == "--allow-origin" && hasValue) { allowOrigin = arguments[i + 1]; i = i + 1; }
        elif (argument == "--ready" && hasValue) { readyPath = arguments[i + 1]; i = i + 1; }
        elif (argument == "--max-requests" && hasValue) {
            auto value = decimal(arguments[i + 1], 1000000);
            if (value.isNone()) { println("--max-requests 需要非负整数"); return 1; }
            maximum = value.unwrap();
            i = i + 1;
        }
        else {
            println("未知参数：{}", argument);
            return 1;
        }
    }

    App app;
    app.ready = false;
    app.allowOrigin = allowOrigin;
    app.entropy = std::random::randomFromEntropy();

    if (!app.connect(mysqlHost, mysqlUser, mysqlPassword, database, (int32)mysqlPort)) {
        app.stop();
        return 1;
    }
    if (!app.ensureSchema(initPath, forceInit)) {
        app.stop();
        return 1;
    }

    TcpListener listener = TcpListener::listen(listenHost, (int32)listenPort, (int32)16);
    if (!listener.isOpen()) {
        println("监听失败：{}", listener.lastError());
        app.stop();
        return 1;
    }
    int64 actualPort = listener.localPort();
    String authority = listenHost + ":" + format("{}", actualPort);

    if (len(readyPath) > 0) {
        auto ready = FileStream::open(readyPath, "wb");
        if (ready.isErr()) {
            println("无法写入就绪文件：{}", readyPath);
            listener.close();
            app.stop();
            return 1;
        }
        FileStream marker = ready.unwrap();
        auto written = marker.write(format("{}", actualPort));
        marker.close();
        if (written.isErr()) {
            println("写入就绪文件失败");
            listener.close();
            app.stop();
            return 1;
        }
    }

    println("学生成绩信息管理系统 API：http://{}/api/health", authority);
    println("前端页面请用独立静态服务器托管 web/ 目录（见 README）");

    int64 handled = 0;
    while (maximum == 0 || handled < maximum) {
        TcpSocket socket = listener.accept((int32)1000);
        if (!socket.isOpen()) { continue; }
        Request request = readRequest(&socket, actualPort);
        Response response = route(&app, &request);
        bool sent = sendResponse(&socket, &response, app.allowOrigin);
        socket.close();
        handled = handled + 1;
    }
    listener.close();
    app.stop();
    println("服务器正常关闭：{} 个请求", handled);
    return 0;
}
