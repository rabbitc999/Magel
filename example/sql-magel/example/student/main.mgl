/*
 * main.mgl —— 学生信息管理系统 v1.0（Magel 语言 + std::sql + 本机 MySQL）
 *
 * 这是 magel/example/sql-magel 示例工程的程序：界面与菜单按需求文档实现，数据全部存在
 * **外部 MySQL 数据库**里，Magel 只通过标准库 `std::sql` 发 SQL、读结果。
 *
 * 运行（在仓库根目录，保证顺带能读到 magel/example/sql-magel/sql/*.sql）：
 *   magel/magel magel/example/sql-magel/example/student/main.mgl
 *
 * 连接参数：127.0.0.1:3306，用户 root，口令 123456，库名 student_db
 * （库不存在会自动创建，建表与初始数据来自 magel/example/sql-magel/sql/schema.sql 与 seed.sql）。
 */
module studentApp;

import std::sql;
import std::io;
import std::text;
import std::parse;

/* ── 文本小工具 ───────────────────────────────────────────────────────── */

/**
 * @brief 按终端显示宽度算长度：ASCII 一列，中日韩等宽字符两列。
 *
 * `len(String)` 与 `text[i]` 都按**字节**算，下标落在多字节字符中间会运行期报错，
 * 所以这里必须按 UTF-8 首字节判断字符长度并整字符前进（与 `std::sql::displayWidth` 同口径）。
 */
int64 displayWidth(String text) {
    int64 width = 0;
    int64 i = 0;
    while (i < len(text)) {
        int64 byte = (int64)text[i];
        if (byte >= 240) { width = width + 2; i = i + 4; }
        elif (byte >= 224) { width = width + 2; i = i + 3; }
        elif (byte >= 192) { width = width + 1; i = i + 2; }
        else { width = width + 1; i = i + 1; }
    }
    return width;
}

/** @brief 右补空格到指定显示宽度。 */
String pad(String text, int64 width) {
    /* 先取得独立字符串，再补齐显示宽度；当前也允许直接写 String out = text。 */
    String out = "";
    out = out + text;
    int64 current = displayWidth(text);
    while (current < width) {
        out = out + " ";
        current = current + 1;
    }
    return out;
}

/** @brief 成绩列表（连表取姓名 + CASE 算等级）的公共 SELECT。 */
String scoreListSql() {
    return "SELECT s.no, st.name, s.course, s.score,"
    " CASE WHEN s.score >= 90 THEN '优秀'"
    " WHEN s.score >= 80 THEN '良好'"
    " WHEN s.score >= 70 THEN '中等'"
    " WHEN s.score >= 60 THEN '及格'"
    " ELSE '不及格' END AS grade"
    " FROM scores s LEFT JOIN students st ON st.no = s.no";
}

/* ── 应用程序 ─────────────────────────────────────────────────────────── */

struct App {
    std::sql::Database db;
    bool ready;
    List<String> answers;   /**< 脚本模式下的预置回答 */
    int64 answerIndex;
    bool scripted;

    /* -- 输入 ---------------------------------------------------------- */

    /**
     * @brief 打印提示并读一个回答。
     *
     * 脚本模式（`--answers 文件`）从 UTF-8 文件里按空白取词；否则交给
     * `inputLine()`（宿主的 `--input`）。Windows 命令行参数会被系统按
     * ANSI 代码页转换，中文会变乱码，所以中文输入请走 `--answers`。
     */
    String ask(String prompt) {
        print("{}", prompt);
        if (self.scripted) {
            if (self.answerIndex >= len(self.answers)) { return ""; }
            String value = self.answers[self.answerIndex];
            self.answerIndex = self.answerIndex + 1;
            return value;
        }
        return inputLine();
    }

    /** @brief 读一个整数回答。 */
    int64 askInt(String prompt) {
        String text = self.ask(prompt);
        return std::parse::Parse::parseInt64(text).unwrapOr(0);
    }

    /** @brief 读一个浮点回答。 */
    float64 askFloat(String prompt) {
        String text = self.ask(prompt);
        return std::parse::Parse::parseFloat64(text).unwrapOr(0.0);
    }

    /** @brief 读一个 UTF-8 回答脚本（按空白切词）。 */
    bool loadAnswers(String path) {
        Result<File, String> opened = std::io::fileOpen(path, "rb");
        bool found = false;
        match (opened) {
            Result<File, String>::Ok(handle) => {
                while (std::io::fileEof(handle) == 0) {
                    String line = std::io::fileRead(handle);
                    List<String> parts = std::text::Text::split(line, " ");
                    for (int64 i = 0; i < len(parts); i = i + 1) {
                        if (len(parts[i]) > 0) { self.answers.push(parts[i]); }
                    }
                }
                std::io::fileClose(handle);
                found = true;
            }
            Result<File, String>::Err(message) => { found = false; }
        }
        self.scripted = found;
        self.answerIndex = 0;
        return found;
    }

    /* -- 准备 ---------------------------------------------------------- */

    /** @brief 连接 MySQL、建库、建表、灌入初始数据；answersPath 非空时读回答脚本。 */
    bool start(String answersPath) {
        self.ready = false;
        if (len(answersPath) > 0) { self.loadAnswers(answersPath); }
        self.db = std::sql::Database::local("");
        if (!self.db.isOpen()) {
            println(">> 连接 MySQL 失败：{}", self.db.lastError());
            return false;
        }
        if (!self.db.execOk("CREATE DATABASE IF NOT EXISTS student_db DEFAULT CHARACTER SET utf8mb4")) {
            println(">> 建库失败：{}", self.db.lastError());
            return false;
        }
        if (!self.db.execOk("USE student_db")) {
            println(">> 选库失败：{}", self.db.lastError());
            return false;
        }

        int64 schemaCode = self.applySchemaFile();
        if (schemaCode != 1) {
            if (schemaCode == 0) {
                println(">> 找不到 sql/schema.sql；请在仓库根目录（ParseEngine）下运行本程序");
            }
            return false;
        }
        int64 seedCode = self.applySeedFile();
        if (seedCode == 2) { return false; }
        self.ready = true;
        return true;
    }

    /**
     * @brief 读取一个 .sql 文件并整段交给 MySQL 执行。
     * @return 0 = 文件不存在、1 = 执行成功、2 = 执行报错（已打印原因）。
     */
    int64 applySqlFile(String path) {
        Result<File, String> opened = std::io::fileOpen(path, "rb");
        bool found = false;
        String script = "";
        match (opened) {
            Result<File, String>::Ok(handle) => {
                while (std::io::fileEof(handle) == 0) {
                    String line = std::io::fileRead(handle);
                    script = script + line + "\n";
                }
                std::io::fileClose(handle);
                found = true;
            }
            Result<File, String>::Err(message) => { found = false; }
        }
        if (!found) { return 0; }
        std::sql::ResultSet result = self.db.exec(script);
        if (!result.ok) {
            println(">> 执行 {} 出错：{}", path, result.error);
            return 2;
        }
        return 1;
    }

    /** @brief 依次尝试几个相对路径执行 schema.sql。 */
    int64 applySchemaFile() {
        int64 code = self.applySqlFile("magel/example/sql-magel/sql/schema.sql");
        if (code == 0) { code = self.applySqlFile("example/sql-magel/sql/schema.sql"); }
        if (code == 0) { code = self.applySqlFile("sql/schema.sql"); }
        return code;
    }

    /** @brief 依次尝试几个相对路径执行 seed.sql（找不到不算错）。 */
    int64 applySeedFile() {
        int64 code = self.applySqlFile("magel/example/sql-magel/sql/seed.sql");
        if (code == 0) { code = self.applySqlFile("example/sql-magel/sql/seed.sql"); }
        if (code == 0) { code = self.applySqlFile("sql/seed.sql"); }
        if (code == 0) { return 1; }
        return code;
    }

    void stop() { self.db.close(); }

    /* -- 主菜单 -------------------------------------------------------- */

    void run() {
        bool running = true;
        while (running) {
            println("==========================================");
            println("          学生信息管理系统  v1.0");
            println("==========================================");
            println("          1. 学生信息管理");
            println("          2. 班级信息管理");
            println("          3. 成绩信息管理");
            println("          0. 退出系统");
            println("==========================================");
            int64 choice = self.askInt("请输入您的选择(0-3)：");
            if (choice == 1) { self.studentMenu(); }
            elif (choice == 2) { self.classMenu(); }
            elif (choice == 3) { self.scoreMenu(); }
            elif (choice == 0) { running = false; }
            else { println(">> 输入无效，请重新选择"); }
        }
        println("==========================================");
        println("        感谢使用学生信息管理系统！");
        println("              再见！");
        println("==========================================");
    }

    void waitReturn() {
        println("按回车键返回...");
        pause();
    }

    void reportError(String action, std::sql::ResultSet result) {
        if (result.ok) { return; }
        println(">> {}失败：{}", action, result.error);
    }

    /* -- 学生信息管理 -------------------------------------------------- */

    void studentMenu() {
        bool back = false;
        while (!back) {
            println("==========================================");
            println("             学生信息管理");
            println("==========================================");
            println("          1. 添加学生信息");
            println("          2. 删除学生信息");
            println("          3. 修改学生信息");
            println("          4. 查询学生信息");
            println("          5. 显示全部学生");
            println("          0. 返回主菜单");
            println("==========================================");
            int64 choice = self.askInt("请输入您的选择(0-5)：");
            if (choice == 1) { self.addStudent(); }
            elif (choice == 2) { self.deleteStudent(); }
            elif (choice == 3) { self.updateStudent(); }
            elif (choice == 4) { self.queryStudent(); }
            elif (choice == 5) { self.listStudents(); }
            elif (choice == 0) { back = true; }
            else { println(">> 输入无效，请重新选择"); }
        }
    }

    void addStudent() {
        println("------ 添加学生信息 ------");
        String no = self.ask("请输入学号：");
        String name = self.ask("请输入姓名：");
        String gender = self.ask("请输入性别：");
        int64 age = self.askInt("请输入年龄：");
        String className = self.ask("请输入班级：");

        String sql = "INSERT INTO students (no, name, gender, age, class_name) VALUES ("
        + std::sql::quote(no) + ", " + std::sql::quote(name) + ", "
        + std::sql::quote(gender) + ", " + std::sql::intLiteral(age) + ", "
        + std::sql::quote(className) + ")";
        std::sql::ResultSet result = self.db.exec(sql);
        if (result.ok) { println(">> 添加成功！"); }
        else { println(">> 添加失败：{}", result.error); }
    }

    void listStudents() {
        std::sql::ResultSet result =
        self.db.exec("SELECT no, name, gender, age, class_name FROM students ORDER BY no");
        if (!result.ok) { println(">> 查询失败：{}", result.error); return; }
        println("------------------------- 学生列表 -------------------------");
        println("学号        姓名      性别    年龄    班级");
        for (int64 r = 0; r < result.rowCount(); r = r + 1) {
            String rawNo = result.textAt(r, 0);
            String rawName = result.textAt(r, 1);
            String rawGender = result.textAt(r, 2);
            String rawAge = result.textAt(r, 3);
            String className = result.textAt(r, 4);
            String no = pad(rawNo, 12);
            String name = pad(rawName, 10);
            String gender = pad(rawGender, 8);
            String age = pad(rawAge, 8);
            println("{}{}{}{}{}", no, name, gender, age, className);
        }
        println("------------------------------------------------------------");
        println("共 {} 条记录", result.rowCount());
        self.waitReturn();
    }

    void queryStudent() {
        println("------ 查询学生信息 ------");
        println("1. 按学号查询");
        println("2. 按姓名查询");
        println("0. 返回");
        int64 choice = self.askInt("请选择：");
        if (choice == 0) { return; }
        String sql = "";
        if (choice == 1) {
            String no = self.ask("请输入学号：");
            sql = "SELECT no, name, gender, age, class_name FROM students WHERE no = " + std::sql::quote(no);
        } elif (choice == 2) {
            String name = self.ask("请输入姓名：");
            sql = "SELECT no, name, gender, age, class_name FROM students WHERE name = " + std::sql::quote(name);
        } else {
            println(">> 输入无效");
            return;
        }
        std::sql::ResultSet result = self.db.exec(sql);
        if (!result.ok) { println(">> 查询失败：{}", result.error); return; }
        if (result.rowCount() == 0) { println(">> 没有找到匹配的学生"); return; }
        println(">> 查询结果：");
        for (int64 r = 0; r < result.rowCount(); r = r + 1) {
            String line = "学号：" + result.textAt(r, 0) + "   姓名：" + result.textAt(r, 1)
            + "   性别：" + result.textAt(r, 2) + "   年龄：" + result.textAt(r, 3)
            + "   班级：" + result.textAt(r, 4);
            println("{}", line);
        }
    }

    void deleteStudent() {
        println("------ 删除学生信息 ------");
        String no = self.ask("请输入学号：");
        String sql = "DELETE FROM students WHERE no = " + std::sql::quote(no);
        std::sql::ResultSet result = self.db.exec(sql);
        if (!result.ok) { println(">> 删除失败：{}", result.error); return; }
        if (result.affected == 0) { println(">> 没有找到该学号"); }
        else { println(">> 删除成功！"); }
    }

    void updateStudent() {
        println("------ 修改学生信息 ------");
        String no = self.ask("请输入学号：");
        String exists = self.db.scalar("SELECT no FROM students WHERE no = " + std::sql::quote(no));
        if (len(exists) == 0) { println(">> 没有找到该学号"); return; }
        String name = self.ask("请输入新姓名：");
        String gender = self.ask("请输入新性别：");
        int64 age = self.askInt("请输入新年龄：");
        String className = self.ask("请输入新班级：");
        String sql = "UPDATE students SET name = " + std::sql::quote(name)
        + ", gender = " + std::sql::quote(gender)
        + ", age = " + std::sql::intLiteral(age)
        + ", class_name = " + std::sql::quote(className)
        + " WHERE no = " + std::sql::quote(no);
        std::sql::ResultSet result = self.db.exec(sql);
        if (result.ok) { println(">> 修改成功！"); }
        else { println(">> 修改失败：{}", result.error); }
    }

    /* -- 班级信息管理 -------------------------------------------------- */

    void classMenu() {
        bool back = false;
        while (!back) {
            println("==========================================");
            println("             班级信息管理");
            println("==========================================");
            println("          1. 添加班级");
            println("          2. 删除班级");
            println("          3. 修改班级信息");
            println("          4. 查询班级");
            println("          5. 显示全部班级");
            println("          0. 返回主菜单");
            println("==========================================");
            int64 choice = self.askInt("请输入您的选择(0-5)：");
            if (choice == 1) { self.addClass(); }
            elif (choice == 2) { self.deleteClass(); }
            elif (choice == 3) { self.updateClass(); }
            elif (choice == 4) { self.queryClass(); }
            elif (choice == 5) { self.listClasses(); }
            elif (choice == 0) { back = true; }
            else { println(">> 输入无效，请重新选择"); }
        }
    }

    void addClass() {
        println("------ 添加班级 ------");
        String code = self.ask("请输入班级编号：");
        String name = self.ask("请输入班级名称：");
        String teacher = self.ask("请输入班主任：");
        int64 size = self.askInt("请输入人数：");
        String sql = "INSERT INTO classes (code, name, teacher, size) VALUES ("
        + std::sql::quote(code) + ", " + std::sql::quote(name) + ", "
        + std::sql::quote(teacher) + ", " + std::sql::intLiteral(size) + ")";
        std::sql::ResultSet result = self.db.exec(sql);
        if (result.ok) { println(">> 添加成功！"); }
        else { println(">> 添加失败：{}", result.error); }
    }

    void deleteClass() {
        println("------ 删除班级 ------");
        String code = self.ask("请输入班级编号：");
        std::sql::ResultSet result =
        self.db.exec("DELETE FROM classes WHERE code = " + std::sql::quote(code));
        if (!result.ok) { println(">> 删除失败：{}", result.error); return; }
        if (result.affected == 0) { println(">> 没有找到该班级"); }
        else { println(">> 删除成功！"); }
    }

    void updateClass() {
        println("------ 修改班级信息 ------");
        String code = self.ask("请输入班级编号：");
        String exists = self.db.scalar("SELECT name FROM classes WHERE code = " + std::sql::quote(code));
        if (len(exists) == 0) { println(">> 没有找到该班级"); return; }
        String name = self.ask("请输入新班级名称：");
        String teacher = self.ask("请输入新班主任：");
        int64 size = self.askInt("请输入新人数：");
        String sql = "UPDATE classes SET name = " + std::sql::quote(name)
        + ", teacher = " + std::sql::quote(teacher)
        + ", size = " + std::sql::intLiteral(size)
        + " WHERE code = " + std::sql::quote(code);
        std::sql::ResultSet result = self.db.exec(sql);
        if (result.ok) { println(">> 修改成功！"); }
        else { println(">> 修改失败：{}", result.error); }
    }

    void listClasses() {
        std::sql::ResultSet result =
        self.db.exec("SELECT code, name, teacher, size FROM classes ORDER BY code");
        if (!result.ok) { println(">> 查询失败：{}", result.error); return; }
        println("-------------------- 班级列表 --------------------");
        println("班级编号     班级名称        班主任      人数");
        for (int64 r = 0; r < result.rowCount(); r = r + 1) {
            String rawCode = result.textAt(r, 0);
            String rawName = result.textAt(r, 1);
            String rawTeacher = result.textAt(r, 2);
            String size = result.textAt(r, 3);
            String code = pad(rawCode, 12);
            String name = pad(rawName, 16);
            String teacher = pad(rawTeacher, 12);
            println("{}{}{}{}", code, name, teacher, size);
        }
        println("-------------------------------------------------");
        println("共 {} 个班级", result.rowCount());
        self.waitReturn();
    }

    void queryClass() {
        println("------ 查询班级 ------");
        String code = self.ask("请输入班级编号：");
        std::sql::ResultSet result =
        self.db.exec("SELECT code, name, teacher, size FROM classes WHERE code = " + std::sql::quote(code));
        if (!result.ok) { println(">> 查询失败：{}", result.error); return; }
        if (result.rowCount() == 0) { println(">> 没有找到该班级"); return; }
        println(">> 查询结果：");
        for (int64 r = 0; r < result.rowCount(); r = r + 1) {
            String line = "编号：" + result.textAt(r, 0) + "   名称：" + result.textAt(r, 1)
            + "   班主任：" + result.textAt(r, 2) + "   人数：" + result.textAt(r, 3);
            println("{}", line);
        }
    }

    /* -- 成绩信息管理 -------------------------------------------------- */

    void scoreMenu() {
        bool back = false;
        while (!back) {
            println("==========================================");
            println("             成绩信息管理");
            println("==========================================");
            println("          1. 录入成绩");
            println("          2. 修改成绩");
            println("          3. 删除成绩");
            println("          4. 查询成绩（按学号/课程）");
            println("          5. 显示全部成绩");
            println("          6. 成绩统计（平均分/最高分/最低分）");
            println("          0. 返回主菜单");
            println("==========================================");
            int64 choice = self.askInt("请输入您的选择(0-6)：");
            if (choice == 1) { self.addScore(); }
            elif (choice == 2) { self.updateScore(); }
            elif (choice == 3) { self.deleteScore(); }
            elif (choice == 4) { self.queryScore(); }
            elif (choice == 5) { self.listScores(); }
            elif (choice == 6) { self.scoreStats(); }
            elif (choice == 0) { back = true; }
            else { println(">> 输入无效，请重新选择"); }
        }
    }

    void addScore() {
        println("------ 录入成绩 ------");
        String no = self.ask("请输入学号：");
        String course = self.ask("请输入课程：");
        float64 score = self.askFloat("请输入成绩：");
        String sql = "INSERT INTO scores (no, course, score) VALUES ("
        + std::sql::quote(no) + ", " + std::sql::quote(course) + ", "
        + std::sql::realLiteral(score) + ")"
        + " ON DUPLICATE KEY UPDATE score = VALUES(score)";
        std::sql::ResultSet result = self.db.exec(sql);
        if (result.ok) { println(">> 录入成功！"); }
        else { println(">> 录入失败：{}", result.error); }
    }

    void updateScore() {
        println("------ 修改成绩 ------");
        String no = self.ask("请输入学号：");
        String course = self.ask("请输入课程：");
        float64 score = self.askFloat("请输入新成绩：");
        String sql = "UPDATE scores SET score = " + std::sql::realLiteral(score)
        + " WHERE no = " + std::sql::quote(no)
        + " AND course = " + std::sql::quote(course);
        std::sql::ResultSet result = self.db.exec(sql);
        if (!result.ok) { println(">> 修改失败：{}", result.error); return; }
        if (result.affected == 0) { println(">> 没有找到这条成绩"); }
        else { println(">> 修改成功！"); }
    }

    void deleteScore() {
        println("------ 删除成绩 ------");
        String no = self.ask("请输入学号：");
        String course = self.ask("请输入课程：");
        String sql = "DELETE FROM scores WHERE no = " + std::sql::quote(no)
        + " AND course = " + std::sql::quote(course);
        std::sql::ResultSet result = self.db.exec(sql);
        if (!result.ok) { println(">> 删除失败：{}", result.error); return; }
        if (result.affected == 0) { println(">> 没有找到这条成绩"); }
        else { println(">> 删除成功！"); }
    }

    void listScores() {
        String sql = scoreListSql();
        sql = sql + " ORDER BY s.no, s.course";
        std::sql::ResultSet result = self.db.exec(sql);
        if (!result.ok) { println(">> 查询失败：{}", result.error); return; }
        println("---------------------- 成绩列表 ----------------------");
        println("学号        姓名      课程        成绩     等级");
        for (int64 r = 0; r < result.rowCount(); r = r + 1) {
            String rawNo = result.textAt(r, 0);
            String rawName = result.textAt(r, 1);
            String rawCourse = result.textAt(r, 2);
            String rawScore = result.textAt(r, 3);
            String grade = result.textAt(r, 4);
            String no = pad(rawNo, 12);
            String name = pad(rawName, 10);
            String course = pad(rawCourse, 12);
            String score = pad(rawScore, 8);
            println("{}{}{}{}{}", no, name, course, score, grade);
        }
        println("------------------------------------------------------");
        println("共 {} 条记录", result.rowCount());
        self.waitReturn();
    }

    void queryScore() {
        println("------ 查询成绩 ------");
        println("1. 按学号查询");
        println("2. 按课程查询");
        println("0. 返回");
        int64 choice = self.askInt("请选择：");
        if (choice == 0) { return; }
        String condition = "";
        if (choice == 1) {
            String no = self.ask("请输入学号：");
            condition = " WHERE s.no = " + std::sql::quote(no);
        } elif (choice == 2) {
            String course = self.ask("请输入课程：");
            condition = " WHERE s.course = " + std::sql::quote(course);
        } else {
            println(">> 输入无效");
            return;
        }
        String sql = scoreListSql();
        sql = sql + condition + " ORDER BY s.no, s.course";
        std::sql::ResultSet result = self.db.exec(sql);
        if (!result.ok) { println(">> 查询失败：{}", result.error); return; }
        if (result.rowCount() == 0) { println(">> 没有找到匹配的成绩"); return; }
        println(">> 查询结果：");
        println("学号        姓名      课程        成绩     等级");
        for (int64 r = 0; r < result.rowCount(); r = r + 1) {
            String rawNo = result.textAt(r, 0);
            String rawName = result.textAt(r, 1);
            String rawCourse = result.textAt(r, 2);
            String rawScore = result.textAt(r, 3);
            String grade = result.textAt(r, 4);
            String no = pad(rawNo, 12);
            String name = pad(rawName, 10);
            String course = pad(rawCourse, 12);
            String score = pad(rawScore, 8);
            println("{}{}{}{}{}", no, name, course, score, grade);
        }
    }

    void scoreStats() {
        println("------ 成绩统计 ------");
        String course = self.ask("请输入课程：");
        String quoted = std::sql::quote(course);
        std::sql::ResultSet result = self.db.exec(
        "SELECT COUNT(*), AVG(score), MAX(score), MIN(score),"
        " SUM(CASE WHEN score >= 60 THEN 1 ELSE 0 END)"
        " FROM scores WHERE course = " + quoted);
        if (!result.ok) { println(">> 统计失败：{}", result.error); return; }
        int64 people = result.intAt(0, 0);
        println("课程：{}", course);
        if (people == 0) {
            println("人数：0");
            println("（该课程还没有成绩）");
            return;
        }
        float64 average = result.realAt(0, 1);
        String best = self.db.scalar("SELECT st.name FROM scores s JOIN students st ON st.no = s.no"
        " WHERE s.course = " + quoted + " ORDER BY s.score DESC LIMIT 1");
        String worst = self.db.scalar("SELECT st.name FROM scores s JOIN students st ON st.no = s.no"
        " WHERE s.course = " + quoted + " ORDER BY s.score ASC LIMIT 1");
        int64 passed = result.intAt(0, 4);
        println("人数：{}", people);
        println("平均分：{:1F}", average);
        String bestLine = "最高分：" + result.textAt(0, 2) + "（" + best + "）";
        println("{}", bestLine);
        String worstLine = "最低分：" + result.textAt(0, 3) + "（" + worst + "）";
        println("{}", worstLine);
        String percent = format("{}", passed * 100 / people);
        String rateLine = "及格率：" + percent + "%";
        println("{}", rateLine);
    }
};

/**
 * @brief 程序入口。
 *
 * 支持 `--answers 文件`：从 UTF-8 文件按空白读取界面回答（脚本化演示/自检用）。
 * 不带这个选项时走 `inputLine()`（宿主的 `--input`）。
 */
int64 main(List<String> arguments) {
    String answersPath = "";
    for (int64 i = 0; i < len(arguments); i = i + 1) {
        String argument = arguments[i];
        if (argument == "--answers" && i + 1 < len(arguments)) {
            answersPath = arguments[i + 1];
            i = i + 1;
        }
    }
    App app;
    if (!app.start(answersPath)) {
        app.stop();
        return 1;
    }
    app.run();
    app.stop();
    return 0;
}
