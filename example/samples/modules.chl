module moduleDemo;
import math::ops;

void main() {
    List<int64> values;
    for (int64 value in range(1, 5)) {
        values.push(twice(value));
    }
    bool first = true;
    for (int64 value in values) {
        if (!first) {
            print(" ");
        }
        print("{}", value);
        first = false;
    }
    println("");

}
