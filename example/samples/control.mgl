/* control.mgl —— if / elif / else（else 后面必须跟大括号）、while、for（降级成 while）。 */

int64 classify(int64 value) {
    if (value < 0) {
        return -1;
    } elif (value == 0) {
        return 0;
    } else {
        return 1;
    }
}

int64 main() {
    int64 i = 0;
    int64 sum = 0;
    for (i = 1; i <= 5; i = i + 1) {
        sum = sum + i;
    }
    println("sum 1..5 = {}", sum);

    int64 n = 0;
    while (n < 4) {
        println("loop {}: classify(-{})={}", n, n, classify(-n));
        n = n + 1;
    }
    println("classify(7) = {}, classify(0) = {}", classify(7), classify(0));
    println("!false = {}, !true = {}", !false, !true);
    return 0;
}
