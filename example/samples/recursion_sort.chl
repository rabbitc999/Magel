/* 递归排序：归并排序把数组从中间切开、各自排好再合回来；
 * 每一层切片的局部 List 都要在递归返回之后还活着，
 * 递归调用的结果也直接放回本层的变量里。 */

/* 切出 [lo, hi) 那一段 */
List<int64> slice(List<int64> values, int64 lo, int64 hi) {
    List<int64> result;
    int64 i = lo;
    while (i < hi) {
        result.push(values[i]);
        i = i + 1;
    }
    return result;
}

/* 归并两段都排好的序列 */
List<int64> merge(List<int64> left, List<int64> right) {
    List<int64> result;
    int64 i = 0;
    int64 j = 0;
    while (i < left.len() && j < right.len()) {
        if (left[i] <= right[j]) {
            result.push(left[i]);
            i = i + 1;
        } else {
            result.push(right[j]);
            j = j + 1;
        }
    }
    while (i < left.len()) {
        result.push(left[i]);
        i = i + 1;
    }
    while (j < right.len()) {
        result.push(right[j]);
        j = j + 1;
    }
    return result;
}

/* 归并排序：切开 -> 递归排两半 -> 合并 */
List<int64> mergeSort(List<int64> values) {
    if (values.len() <= 1) { return values; }
    int64 mid = values.len() / 2;
    List<int64> left = mergeSort(slice(values, 0, mid));
    List<int64> right = mergeSort(slice(values, mid, values.len()));
    return merge(left, right);
}

/* 递归二分查找：命中返回下标，否则返回 -1 */
int64 binarySearch(List<int64> const& sorted, int64 target, int64 lo, int64 hi) {
    if (lo >= hi) { return -1; }
    int64 mid = lo + (hi - lo) / 2;
    if (sorted[mid] == target) { return mid; }
    if (sorted[mid] < target) { return binarySearch(&sorted, target, mid + 1, hi); }
    return binarySearch(&sorted, target, lo, mid);
}

void main() {
    List<int64> values;
    values.push(38);
    values.push(7);
    values.push(4);
    values.push(99);
    values.push(15);
    values.push(4);
    values.push(62);
    values.push(1);
    values.push(38);
    values.push(23);
    println("排序前：{}", values);
    List<int64> sorted = mergeSort(values);
    println("排序后：{}", sorted);

    println("找 15 -> 下标 {}", binarySearch(&sorted, 15, 0, sorted.len()));
    println("找 38 -> 下标 {}", binarySearch(&sorted, 38, 0, sorted.len()));
    println("找 100 -> 下标 {}", binarySearch(&sorted, 100, 0, sorted.len()));
}
