/* 区间内部使用 Iterator<T>；端点检查、惰性遍历及闭区间防溢出。 */
int64 calls=0;
int64 low(){calls+=1;return 0;}
int64 high(){calls+=1;return 3;}
int64 inferredKind(int32 value){return 32;}
int64 inferredKind(int64 value){return 64;}
void main(){
    List<int32> inferred;inferred.push(cast<int32>(3));inferred.push(cast<int32>(4));
    int64 inferredSum=0;for(let item in inferred){assert(inferredKind(item)==32);inferredSum+=item;}
    assert(inferredSum==7);
    int64 rangeSum=0;for(let item in std::lang::rangeEq(1,3)){assert(inferredKind(item)==64);rangeSum+=item;}
    assert(rangeSum==6);

    int64 count=0;int64 sum=0;
    for(uint8 x in std::lang::rangeEq<uint8>(0,255)){count+=1;sum+=(int64)x;}
    assert(count==256 && sum==32640);
    count=0;for(uint8 x in std::lang::range<uint8>(0,255)){count+=1;}assert(count==255);
    count=0;for(int8 x in std::lang::rangeEq<int8>(-128,127)){count+=1;}assert(count==256);
    count=0;for(int16 x in std::lang::rangeEq<int16>(32766,32767)){count+=1;}assert(count==2);
    count=0;for(uint16 x in std::lang::rangeEq<uint16>(65534,65535)){count+=1;}assert(count==2);
    count=0;for(int32 x in std::lang::rangeEq<int32>(2147483646,2147483647)){count+=1;}assert(count==2);
    count=0;for(uint32 x in std::lang::rangeEq<uint32>(4294967294,4294967295)){count+=1;}assert(count==2);
    count=0;for(int64 x in std::lang::rangeEq<int64>(9223372036854775806,9223372036854775807)){count+=1;}assert(count==2);
    count=0;for(uint64 x in std::lang::rangeEq<uint64>(0xFFFFFFFFFFFFFFFE,0xFFFFFFFFFFFFFFFF)){count+=1;}assert(count==2);
    count=0;for(int64 x in std::lang::rangeEq<int64>((int64)0x8000000000000000,(int64)0x8000000000000001)){count+=1;}assert(count==2);
    count=0;for(int64 x in std::lang::rangeEq<int64>(0xFFFFFFFFFFFFFFFF,0)){count+=1;}assert(count==2);
    for(uint64 x in std::lang::rangeEq<uint64>(0,0xFFFFFFFFFFFFFFFF)){assert(x==0);break;}
    count=0;for(x in std::lang::range(0,0)){count+=1;}assert(count==0);
    for(x in std::lang::rangeEq(0,0)){count+=1;}assert(count==1);
    sum=0;for(x in std::lang::rangeEq(low(),high())){sum+=(int64)x;}assert(sum==6 && calls==2);
    sum=0;for(int8 x in std::lang::rangeEq<int8>(0,5)){if(x==2){continue;}if(x==4){break;}sum+=(int64)x;}assert(sum==4);
    for(uint8 x in std::lang::rangeEq<uint8>(255,255)){continue;}
    List<int64 fn()> saved;
    for(int8 x in std::lang::rangeEq<int8>(0,3)){
        let read=int8 fn(){x};assert(read()==x);
        let tick=int8 fn mut(){x=(int8)(x+1);return x;};assert(tick()==read());
        let copied=int64 fn copy[x](){return (int64)x;};saved.push(copied);
    }
    assert(saved[0]()==1 && saved[3]()==4);
    int64 rounds=0;for(int8 x in std::lang::rangeEq<int8>(0,2)){let moved=int8 fn move[x](){x};assert(moved()==rounds);rounds+=1;}
    assert(rounds==3);
    println("for intervals OK");
}
