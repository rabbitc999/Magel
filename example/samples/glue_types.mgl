/* glue_types.mgl —— 结构体 / 枚举 / 接口的定义全部来自 C++ 胶水
 *
 *   ./magel samples/glue_types.mgl
 *
 * 本文件里没有 `struct` / `enum` / `interface` / `impl`：`magel_driver.inc` 的
 * `InstallDemoGlue` 用 `registry.declarations()` 写好了下面这些定义，编译前追加到
 * 合并源码末尾，所以 `.mgl` 里直接用就行（追加而不是前置：类型号按出现顺序分配，
 * 宿主类型采用独立的内部标签）：
 *
 *   struct GlueDemoPoint  { int64 x; int64 y; };
 *   enum   GlueDemoSignal { Idle, Tone(int64 hz) };
 *   interface GlueDemoInspect { int64 area(); int64 scaled(int64 factor); };
 *   interface GlueDemoCoded   { int64 code(); };
 *   impl GlueDemoPoint  : GlueDemoInspect = glue_demo_inspect;
 *   impl GlueDemoSignal : GlueDemoCoded   = glue_demo_signal;
 *
 * 多方法接口 `GlueDemoInspect` 的成员函数按 `<impl 符号>.<方法名>` 查宿主符号，
 * 所以 C++ 侧注册的是 `glue_demo_inspect.area` / `glue_demo_inspect.scaled`
 * （`registry.bindTypedMethod`）；单方法接口沿用原符号名。
 */
int64 main()
{
    GlueDemoPoint point;
    point.x = 3;
    point.y = 4;
    println("point {}:{} area={} scaled={}", point.x, point.y, point.area(),
    point.scaled(10));

    GlueDemoSignal signal = GlueDemoSignal::Tone(440);
    println("signal code={}", signal.code());
    match (signal) {
        GlueDemoSignal::Idle => { println("idle"); }
        GlueDemoSignal::Tone(hz) => { println("tone hz={}", hz); }
    }
    return 0;
}
