/* AST 替换保留表达式结构，无需自动加括号或形参保护标注。 */
$macro TIMES_TWO(x)
x * 2
$end_macro

$macro PLUS(a, b)
a + b
$end_macro


$macro SHOW(x)
    $stringify(x)
$end_macro


$macro MAKE_NAME(pre, suffix)
    $concat(pre, suffix)
$end_macro


$macro JOIN(left, right)
    $concat(left, right)
$end_macro

int64 var_x = 9;
int64 joined_name = 7;

int64 main() {

    println("{}", $TIMES_TWO(1 + 2));


    println("{}", 10 / $PLUS(2, 3));


    println("{}", $SHOW(1 + 2));


    println("{}", $MAKE_NAME(var, _x));


    println("{}", $JOIN(joined, _name));
    return 0;
}
