/* literal_context_type.mgl —— 整数字面量按表达式上下文定型。
 *
 * 字面量不再一律按 int64 走：`x + 1`（`x` 是 int32）里的 `1` 取 int32，整个表达式
 * 也是 int32，不必再写 `(int32)1`；两边都是字面量时按目标槽位一次定掉。
 * 值装不下目标类型时仍按「缩窄要强转」报错，不会静默截断；十六进制 / 二进制按
 * 位模式看待（`int8 x = 0xFF;` 照旧放行）。
 */

int32 twice(int32 value) { return value * 2; }

int64 main() {
    int32 a = 1;
    println("a = {}", a);

    auto ff = fn move () { a = 2; return a; };
    int32 b = ff();
    int32 c = ff() + 1;              /* 等价于 ff() + (int32)(1) */
    println("b = {}", b);
    println("c = {}", c);

    int32 sum = 1 + 2;               /* 两边都是字面量：按 int32 槽位定型 */
    println("sum = {}", sum);

    auto scaled = twice(b) + 3;      /* 相邻操作数是 int32，结果也是 int32 */
    int32 keep = scaled;
    println("scaled = {}", keep);

    int8 small = 100;                /* 窄槽位：值装得下就放行 */
    int8 more = small + 20;
    println("more = {}", more);

    uint8 pack = 250;
    uint8 wrapped = pack + 1;
    println("wrapped = {}", wrapped);

    println("plain = {}", 1 + 2);    /* 没有上下文：仍是默认的 int64 */
    return 0;
}
