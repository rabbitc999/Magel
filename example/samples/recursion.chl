/* 递归 + 局部变量：每层调用都有自己的局部变量存储（进函数分配、返回时释放），
 * 所以递归函数的局部变量不会再互相覆盖；全局变量照样能读能写。 */

int64 counter = 0;

/* 每层调用有自己的 moves / left / right：算 2^n - 1 步 */
int64 hanoi(int64 n, int64 from, int64 to, int64 via) {
    int64 moves = 0;
    if (n == 0) { return moves; }
    int64 left = hanoi(n - 1, from, via, to);
    moves = left + 1;
    int64 right = hanoi(n - 1, via, to, from);
    return moves + right;
}

/* 两个分支各自的中间结果都留在本层的局部变量里 */
int64 fib(int64 n) {
    int64 a = 0;
    int64 b = 1;
    if (n <= 0) { return a; }
    if (n == 1) { return b; }
    int64 prev = fib(n - 1);
    int64 prev2 = fib(n - 2);
    return prev + prev2;
}

/* 深一点的递归：阿克曼函数（回溯时各层的 result 都要还在） */
int64 ack(int64 m, int64 n) {
    int64 result = 0;
    if (m == 0) { result = n + 1; return result; }
    if (n == 0) { result = ack(m - 1, 1); return result; }
    int64 inner = ack(m, n - 1);
    result = ack(m - 1, inner);
    return result;
}

/* 全局变量在递归里照样能改：局部同名变量不会把它盖住 */
int64 walk(int64 n) {
    counter = counter + 1;
    int64 here = n;
    if (n <= 0) { return 0; }
    int64 sub = walk(n - 1);
    return here + sub;
}

int64 main() {
    println("hanoi(3) = {}", hanoi(3, 1, 3, 2));
    println("hanoi(10) = {}", hanoi(10, 1, 3, 2));
    println("fib(10) = {}", fib(10));
    println("fib(20) = {}", fib(20));
    println("ack(2, 3) = {}", ack(2, 3));
    println("ack(3, 3) = {}", ack(3, 3));
    println("walk(5) = {}", walk(5));
    println("counter = {}", counter);
    return 0;
}
