// 目标位置只求值一次；不同对象可在一个表达式中各更新一次。
int64 calls=0;
int64 index(){ calls+=1; return 0; }
struct Pair { int64 left; int64 right; };
int64 main(){
    int64 a[4]; int64 i=0,j=2,result=0;
    a[index()]+=1;
    assert(calls==1 && a[0]==1);
    a[i++]=5;
    assert(i==1 && a[0]==5);
    a[i++]+=3;
    assert(i==2 && a[1]==3);
    result=(i++)+(j++);
    assert(result==4 && i==3 && j==3);
    result+=i++;
    assert(result==7 && i==4);
    Pair p; p.left=1; p.right=2;
    result=p.left++ + p.right++;
    assert(result==3 && p.left==2 && p.right==3);
    int64 mut& left=&p.left;
    result=left++ + p.right++;
    assert(result==5 && p.left==3 && p.right==4);
    int64 mut& first=&a[0];
    result=first++ + a[1]++;
    assert(result==8 && a[0]==6 && a[1]==4);
    List<int64> list; list.push(5); i=0;
    list[i++]+=2;
    assert(i==1 && list[0]==7);
    bool skipped=false && (a[index()]++ > 0);
    assert(!skipped && calls==1 && a[0]==6);
    println("expression effects OK"); return 0;
}
