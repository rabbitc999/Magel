/* macro_for.mgl —— 变长宏里的 `$for 变量 in 尾参`：按尾部实参逐个重复宏体里的那一段。
 *
 * 只能遍历**变长尾参**（`...values`）：每轮把循环变量整体换成该轮的实参文本，所以
 * `$for` 体里可以放心写 `(v) * (v)` 这种把变量包在中间的形式。`$for` 自己的结束符是
 * `$end_for`，宏体的结束符是 `$end_macro` —— 两个"结束"分开写，嵌套时不用数层数。
 */

$macro PRINT_ALL(label, ...values)
$for v in values
println(label, v);
$end_for
$end_macro

$macro SUM_SQUARES(...values)
int64 total = 0;
$for v in values
total = total + (v) * (v);
$end_for
println("平方和 = {}", total);
$end_macro

/* 嵌套 `$for`：里层每轮都跟着外层走一遍，一共 len(values)² 行。 */
$macro PAIRS(...values)
$for a in values
$for b in values
println("({}, {})", a, b);
$end_for
$end_for
$end_macro

int64 main() {
    $PRINT_ALL("值={}", 1)
    $PRINT_ALL("值={}", 2, 3, 4)
    $SUM_SQUARES(2, 3, 4)
    $PAIRS(1, 2)
    return 0;
}
