/* float64.mgl —— float64 运算与 println 的浮点格式。 */

float64 average(int64 total, int64 count) {
    return (float64)total / (float64)count;
}

int64 main() {
    /* 浮点字面量在四元式 / 数据区正文里都带小数点：`2.0` 写成 `2` 的话，
     * 后端会按整数解释这 8 个字节；隐式转换也一样（`float64 x = 2;` → `2.0`）。 */
    float64 half = 1.5 + 0.5;          /* 常量折叠 → 2.0 */
    float64 fromInt = 2;               /* 隐式转换 → 2.0 */
    float64 slots[2];                  /* 数据区里这一行是 [0.0, 0.0]，不是 [0, 0] */
    slots[0] = half;
    slots[1] = fromInt;
    println("half = {:3F} fromInt = {:3F} slots = {:3F} {:3F}", half, fromInt, slots[0], slots[1]);

    int64 sum = 0;
    int64 i = 0;
    for (i = 1; i <= 10; i = i + 1) {
        sum = sum + i;
    }
    float64 avg = average(sum, 10);
    println("sum = {}", sum);
    println("avg = {:3F}", avg);
    println("half = {:3F}", avg / 2.0);
    println("int64(avg) = {}", (int64)avg);
    return 0;
}
