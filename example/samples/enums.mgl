/* enums.mgl - plain and generic tagged unions with match destructuring. */

enum Message {
    Quit,
    Move(int32 x, int32 y),
    Text(String text)
};

struct Point {
    int32 x;
    int32 y;
};

void print_message(Message message) {
    match (message) {
        Message::Quit => { println("quit"); }
        Message::Move(x, y) => { println("move {} {}", x, y); }
        Message::Text(text) => { println("text {}", text); }
    }
}

int64 main() {
    Message first = Message::Quit;
    Message second = Message::Move(3, 7);
    Message third = Message::Text("hello");
    print_message(first);
    print_message(second);
    print_message(third);

    Option<int32> answer = Option<int32>::Value(42);
    match (answer) {
        Option::None => { println("none"); }
        Option::Value(value) => { println("some {}", value); }
    }

    Point point;
    point.x = 5;
    point.y = 9;
    Option<Point> maybe_point = Option<Point>::Value(point);
    match (maybe_point) {
        Option::None => { println("no point"); }
        Option::Value(value) => { println("point {} {}", value.x, value.y); }
    }

    Any boxed = 11;
    Option<Any> dynamic = Option<Any>::Value(boxed);
    match (dynamic) {
        Option::None => { println("no dynamic"); }
        Option::Value(value) => {
            int64 unboxed = value.getValue();
            println("dynamic {}", unboxed);
        }
    }

    Option<int32> inner = Option<int32>::Value(8);
    Option<Option<int32>> outer = Option<Option<int32>>::Value(inner);
    match (outer) {
        Option::None => { println("no outer"); }
        Option::Value(nested) => {
            match (nested) {
                Option::None => { println("no inner"); }
                Option::Value(value) => { println("nested {}", value); }
            }
        }
    }
    return 0;
}
