import std::sql;

@Reflect
@std::sql::ModelClass("people")
struct SqlPerson {
    @std::sql::ModelField(column: "person_id", id: true)
    int64 id;
    @std::sql::ModelField(column: "display_name")
    String name;
    int64 age;
};

int64 main()
{
    let model = std::sql::query<SqlPerson>();
    assert(model.isOk());
    let query = model.unwrap();
    let database = std::sql::Database::sqlite(":memory:");
    let schema = query.build("create");
    assert(schema.isOk());
    let created = database.exec(schema.unwrap());
    assert(created.ok);
    SqlPerson person;
    person.id = 1;
    person.name = "张三'); DROP TABLE people; --";
    person.age = 28;
    let insert = std::sql::insert<SqlPerson>(&query, &person);
    assert(insert.isOk());
    assert(!insert.unwrap().sql.contains(person.name));
    assert(database.exec(insert.unwrap()).ok);
    assert(std::sql::filter<int64>(&query, "id", 1).isOk());
    query.orderBy("age");
    query.page(10);
    let statement = query.build();
    assert(statement.isOk());
    println("{} {}", statement.unwrap().sql, statement.unwrap().parameters);
    let result = database.exec(statement.unwrap());
    assert(result.ok);
    assert(result.rowCount() == 1);
    assert(result.textAt(0, 1) == person.name);
    assert(result.intAt(0, 2) == 28);
    database.close();
    println("ipage parameter binding OK");
    return 0;
}
