/* interface.mgl —— 接口契约 + 接口引用的运行期分派
 *
 *   ./magel samples/interface.mgl
 *
 * 三条规矩（登记时逐条核对，违反哪条都直接报错）：
 *   ① 接口里只有方法，可以提供默认方法体，不能定义字段；本例使用抽象方法。
 *   ② 接口之间也可以继承（`interface B : A { … }`），见 interface_inherit.mgl；
 *   ③ 结构体可以继承**多个**接口，而且必须**完全实现**（同名、同返回类型、同形参类型）。
 *
 * 两个接口要的是同一个函数时只算一条要求（**去重**）：下面 `Circle` 里
 * `describe()` 只写了一遍，就同时满足了 `Shape` 与 `Named`。
 *
 * 接口名还能当**引用的目标类型**：`Shape mut& q`（写在形参上也可以）。
 * 那是"胖引用"（对象的地址 + 它的类型号），所以 `q.area()` 在**运行期**按类型号
 * 挑到具体实现 —— 这就是多态；同一个 `twice_area(…)` 既能吃 Circle 也能吃 Square。
 */

interface Shape {
    int64 area();
    String describe();
};

/* `Named` 也要 `describe()`：和 Shape 要的是同一个签名 → 只算一条要求 */
interface Named {
    String describe();
    String name();
};

/* 继承两个接口：三个要求（area / describe / name）一个都不能少 */
struct Circle : Shape, Named {
    int64 r;

    int64 area() { return 3 * r * r; }
    String describe() { return "circle"; }   /* 一遍就够：Shape 与 Named 共用这一条 */
    String name() { return "Circle"; }
};

struct Square : Shape {
    int64 side;

    int64 area() { return side * side; }
    String describe() { return "square"; }
};

/* 形参写成接口引用：函数体里**不知道**会是谁，由运行期的类型号决定 */
int64 twice_area(Shape mut& shape) {
    return shape.area() * 2;
}

String tell(Shape mut& shape) {
    return shape.describe() + "（面积 " + format("{}", shape.area()) + "）";
}

int64 main() {
    /* ---- 静态调用：编译期就知道接收者是哪个结构体 ---- */
    Circle c;
    c.r = 2;
    Square s;
    s.side = 3;
    println("静态：{} area={} | {} area={}", c.describe(), c.area(), s.describe(), s.area());

    /* ---- 接口引用：先装进 Any，再按接口取出来 ---- */
    Any obj1;
    Any obj2;
    Circle mut& pc = heap Circle;
    pc->r = 4;
    Square mut& ps = heap Square;
    ps->side = 5;
    obj1.set(&pc);
    obj2.set(&ps);

    /* `o.getValue()` 的目标类型是接口引用 → 校验类型号（Circle / Square 都实现了 Shape）
     * 并给出一份胖引用副本；对象的地址还是那份，类型号跟着走。 */
    Shape mut& shape1 = obj1.getReference();
    Shape mut& shape2 = obj2.getReference();

    println("多态：{}", tell(shape1));
    println("多态：{}", tell(shape2));
    println("同一个函数：twice_area = {} / {}", twice_area(shape1), twice_area(shape2));

    /* ---- 接口引用是按"接口"取回来的，具体是谁要看 Any 里的类型号 ---- */
    println("类型匹配：circle={} square={}", isType<Circle mut&>(&obj1), isType<Square mut&>(&obj2));

    /* ---- 取回**具体类型**：目标类型不是接口，就要求类型号精确对上 ---- */
    Circle mut& back = obj1.getReference();
    println("取回具体类型：back->r={} back->name()={}", back->r, back->name());

    delete pc;
    delete ps;
    return 0;
}
