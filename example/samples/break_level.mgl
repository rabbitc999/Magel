// 层级只计算循环；跨层退出依次清理内层作用域。
int64 trace = 0;
int64 drops = 0;
void record(int64 digit) { trace = trace * 10 + digit; }
struct Resource : Drop {
    String text;
    void drop() { assert(self.text == "owned"); drops++; }
};
int64 afterLoops() {
    loop { loop { break level 2; }; };
    return 7;
}
int64 main() {
    int64 count = 0;
    for (int64 i = 0; i < 3; i++) {
        loop { count++; break level 1; };
        count += 10;
    }
    assert(count == 33);
    count = 0;
    loop {
        count++;
        while (true) {
            { if (true) { break level 2; } }
        }
        count += 100;
    };
    assert(count == 1);
    count = 0;
    for (int64 i = 0; i < 3; i++) {
        while (true) {
            do { count++; break level 2; } while (true);
            count += 100;
        }
        count += 10;
    }
    assert(count == 33);
    count = 0;
    loop {
        for (int64 item in [1,3]) {
            for (int64 i = 0; i < 3; i++) {
                match (item) { 1 => { count++; break level ALL; } _ => {} }
            }
        }
        count += 100;
    };
    assert(count == 1);
    List<String> words; words.push("first"); words.push("second");
    for (String word in words) {
        Resource resource; resource.text = "owned";
        defer record(1);
        loop {
            defer record(2);
            do {
                scope(exit) { record(3); }
                break level 3;
            } while (true);
        };
    }
    assert(trace == 321 && drops == 1);
    assert(words[0] == "first" && words[1] == "second");
    // 两个值块均不计层数；跨层跳转放弃尚未完成的初始化。
    loop {
        int64 result = {
            int64 inner = {
                while (true) { break level 2; }
                yield (1);
            };
            yield (inner);
        };
        assert(false);
    };
    loop {
        int64 abandoned = loop {
            if (false) { yield (1); }
            break level ALL;
        };
        assert(false);
    };
    assert(afterLoops() == 7);
    // all 不是普通代码中的保留字；只有 #level 参数忽略大小写。
    int64 all = 0;
    loop { loop { all++; break level all; }; assert(false); };
    loop { loop { all++; break level All; }; assert(false); };
    loop { loop { all++; break level aLl; }; assert(false); };
    loop { loop { all++; break level alL; }; assert(false); };
    loop { loop { all++; break level ALl; }; assert(false); };
    loop { loop { all++; break level AlL; }; assert(false); };
    loop { loop { all++; break level aLL; }; assert(false); };
    loop { loop { all++; break level ALL; }; assert(false); };
    assert(all == 8);
    println("break level OK");
    return 0;
}
