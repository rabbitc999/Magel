/* replace.mgl —— 单行宏 `$replace`
 *
 *   ./magel samples/replace.mgl
 *
 * `$replace` 把声明写在**一行**里：`$replace 宏名(形参) 宏体`，没有 `$end_macro`。
 * 它与 `$macro` 共用卫生 AST 替换，支持 `$stringify(…)`、`$concat(…)`、
 * `$line` / `$file` / `$module`，不使用自动括号或形参保护标注。
 * 宏体只有一行；需要分行书写 `$for` 等块时，使用 `$macro … $end_macro`。
 * 宏名、调用方式和 `$macro` 完全一样，两种声明混用也行。
 * 无形参的对象宏可以省掉括号：`$replace 宏名 宏体`，调用处裸写宏名。
 */

$replace ADD(a, b) a + b
$replace TIMES_TWO(x) x * 2
$replace SHOW(x) $stringify(x)
$replace MAKE(pre, suffix) $concat(pre, suffix)
$replace AT $line
$replace LIMIT 100

int64 var_x = 9;

int64 main() {
    /* 替换后的加法 AST 保持完整，先计算 2 + 3，再乘 10，结果为 50。 */
    println("{}", $ADD(2, 3) * 10);

    /* 形参的加法 AST 保持完整，先计算 1 + 2，再乘 2，结果为 6。 */
    println("{}", $TIMES_TWO(1 + 2));

    /* `$stringify` 拿原始拼写，打印 "1 + 2"。 */
    println("{}", $SHOW(1 + 2));

    /* `$concat` 拼出来的变量名照样可用。 */
    println("{}", $MAKE(var, _x));

    /* `$line` 取的是调用点所在行。 */
    println("{}", $AT);

    /* 省括号的对象宏：调用处写 `$LIMIT`，不带实参。 */
    println("{}", $LIMIT + 1);

    return 0;
}
