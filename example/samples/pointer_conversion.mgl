module pointerConversion;

struct Box {
    int64 value;
};

int64 main() {
    Box mut& pointer = heap Box;
    pointer->value = 7;
    Option<Box mut&> optional = toOptional<Box>(pointer);
    Box mut& restored = toReference<Box>(optional);
    Option<Box mut&> alias = toOptional<Box>(restored);
    match (alias) {
        Option<Box mut&>::Value(value) => { println("{}", value->value); }
        Option<Box mut&>::None => { println("none"); }
    }

    Any boxed = &pointer;
    Option<Box mut&> fromObject = boxed.getOptional();
    match (fromObject) {
        Option<Box mut&>::Value(value) => { println("{}", value->value); }
        Option<Box mut&>::None => { println("none"); }
    }

    boxed = 42;
    Option<Box mut&> absent = boxed.getOptional();
    match (absent) {
        Option<Box mut&>::Value(value) => { println("{}", value->value); }
        Option<Box mut&>::None => { println("none"); }
    }
    delete pointer;
    return 0;
}
