int32 counter = 0;
int32 next() { counter += 1; return counter; }

int64 main() {
    int32 value = 3;
    print(f"value={value};");
    println(f"next={next()} {next()};literal=\{x\};percent=100%");
    assert(counter == 2);
    std::lang::println(f"nested={f"value {value}"}");
    String text = f"saved={value}";
    println(text);
    println("interpolation print OK");
    return 0;
}
