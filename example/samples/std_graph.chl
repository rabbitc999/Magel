import std::graph;
int64 main(){
    Graph dag=Graph::create(6,true);
    dag.addEdge(0,1,1); dag.addEdge(0,2,1); dag.addEdge(1,3,2);
    dag.addEdge(2,3,2); dag.addEdge(3,4,3); dag.addEdge(5,0,1);
    println("bfs {} {} {}", dag.bfs(0)[0], dag.bfs(0)[1], dag.bfs(0)[2]);
    println("dfs {} {}", dag.dfs(0)[0], dag.dfs(0)[1]);
    println("topo {} {} {} {} {} {}", dag.topologicalSort()[0], dag.topologicalSort()[1],
            dag.topologicalSort()[2], dag.topologicalSort()[3], dag.topologicalSort()[4],
            dag.topologicalSort()[5]);
    assert(!dag.hasCycle());
    Graph cycle=Graph::create(2,true);
    cycle.addEdge(0,1,1); cycle.addEdge(1,0,1);
    assert(cycle.hasCycle() && cycle.topologicalSort().len()==0);
    Graph road=Graph::create(5,false);
    road.addEdge(0,1,4); road.addEdge(0,2,1); road.addEdge(2,1,2);
    road.addEdge(1,3,5); road.addEdge(2,3,8); road.addEdge(3,4,3);
    assert(road.connectedComponents()==1 && road.len()==6);
    println("dist {} {} {} {} {}", road.dijkstra(0)[0], road.dijkstra(0)[1],
            road.dijkstra(0)[2], road.dijkstra(0)[3], road.dijkstra(0)[4]);
    println("mst {}", road.minimumSpanningTreeWeight());
    Graph split=Graph::create(4,false);
    split.addEdge(0,1,1); split.addEdge(2,3,1);
    assert(split.connectedComponents()==2 && split.minimumSpanningTreeWeight()==0-1);
    UnionFind dsu=UnionFind::create(5);
    assert(dsu.unionSets(0,1) && dsu.unionSets(1,2) && !dsu.unionSets(0,2));
    assert(dsu.connected(0,2) && dsu.sizeOf(0)==3 && dsu.count()==3);
    assert(dsu.unionSets(3,4) && dsu.count()==2);
    println("union-find OK");
    return 0;
}
