/* fn 与函数指针、惰性适配器、引用元素及拥有型返回值组合。 */
import std::iter;
import std::algorithms;


int64 apply(int64 fn(int64) callback, int64 value) { return callback(value); }
int64 applyAlias(int64 fn(int64) callback, int64 value) { return callback(value); }
T applyGeneric<T>(T fn(T) callback, T value) { return callback(value); }
void action(void fn() callback) { callback(); }
int64 observed = 0;

int64 main() {
    assert((apply(fn(value) { value + 3 }, 7)) == (10));
    assert((applyAlias(fn(value) { value * 2 }, 7)) == (14));
    assert((applyGeneric(fn(value) { value + 2 }, 7)) == (9));
    int64 fn(int64) increment = fn(value) { value + 1 };
    assert((increment(8)) == (9));
    auto typed = fn(int64 value) { value * 3 };
    assert((apply(typed, 4)) == (12));
    List<int64> eager; eager.push(2); eager.push(3);
    auto mapped = std::algorithms::mapValue<int64>(eager, fn(int64 value) { value * 2 });
    assert((mapped[1]) == (6));
    auto selected = std::iter::range(1, 6)
    .map(fn(value) { value * 2 })
    .filter(bool fn(int64 value) { value > 4 })
    .inspect(void fn(int64 value) {})
    .collect();
    assert((selected.len()) == (3));
    assert((selected[0]) == (6));
    assert((selected[2]) == (10));
    auto localWork = int64 fn(int64 seed) {
        auto (a,b) = (seed,2);
        match(Option<int64>::Value(a)) {
            Option<int64>::Value(selected) => { return selected+b; }
            Option<int64>::None => { return 0; }
        }
        return 0;
    };
    assert((localWork(5)) == (7));
    assert((std::iter::range(1, 3).zip(std::iter::range(4, 6))
    .map(fn(pair) { pair.0 + pair.1 }).fold(0, fn(a,b) { a+b })) == (12));
    assert((std::iter::range(1, 5).fold(0, fn(acc, value) { acc + value })) == (10));
    assert((std::iter::range(1, 5).all(fn(value) { value > 0 })) == (true));
    assert((std::iter::range(1, 5).any(fn(value) { value == 3 })) == (true));
    assert((std::iter::range(1, 5).find(fn(value) { value == 2 }).unwrap()) == (2));
    assert((std::iter::range(1, 5).filterMap(Option<int64> fn(int64 value) {
        if (value % 2 == 0) { return Option<int64>::Value(value * 2); }
        return Option<int64>::None;
    }).count()) == (2));
    auto scanned = std::iter::range(1, 4).scan(0, Option<int64> fn(int64 mut& acc, int64 value) {
        acc = acc + value;
        return Option<int64>::Value(acc);
    }).collect();
    assert((scanned[2]) == (6));
    assert((std::iter::range(1, 5).takeWhile(fn(value) { value < 3 }).count()) == (2));
    assert((std::iter::range(1, 5).skipWhile(fn(value) { value < 3 }).next().unwrap()) == (3));
    assert((std::iter::range(1, 5).mapWhile(Option<int64> fn(int64 value) {
        if (value < 3) { return Option<int64>::Value(value); }
        return Option<int64>::None;
    }).count()) == (2));
    assert((std::iter::range(1, 5).findMap(Option<int64> fn(int64 value) {
        if (value == 3) { return Option<int64>::Value(value * 2); }
        return Option<int64>::None;
    }).unwrap()) == (6));
    auto checked = std::iter::range(1, 4).tryFold(0, Result<int64,String> fn(int64 acc,int64 value) {
        return Result<int64,String>::Ok(acc+value);
    });
    assert((checked.unwrap()) == (6));
    auto split = std::iter::range(1, 5).peekingTakeWhile(fn(value) { value < 3 });
    auto prefix = split.0;
    auto rest = split.1;
    assert((prefix.count()) == (2));
    assert((rest.next().unwrap()) == (3));
    List<int64> numbers; numbers.push(1); numbers.push(2);
    {
        auto refs = numbers.iterMut();
        refs.forEach(void fn(int64 mut& value) { value = value + 10; });
        assert((numbers[0]) == (11));
        assert((numbers.iter().map(fn(value) { value * 2 }).fold(0, fn(a,b) { a+b })) == (46));
    }
    for (int64 round = 0; round < 4; round = round + 1) {
        auto labels = std::iter::range(1, 4).map(fn(value) { format("n{};", value) }).collect();
        assert((labels[2]) == ("n3;"));
    }
    auto punctuation = fn() { "a;b" };
    assert((punctuation()) == ("a;b"));
    action(void fn() {});
    action(void fn() { assert(true) });
    action(void fn() { assert(true); return; });
    std::iter::range(1, 4).forEach(void fn(int64 value) { observed = observed + value; });
    assert((observed) == (6));
    observed = 10;
    auto readGlobal = fn() { observed };
    observed = 20;
    assert((readGlobal()) == (20));
    println("fn callbacks OK");
    return 0;
}
