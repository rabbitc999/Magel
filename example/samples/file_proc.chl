void main()
{
    File out = fopen("tmp/chali_file_proc.txt", "w");
    fwrite(out, "alpha\nbeta\n");
    fclose(out);

    File input_file = fopen("tmp/chali_file_proc.txt", "r");
    String first = fread(input_file);
    String second = fread(input_file);
    println("{}|{}|{}", first, second, feof(input_file));
    String tail = fread(input_file);
    println("eof={} empty={}", feof(input_file), len(tail));
    fclose(input_file);

    Process child = prun("echo chali-proc");
    String line = pread(child);
    int64 code = pclose(child);
    println("{}:{}", line, code);

}
