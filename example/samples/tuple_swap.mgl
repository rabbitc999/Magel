// 右侧必须完整保存后再写回，禁止复制传播把交换退化为覆盖。
(T, T) reverse<T>(T first, T second){return second, first;}
int64 main(){
    int64 x=7,y=42;
    (x,y)=(y,x);
    assert(x==42 && y==7);
    (x,y)=(y,x);
    assert(x==7 && y==42);
    x=-3; y=10000000000;
    for(int64 i=0;i<101;i++){(x,y)=(y,x);}
    assert(x==10000000000 && y==-3);
    (x,y)=reverse<int64>(x,y);
    assert(x==-3 && y==10000000000);
    String left="left",right="right";
    (left,right)=(right,left);
    assert(left=="right" && right=="left");
    (left,right)=reverse<String>(left,right);
    assert(left=="left" && right=="right");
    println("tuple swap OK"); return 0;
}
