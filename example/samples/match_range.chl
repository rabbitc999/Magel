/* match_range.chl —— `match` 的区间模式。
 *
 * 整数与 char 的区间模式使用标准调用：
 *   range(a,b)    左闭右开     a <= x < b
 *   rangeEq(a,b)  闭区间       a <= x <= b
 * `_` 仍可兜底；标量分支照旧写常量。
 */
int64 classify(int64 x) {
    match (x) {
        std::lang::range(0, 10) => { return 1; }
        std::lang::range(10, 20) => { return 2; }
        std::lang::range(20, 30) => { return 3; }
        std::lang::rangeEq(30, 40) => { return 4; }
        _ => { return 0; }
    }
}

float64 classifyF(float64 x) {
    match (x) {
        _ if x >= 0.0 && x < 1.0 => { return 1.0; }
        _ if x >= 1.0 && x <= 2.0 => { return 2.0; }
        _ => { return 0.0; }
    }
}

void main() {
    println("5 -> {}", classify(5));
    println("10 -> {}", classify(10));
    println("20 -> {}", classify(20));
    println("30 -> {}", classify(30));
    println("40 -> {}", classify(40));
    println("100 -> {}", classify(100));

    println("0.5 -> {}", classifyF(0.5));
    println("1.0 -> {}", classifyF(1.0));
    println("1.5 -> {}", classifyF(1.5));

}
