/* array2d.mgl —— 多维数组：行主序、每槽 8 字节，下标在降级时折成一维。
 * 本例使用 int64 元素；其他元素类型可见 std_linalg_solve_glue 等正式样例。 */

int64 main() {
    int64 m[3][4];
    int64 i = 0;
    int64 j = 0;

    {
        i = 0;
        while (i < 3) {

        {
            j = 0;
            while (j < 4) {

            m[i][j] = (i + 1) * 10 + j;
        
                j = j + 1;
            }
        }
    
            i = i + 1;
        }
    }

    println("m[0][0]={} m[1][2]={} m[2][3]={}", m[0][0], m[1][2], m[2][3]);

    int64 sum = 0;
    {
        i = 0;
        while (i < 3) {

        {
            j = 0;
            while (j < 4) {

            sum = sum + m[i][j];
        
                j = j + 1;
            }
        }
    
            i = i + 1;
        }
    }
    println("sum = {}", sum);

    int64 row[4];
    row[0] = 11;
    row[1] = 22;
    row[3] = 44;
    println("row[0]={} row[3]={} index(row,1)={}", row[0], row[3], index(row, 1));
    return 0;
}
