import std::concurrency;


import std::coroutine;
import std::message;

struct Reading { String source; Map<String, int64> values; };

std::concurrency::Shared<int64> sharedTotal;

void collect() {
    Reading incoming = std::message::receiveCoroutine<Reading>();
    int64 old = sharedTotal.swap(incoming.values["front"]);
    std::message::sendCoroutine<Reading>(std::coroutine::parent(), incoming);
    std::message::sendCoroutine<int64>(std::coroutine::parent(), old);
}

int64 main() {
    sharedTotal = std::concurrency::Shared<int64>::create(2);
    Reading outgoing;
    outgoing.source = "lidar";
    Map<String, int64> values;
    values.put("front", 12);
    outgoing.values = values;
    SharedCoroutineHandle task = std::coroutine::create(collect);
    std::message::sendCoroutine<Reading>(task, outgoing);
    outgoing.values.put("front", 99);
    Reading reply = std::message::receiveCoroutine<Reading>();
    int64 old = std::message::receiveCoroutine<int64>();
    std::coroutine::wait(task);
    List<int64> seed;
    seed.push(3);
    std::concurrency::Shared<List<int64>> sharedList = std::concurrency::Shared<List<int64>>::create(seed);
    List<int64> copy = sharedList.get();
    seed.push(9);
    copy.push(4);
    sharedList.set(copy);
    List<int64> latest = sharedList.get();
    std::message::sendCoroutine<String>(std::coroutine::current(), "typed");
    String text = std::message::receiveCoroutine<String>();
    std::message::sendCoroutine<float64>(std::coroutine::current(), 1.25);
    float64 decimal = std::message::receiveCoroutine<float64>();
    println("{} {} {} {}", reply.source, reply.values["front"], old,
    sharedTotal.get());
    println("{} {}", latest.len(), latest[1]);
    println("{} {}", text, decimal);
    return 0;
}
