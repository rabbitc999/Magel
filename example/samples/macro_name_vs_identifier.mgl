/* macro_name_vs_identifier.mgl —— 宏调用必须带 `$`，裸名只是普通标识符。
 *
 *   ./magel samples/macro_name_vs_identifier.mgl
 *
 * `ADD` 既是宏名又是变量名：裸写 `ADD` 读变量，`$ADD(1, 3)` 才是宏展开。
 * 两者互不干扰 —— 这是 `$` 调用语法相对「裸名调用」最关键的好处。
 */

$replace expr ADD((a), (b)) a + b

int64 ADD = 1;   /* 和宏同名的变量，不会被宏吃掉 */

int64 main() {
    int64 yes = $ADD(1, 3);             /* ((1) + (3)) = 4 */
    println("var={} macro={}", ADD, yes);
    return 0;
}
