/* 块表达式与卫生变长宏：每个元素只求值一次，push 按顺序追加副本。 */
$macro vec(type, ...values)
{
    List<type> $0;
$for item in values
    { type $1 = item; $0.push($1); }
$end_for
    yield ($0);
}
$end_macro

int32 counter = 0;
int32 next() { counter += 1; return counter; }
int32 identity(int32 value) { return value; }
int32 result() { return { int32 local = 11; yield (local); }; }

int64 main() {
    int32 a = { int32 b = 3; yield (b); };
    assert(a == 3);
    a = { int32 b = 4; yield (b); };
    assert(a == 4);
    a = { int32 b = { yield (5); }; yield (b + 1); };
    assert(a == 6);
    a = { if (a == 6) { yield (7); } else { yield (8); } };
    assert(a == 7);
    assert(identity({ yield (9); }) == 9 && result() == 11);
    bool skipped = false && { counter += 1; yield (true); };
    assert(!skipped && counter == 0);
    List<int32> values = $vec(int32, next(), next(), next());
    assert(len(values) == 3 && values[0] == 1 && values[2] == 3 && counter == 3);
    values = $vec(int32, 9, 10);
    assert(len(values) == 2 && values[0] == 9 && values[1] == 10);
    List<int32> empty = $vec(int32);
    assert(len(empty) == 0);
    List<String> words = $vec(String, "hello", "世界");
    assert(words[0] == "hello" && words[1] == "世界");
    int32 sum = 0;
    for (int32 i = 0; i < 3; i += 1) {
        sum += { if (i == 1) { continue; } yield (i); };
    }
    assert(sum == 2);
    println("block expression OK");
    return 0;
}
