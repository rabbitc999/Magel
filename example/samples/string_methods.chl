void main()
{
    String text = "  Hello, ChaLi!\r\n";
    assert(text.length() == 17 && text.size() == 17 && text.byteLength() == 17);
    assert(!text.isEmpty() && "".isEmpty());
    assert(" \t\r\n".isBlank() && "".isBlank() && !text.isBlank());
    assert("0129".isDigit() && !"".isDigit() && !"12x".isDigit());
    assert("ChaLi".isAlpha() && !"ChaLi1".isAlpha());
    assert("ChaLi24".isAlnum() && !"a_b".isAlnum());
    assert(text.isAscii() && !"你好".isAscii());
    assert(text.trim() == "Hello, ChaLi!");
    assert(text.trimStart() == "Hello, ChaLi!\r\n");
    assert(text.trimEnd() == "  Hello, ChaLi!");
    assert("你好ABC".toLower() == "你好abc");
    assert("你好abc".toUpper() == "你好ABC");
    assert("abcabc".indexOf("bc") == 1 && "abcabc".indexOf("bc", 2) == 4);
    assert("abcabc".lastIndexOf("bc") == 4 && "abcabc".lastIndexOf("bc", 2) == 1);
    assert("abc".indexOf("x") == 0 - 1 && "abc".indexOf("", 999) == 3);
    assert("abc".contains("b") && "abc".contains(""));
    assert("abc".startsWith("ab") && !"abc".startsWith("abcd"));
    assert("abc".endsWith("bc") && "abc".endsWith(""));
    assert("aaaaa".count("aa") == 2 && "abc".count("") == 4);
    assert("a".compare("b") == 0 - 1 && "b".compare("a") == 1 && "a".compare("a") == 0);
    assert("abc".byteAt(0).unwrap() == 97 && "abc".byteAt(3).isNone());
    assert("abc".byteAt(0 - 1).isNone());
    assert("abcdef".substring(2, 3) == "cde" && "abc".substring(100) == "");
    assert("abcdef".slice(1, 4) == "bcd" && "abc".slice(2, 1) == "");
    assert("abc".left(2) == "ab" && "abc".left(0 - 1) == "");
    assert("abc".right(2) == "bc" && "abc".right(99) == "abc");
    assert("ababa".replaceFirst("a", "x") == "xbaba");
    assert("ababa".replaceAll("a", "xy") == "xybxybxy");
    assert("ababa".replace("ba", "") == "a" && "abc".replace("", "x") == "abc");
    assert("xy".repeat(3) == "xyxyxy" && "xy".repeat(0) == "");
    assert("你好🙂".reverse() == "🙂好你" && "".reverse() == "");
    assert("7".padStart(4, "0") == "0007" && "7".padEnd(4, "ab") == "7aba");
    assert("ab".padStart(1) == "ab" && "ab".padEnd(9, "") == "ab");
    assert("prefix_name".removePrefix("prefix_") == "name");
    assert("name.txt".removeSuffix(".txt") == "name" && "name".removeSuffix(".txt") == "name");
    assert("ac".insert(1, "b") == "abc" && "abc".insert(99, "d") == "abcd");
    assert("abcdef".remove(2, 2) == "abef" && "abc".remove(1) == "a");
    String unicode = "你a🙂";
    assert(unicode.length() == 8 && unicode.charLength() == 3);
    assert(unicode.charAt(0).unwrap() == "你" && unicode.charAt(2).unwrap() == "🙂");
    assert(unicode.charAt(3).isNone() && unicode.charAt(0 - 1).isNone());
    assert(unicode.utf8Substring(1, 2) == "a🙂" && unicode.utf8Substring(99) == "");
    List<String> characters = unicode.unicodeChars();
    assert(characters.len() == 3 && characters[0] == "你" && characters[2] == "🙂");
    List<String> parts = "a,,b,".split(",");
    assert(parts.len() == 4 && parts[1] == "" && parts[3] == "");
    assert("a,,b,".split(",", false).len() == 2);
    assert("你🙂".split("").len() == 2 && "".split("").len() == 0);
    assert("".split(",").len() == 1);
    assert(" a\t b\r\nc ".splitWhitespace().len() == 3);
    List<String> lines = "a\r\nb\rc\n".lines();
    assert(lines.len() == 4 && lines[1] == "b" && lines[3] == "");
    assert("a\r\n\n".lines(false).len() == 1);
    assert("-".join(parts) == "a--b-" && "".join(characters) == unicode);
    List<String> empty;
    assert(",".join(empty) == "");
    List<uint8> bytes = "ab".bytes();
    bytes[0] = (uint8)120;
    assert(bytes.len() == 2 && "ab".byteAt(0).unwrap() == 97);
    assert("bc".prepend("a").concat("d") == "abcd");
    String original = "same";
    String copy = original;
    copy = copy.replaceAll("s", "g");
    assert(original == "same" && copy == "game");
    println("string methods: byte, UTF-8, empty, bounds and value semantics OK");

}
