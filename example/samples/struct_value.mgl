/* 结构体是**值语义**：声明 / 赋值 / 当实参之外的地方都是"独立的对象" ——
 * `Point a = b;`、`a = b;`、`arr[i] = b;` 都是**逐槽深拷贝**，改一个不会动到另一个。
 *
 * 要"两个名字指同一份对象"，就存**引用**（`Point mut& p = heap Point;`，或拿数组元素的地址
 * `&items[0]`）：从引用写进去，两边都能看见。
 *
 * 普通按值形参也复制；需要函数修改调用方对象时，显式声明 `Point mut&` 参数。
 */

struct Point {
    int64 x;
    int64 y;
};

Point make_point(int64 x, int64 y) {
    Point p;
    p.x = x;
    p.y = y;
    return p;
}

int64 main() {
    /* 返回值赋给变量时拷贝：同一个函数两次调用的结果是两个独立对象 */
    Point a = make_point(1, 2);
    Point b = make_point(3, 4);
    println("a=({},{}) b=({},{})", a.x, a.y, b.x, b.y);

    /* 声明时初始化：深拷贝 */
    Point c = a;
    c.x = 99;
    println("改 c 之后 a.x={} c.x={}", a.x, c.x);

    /* 赋值：深拷贝 */
    a = b;
    a.y = 77;
    println("a=({},{}) b=({},{})", a.x, a.y, b.x, b.y);

    /* 数组元素之间也是值拷贝 */
    Point items[2];
    items[0] = a;
    items[0].x = 5;
    println("items[0].x={} a.x={}", items[0].x, a.x);

    /* 引用：两个名字指同一份（堆上那块），写进去互相可见 */
    Point mut& shared = heap Point;
    shared->x = 1;
    Point mut& alias = shared;
    alias->x = 42;
    println("引用共享：shared->x={} alias->x={}", shared->x, alias->x);
    delete shared;

    /* 指向数据区里的元素：读得到（只读引用），要写就用可写引用 */
    Point const& view = &items[0];
    println("view->x={}", view->x);
    return 0;
}
