/* macro_qualified.mgl —— 宏定义可以按限定名跨模块调用：`$std::lang::assert(...)`。
 *
 * 未限定写法 `$assert(...)` 靠「`std::lang` 始终可见 + import 进来的模块可见」这套规则找宏；
 * 名字被同名的函数 / 变量挡住，或者想明确点名某个模块时，就写全限定名。
 * 展开行为与未限定写法完全一致：`$line` 拿到的仍是调用点那一行。
 */

module qualified;

int64 main() {
    int64 n = 3;
    $std::lang::assert(n > 0);
    $std::lang::assert(n < 10, "n 得是个位数");
    println("跨模块宏调用都过了，{}", n);
    return 0;
}
