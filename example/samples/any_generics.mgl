$macro example(...A)(...B)
{
    List<Any> listA;
    List<Any> listB;
    $for var in A
    listA.push(var);
    $end_for
    $for var in B
    listB.push(var);
    $end_for
    yield (listA, listB);
}
$end_macro

int64 main()
{
    auto li = $example(1, "2", 3, 4, 1, 1)(3, 2, 4, 1);
    auto listA = li.0;
    auto listB = li.1;
    Any first = listA[0];
    Any second = listA[1];
    println("A={} B={}", listA.len(), listB.len());
    println("{} {}", tryGet<int64>(&first).unwrap(), tryGet<String>(&second).unwrap());
    return 0;
}
