/* pointer_sort.mgl —— 引用形式的排序：收 `T mut&` + 个数，原地排，不产生第二份数组
 *
 *   ./magel samples/pointer_sort.mgl
 *
 * `std::algorithms` 有两组排序：
 *   * `sortValue<T>(list)` 收 `List<T>`，返回**排序副本**（稳定），原表不动；
 *   * `sortReference<T>(data, count)` 收 `T mut&` + 元素个数，**在原地**排，O(1) 额外空间。
 * 这里演示后者：调用点写 `sortReference<int64>(&raw[0], len(raw))`（数组本身也能
 * 直接退化传进去），排完 `raw` 自己就有序，不再复制一份。
 *
 * 元素比较走 `>`：内建数值和字符串直接用；结构体要实现运算符接口
 * `Greater<bool, T>`（`bool leftGreater(T right)`，**返回类型写在第一个实参**），
 * 排序顺序就由这个方法决定。默认实现是插入排序（稳定）。
 */

import std::algorithms;
import std::memory;

struct Item : Greater<bool, Item> {
    int64 weight;
    String name;

    /* 先写 weight 小的（升序）；反过来写这句就是降序。 */
    bool leftGreater(Item right) {
        return self.weight > right.weight;
    }
};

int64 main() {
    /* &raw[0] 是首元素引用，len(raw) 是元素个数；两个下标 1 的元素排完都在前两位。 */
    int64 raw[] = new[5];
    raw[0] = 4; raw[1] = 1; raw[2] = 3; raw[3] = 1; raw[4] = 2;
    std::algorithms::sortReference<int64>(raw, len(raw));
    println("{} {} {} {} {}", raw[0], raw[1], raw[2], raw[3], raw[4]);
    delete raw;

    /* 字符串也走同一套：`>` 按字典序。 */
    String words[] = new[3];
    words[0] = "pear"; words[1] = "apple"; words[2] = "fig";
    std::algorithms::sortReference<String>(&words[0], len(words));
    println("{} {} {}", words[0], words[1], words[2]);
    auto view = std::memory::Span<String>::from(&words[0], len(words));
    assert(view[0] == "apple" && view[2] == "pear");
    for (String mut& item in view) {
        item[0] = 'X';
    }
    assert(words[0] == "Xpple" && words[1] == "Xig" && words[2] == "Xear");
    index(view.data, 1) = "fig";
    String const& firstWord = &index(view.data, 0);
    assert(firstWord[0] == 'X');
    delete words;

    /* 结构体数组：比较规则来自它的运算符接口，引用形式照用。 */
    Item items[] = new[3];
    items[0].weight = 2; items[0].name = "b";
    items[1].weight = 5; items[1].name = "a";
    items[2].weight = 3; items[2].name = "c";
    std::algorithms::sortReference<Item>(items, len(items));
    println("{} {} {}", items[0].name, items[1].name, items[2].name);
    delete items;
    return 0;
}
