/* containers.mgl —— 三个内建容器：`List<T>` / `Set<T>` / `Map<K,V>`。
 *
 *   ./magel samples/containers.mgl
 *   → 增 / 删 / 改 / 查 / 遍历 / 生命周期
 *
 * 写法上像"泛型"（`List<int64>` / `Map<String, int64>`），其实是**编译期定死的三种容器**：
 * 每个都对应虚拟机里一个 C++ 对象（`vector` / `map`），`<…>` 里的类型只
 * 决定"传进去的值怎么解释"（数值 / 字符串副本 / 地址 / 对象副本），不做单态化 ——
 * 也就是"不用实现真泛型"。
 *
 * 约定（和结构体一样是**值语义**）：
 *   * `List<int64> v;` 声明出来就是**建好的空容器**，直接 `v.push(1)`；
 *   * 赋值 / 初始化是**复制一份**（`List<int64> b = a;` 之后 a、b 各一份，互不影响）；
 *   * 容器归**声明它的块**所有：出块自动释放（要提前还就 `delete v;`）；
 *   * 字符串元素按**副本**存（取出来是新的一份），所以容器活得比某根字符串久也没事；
 *   * 结构体连同嵌套值字段按副本存；显式引用仍保存地址。
 */

struct Pair : Equal<bool, Pair>, Hash<Pair> {
    int64 x;
    int64 y;
    bool leftEqual(Pair value) { return self.x == value.x && self.y == value.y; }
    uint64 hash(Pair value) { return (uint64)(self.x ^ self.y); }
};

Pair p;

int64 main() {
    /* ---------- List<T>：有序表，按下标增删改查 ---------- */
    List<int64> v;
    v.push(30);
    v.push(10);
    v.push(20);
    println("vec: len={} v[0]={} v[2]={}", len(v), v[0], v[2]);

    v[1] = 99;                                   /* 按下标改 */
    println("改 v[1]={}；contains(20)={} indexOf(99)={}",
    v[1], v.contains(20), v.indexOf(99));

    v.insert(0, 7);                               /* 插到最前面 */
    println("insert 之后：v[0]={} len={}", v[0], len(v));

    int64 last = v.pop();                           /* 弹出末尾（顺便拿到它） */
    println("pop={} len={}", last, len(v));

    v.remove(0);                                  /* 按下标删 */
    println("remove(0) 之后：v[0]={} len={}", v[0], len(v));

    v.clear();
    println("clear 之后：len={}", len(v));

    /* ---------- Set<T>：元素不重复，按升序遍历 ---------- */
    Set<int64> s;
    s.add(5);
    s.add(3);
    s.add(5);                                     /* 重复的加不进去 */
    println("set: len={} has(5)={} has(9)={}", len(s), s.has(5), s.has(9));
    println("按升序看：at(0)={} at(1)={}", s.at(0), s.at(1));
    println("remove(5) 拿回 {}，现在 len={}", s.remove(5), len(s));

    /* ---------- Map<K,V>：键 → 值 ---------- */
    Map<String, int64> ages;
    ages.put("amy", 11);
    ages.put("bob", 22);
    ages["cid"] = 33;                             /* `m[k] = v` 等价于 put */
    println("map: len={} amy={} has(bob)={} cid={}",
    len(ages), ages["amy"], ages.has("bob"), ages["cid"]);
    println("没这个键：has(zoe)={} 下标读出来={}",
    ages.has("zoe"), ages["zoe"]);
    println("remove(bob) 拿回 {}，现在 len={}", ages.remove("bob"), len(ages));

    /* ---------- 遍历：按下标 / 按升序键 ---------- */
    List<String> names;
    names.push("ada");
    names.push("bob");
    names.push("cid");
    String joined = "";
    for (int64 i = 0; i < len(names); i = i + 1) {
        joined = joined + names[i] + " ";         /* 字符串元素取出来是新的一份 */
    }
    println("std::lang::List<string> 遍历：{}（len={}，contains(bob)={}）",
    joined, len(names), names.contains("bob"));

    String keys = "";
    String values = "";
    for (int64 i = 0; i < len(ages); i = i + 1) {
        keys = keys + ages.keyAt(i) + " ";
        values = values + format("{} ", ages.valAt(i));
    }
    println("map 按升序遍历：键 {}| 值 {}", keys, values);

    /* ---------- 非标量：结构体和 Any 都按副本存 ---------- */
    p.x = 4;
    p.y = 9;
    List<Pair> pairs;
    pairs.push(p);
    Pair back = pairs[0];
    println("std::lang::List<Pair>：{},{} contains={}", back.x, back.y, pairs.contains(p));

    Map<Pair, int64> weights;
    weights.put(p, 13);
    println("std::lang::Map<Pair,int64>：has={} value={}", weights.has(p), weights[p]);

    Any box;
    box.set(77);
    List<Any> boxes;
    boxes.push(box);
    Any box_back = boxes[0];
    println("std::lang::List<std::lang::Any>：{} contains={}", (int64)box_back.getValue(), boxes.contains(box));

    Set<Any> object_set;
    object_set.add(box);
    Any set_key = object_set.at(0);
    int64 set_has = object_set.has(set_key);
    int64 set_removed = object_set.remove(set_key);
    println("std::lang::Set<std::lang::Any> 取出再查：has={} remove={}",
    set_has, set_removed);

    Map<Any, int64> object_map;
    object_map.put(box, 88);
    Any map_key = object_map.keyAt(0);
    Map<Any, int64> object_map_copy = object_map;
    delete box;                                  /* 键身份不依赖原变量继续存活 */
    println("std::lang::Map<std::lang::Any,int64> 取出再查：has={} 值={} 副本={}",
    object_map.has(map_key), object_map[map_key], object_map_copy[map_key]);
    Any unrelated;
    unrelated.set(77);
    println("std::lang::Map<std::lang::Any,int64> 同内容新对象：has={}", object_map.has(unrelated));
    println("std::lang::Map<std::lang::Any,int64> remove={}", object_map.remove(map_key));

    /* ---------- 生命周期：容器归这一层块，出块自动还 ---------- */
    {
        List<int64> inner;
        inner.push(1);
        inner.push(2);
        println("块里的表：len={}", len(inner));
    }                                             /* ← 这里把 inner 还回去了 */

    List<int64> a;
    a.push(1);
    List<int64> b = a;                               /* 值语义：复制一份 */
    b.push(2);
    println("值语义：a={} b={}（a 没被 b 改动）", len(a), len(b));
    return 0;
}
