/* `drop` 接管析构：对实现 Drop 的值调用它的 drop()，并且取消出块时的自动析构
 * （所以不会析构两次）。这里是 drop 与作用域自动释放并存的对照。 */
struct Resource : Drop {
    int64 value;

    Resource(int64 value) {
        self.value = value;
    }

    void drop() {
        println("drop {}", self.value);
    }
};

void main() {
    Resource first = new Resource(1);
    Resource second = new Resource(2);
    first.drop();                       /* 显式 drop：调用 drop() 并取消本块的自动析构 */
    println("after delete first");
    second.value = 22;
    return;                           /* 出块：second 自动析构一次 */
}
