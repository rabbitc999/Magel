/* 默认只读引用；显式 mut 修改外部变量；copy 拥有独立状态。 */
import std::iter;
struct Profile { String name; List<int64> scores; };
struct Resource:Drop { int64 value; void drop() {} };
int64 fn(int64) makeAdder(int64 mut& amount) {
    return fn(int64 value) { value + amount };
}
int64 apply(int64 fn(int64) callback,int64 value){return callback(value);}
void main(){
    int64 amount=7;
    let add=fn(int64 value){value+amount};
    amount=100; assert(add(3)==103);
    let copied=add;
    let tick=int64 fn mut(){amount+=1;return amount;};
    assert(tick()==101 && copied(1)==102);
    int64 other=2;
    let factory=makeAdder(&other);
    other=4; assert(factory(3)==7);
    String source="old"; let readText=fn(){source};
    source="new"; assert(readText()=="new");
    let writeText=void fn mut(){source="written";};
    writeText();assert(source=="written");
    List<int64> list;list.push(5);
    let read=fn(int64 index){list[index]};
    list[0]=9;assert(read(0)==9);
    let append=void fn mut(){list.push(11);};append();assert(list.len()==2);
    Profile profile;profile.name="before";profile.scores.push(8);
    let update=void fn mut(){profile.name="after";profile.scores[0]=99;};
    update();assert(profile.name=="after" && profile.scores[0]==99);
    let pair=(1,2);let updatePair=void fn mut(){pair=(3,4);};updatePair();
    assert(pair.0==3 && pair.1==4);
    int64 mut& alias=&amount;let throughAlias=void fn mut(){alias+=1;};
    throughAlias();assert(amount==102);
    Resource resource;let useResource=void fn mut(){resource.value=9;};
    useResource();assert(resource.value==9);
    let mapped=std::iter::range(1,4).map(fn(value){value+amount}).collect();
    assert(mapped[0]==103 && mapped[2]==105);
    {
        int64 i=0;
        while (i<20) {

        let local=int64 fn(){i+amount};assert(local()==i+102);
    
            i+=1;
        }
    }
    println("fn captures OK");
}
