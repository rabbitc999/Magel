/* 核心 lang 转换无需 import，向零截断并检查结果范围。 */
int64 main() {
    assert(toInt32(12.75).unwrap() == (int32)12);
    assert(toInt32(-12.75).unwrap() == (int32)-12);
    assert(toInt64(12.75) == 12);
    assert(toInt64(-12.75) == -12);
    assert(toInt32((float32)1.9).unwrap() == (int32)1);
    assert(toInt64((float32)-1.9) == -1);
    assert(toInt32(-0.0).unwrap() == (int32)0);
    assert(toInt64(-0.9) == 0);
    assert(toInt32(2147483647.9).unwrap() == (int32)2147483647);
    assert(toInt32(-2147483648.9).unwrap() == (int32)-2147483648);
    assert(format("{}", toInt64(-9223372036854775808.0)) == "-9223372036854775808");
    assert(format("{}", toInt64(9223372036854774784.0)) == "9223372036854774784");
    assert(toInt32(2147483648.0).isNone());
    assert(toInt32(-2147483649.0).isNone());
    assert(toInt32((float32)2147483648.0).isNone());
    assert(toInt32((float32)-2147483904.0).isNone());
    Option<int32> matched = toInt32(-3.9);
    match (matched) {
        Option<int32>::Value(value) => { assert(value == (int32)-3); }
        Option<int32>::None => { assert(false); }
    }
    println("float to integer OK");
    return 0;
}
