/* generics.mgl —— 泛型结构体、泛型函数、接口约束与 显式 Any 类型参数。 */

interface Valued {
    int64 value();
};

struct Number : Valued, Add<Number, Number> {
    int64 n;
    int64 value() { return n; }
    Number leftAdd(Number right) {
        Number result;
        result.n = n + right.n;
        return result;
    }
};

struct Triple<T: Valued, K, V> {
    T first;
    K second;
    V third;
};

struct Duo<T, U> {
    T first;
    U second;
};

int64 read_value<T: Valued>(T item) {
    return item.value();
}

T identity<T>(T value) {
    return value;
}

T add<T>(T left, T right) {
    return left + right;
}

int64 main() {
    Number number;
    number.n = 42;

    Triple<Number, int64, String> row;
    row.first = number;
    row.second = 7;
    row.third = "answer";

    Number copied = identity<Number>(row.first);
    Number summed = add<Number>(copied, number);
    int64 fn(int64) specialized = identity<int64>;
    auto specialized_auto = identity<int64>;
    Triple<Number, int64, String> defaults;
    defaults.first = copied;
    defaults.second = 24;
    defaults.third = "defaults";
    Duo<Triple<Number, int64, String>, Number> nested;
    nested.first = row;
    nested.second = summed;

    println("{} {} {} {}", row.third, row.second,
    read_value<Number>(nested.second), defaults.second);
    println("specialized {} {}", specialized(6), specialized_auto(7));
    return 0;
}
