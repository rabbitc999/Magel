import std::text;
int64 main(){
    assert(Text::kmpFind("hello chali","chali")==6);
    assert(Text::kmpFind("hello","hello")==0);
    assert(Text::kmpFind("hello","x")==0-1);
    assert(Text::kmpFind("abc","")==0);
    assert(Text::kmpFind("","a")==0-1);
    assert(Text::kmpFind("banana","ana")==1);
    List<int64> hits=Text::kmpFindAll("aabaabaab","aab");
    assert(hits.len()==3 && hits[0]==0 && hits[1]==3 && hits[2]==6);
    List<int64> overlap=Text::kmpFindAll("aaaa","aa");
    assert(overlap.len()==3 && overlap[0]==0 && overlap[1]==1 && overlap[2]==2);
    assert(Text::kmpFindAll("abc","xyz").len()==0);
    List<int64> table=Text::kmpFailureTable("ababca");
    assert(table.len()==6 && table[0]==0 && table[1]==0 && table[2]==1);
    assert(table[3]==2 && table[4]==0 && table[5]==1);
    assert(Text::kmpFailureTable("").len()==0);
    List<int64> selfOverlap=Text::kmpFindAll("abababab","abab");
    assert(selfOverlap.len()==3);
    println("kmp hits {} {} table {}", hits.len(), overlap.len(), table[3]);
    println("KMP search OK");
    return 0;
}
