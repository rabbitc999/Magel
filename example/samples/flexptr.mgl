/* 两种"堆上的东西"：
 *
 *   `T a[] = new[N]`  **运行时长度数组**：自带元素个数（N 可以是变量），下标会查越界；
 *   `T mut& p = new`  **可写引用**：单个对象 / 从数组元素取来的地址，能写、能做引用算术。
 *
 *   * `delete` 必须按同样的形态还：数组 `delete a;`、裸引用 `delete p;`；
 *   * delete 之后再访问会被虚拟机拦住（见 samples-error/use_after_free.mgl）。 */

struct Box {
    int64 width;
    int64 height;
};

/* 堆上的单个对象当实参传（传的是地址，函数里改的就是同一个对象） */
int64 area(Box mut& rect) {
    return rect->width * rect->height;
}

int64 main() {
    /* ---- 运行时数组 + 引用算术 ---- */
    int64 n = 4;
    int64 a[] = new[n];
    int64 i = 0;
    while (i < len(a)) {
        a[i] = i * 10;
        i = i + 1;
    }
    int64 mut& p = &a[0];        /* 从数组元素取地址：得到可写引用（取地址时查过越界） */
    p[1] = 99;             /* 引用算术 + 解引用赋值 */
    p[3] = p[0] + p[1];
    println("a = {} {} {} {}（len={}）", a[0], a[1], a[2], a[3], len(a));

    /* ---- new 一个结构体：字段读写 ---- */
    Box mut& rect = heap Box;
    rect->width = 3;
    rect->height = 4;
    println("box = {} x {}, area = {}", rect->width, rect->height, area(rect));

    /* ---- 结构体的运行时数组：`row[k].字段` ---- */
    int64 rows = 3;
    Box row[] = new[rows];
    int64 k = 0;
    while (k < len(row)) {
        row[k].width = k + 1;
        row[k].height = 10;
        k = k + 1;
    }
    println("row: {} {} {}，row[1].height = {}", row[0].width, row[1].width, row[2].width,
    row[1].height);

    /* ---- uint64：无符号计数 / 大小 ---- */
    uint64 bytes = 4;
    println("bytes = {}", bytes);

    /* ---- 用完自己还回去（数组和裸引用各还各的） ---- */
    delete row;
    delete rect;
    delete a;
    return 0;
}
