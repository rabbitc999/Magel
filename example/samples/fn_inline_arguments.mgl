((int64 fn(int64), int64 fn(int64), int64, int64) fn(int64, int64)) simple(int64 fn(int64) a, int64 fn(int64) b) {
    return (int64 fn(int64), int64 fn(int64), int64, int64) fn copy(int64 x, int64 y) { (a, b, a(x), b(y)) };
}

int64 main() {
    ((int64 fn(int64), int64 fn(int64), int64, int64) fn(int64, int64)) fn(int64 fn(int64), int64 fn(int64)) ff = simple;
    auto tt = ff(int64 fn(int64 x) { x + 1 }, int64 fn(int64 x) { x + 2 });
    auto tuple = tt(1, 3);
    int64 x = tuple.2;
    int64 y = tuple.3;
    println("{} {}", x, y);
    return 0;
}
