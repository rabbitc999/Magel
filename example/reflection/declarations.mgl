@annotation Note(text:String="default")
@Reflect @Note("interface")
interface Value { @Note("contract") int64 read(); @Note("default") int64 fallback(){return 7;} };
@Reflect @Note("struct")
struct Service : Value {
    @Note("field") int64 value;
    @Note("owned") String label;
    @Note("static") static int64 shared;
    @Note("ctor") Service(int64 value){self.value=value;}
    @Note("read") int64 read(){return self.value;}
    int64 update(int64 value){self.value=value;return value;}
    static int64 answer(){return 42;}
};
@Reflect enum State { Ready, Busy(int64 value); int64 code(){return 7;} static int64 answer(){return 7;} };
struct Hidden { int64 x; };
@Reflect @Note int64 plus(int64 value){return value+1;}
int64 main(){Service s=new Service(41);println("{}",plus(s.read()));return 0;}
