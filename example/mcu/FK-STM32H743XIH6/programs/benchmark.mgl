import board;

int64 integerLoop(int64 count, int64 seed) {
    int64 value = seed;
    {
        int64 i = 0;
        while (i < count) {

        value = (value * 1664525 + 1013904223) & 2147483647;
    
            i += 1;
        }
    }
    return value;
}

int64 main() {
    board::lcdClear(0);
    board::lcdText(8, 8, "Magel VM on STM32H743", 65535, 0);
    board::lcdText(8, 32, "Benchmark running...", 65504, 0);
    println("BENCH_BEGIN clock_hz={}", board::boardClockHz());
    int64 count = 10000;
    int64 expected = board::nativeIntegerLoop(count, 123);
    /* 预热执行路径；正式计时期间不刷新 LCD 或输出串口。 */
    assert(integerLoop(count, 123) == expected);
    {
        int64 round = 0;
        while (round < 5) {

        int64 t0 = board::boardCycles();
        int64 v = integerLoop(count, 123);
        int64 t1 = board::boardCycles();
        int64 n = board::nativeIntegerLoop(count, 123);
        int64 t2 = board::boardCycles();
        assert(v == n && v == expected);
        board::benchRecord(round, count, (t1-t0)&4294967295, (t2-t1)&4294967295, v);
        println("BENCH sample={} count={} vm_cycles={} native_cycles={} checksum={}",
        round, count, (t1-t0)&4294967295, (t2-t1)&4294967295, v);
    
            round += 1;
        }
    }
    board::lcdFill(0, 28, board::lcdWidth(), 24, 0);
    board::lcdText(8, 32, "OK: MODE/ENTER to exit", 2016, 0);
    println("BENCH_END");
    {
        int64 i = 0;
        while (i < 3000) {

        if (board::boardExitRequested()) {
            println("BENCH_EXIT key");
            return 0;
        }
        {
            int64 key = 2;
            while (key < 4) {

            if (board::keyClicked(key)) {
                board::lcdText(8, 64, f"Key {key} clicked     ", 65535, 0);
                println("KEY {} pressed={}", key, board::keyPressed(key));
            }
        
                key += 1;
            }
        }
        board::boardDelay(10);
    
            i += 1;
        }
    }
    return 0;
}
