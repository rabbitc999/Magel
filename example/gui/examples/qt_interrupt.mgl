/*
 * qt_interrupt.mgl —— Qt 事件回调 → Magel 中断处理函数。
 *
 *   QT_QPA_PLATFORM=offscreen ./qt_interrupt
 *
 * 三样东西串起来：
 *   1. `std::event::Timer`（周期 0，只接受外部 raise）绑定中断处理函数 `onGuiEvent`；
 *   2. `gui::bindEvents` 把它的句柄登记为 GUI / Qt 事件源；Qt 侧周期事件由
 *      `gui::startEventTimer(0)` 提供（0 = 每个事件循环回合都来一次）；
 *   3. `gui::pumpEvery(64)` 让 VM 每 64 条指令泵一次 Qt —— 长计算循环不再卡住窗口，
 *      排队的中断也会在指令边界交付。
 *
 * 事件值：按钮 ID / `postEvent` 的值 > 0 记为点击，-1 记为关窗，0 是 Qt 周期事件。
 */

module qt_interrupt;

import gui;
import std::event;

int64 clicks = 0;
int64 ticks = 0;
int64 closed = 0;
int64 busy = 0;

void onGuiEvent(int64 source) {
    if (source == -1) { closed = closed + 1; }
    if (source == 0) { ticks = ticks + 1; }
    if (source > 0) { clicks = clicks + 1; }
}

int64 main() {
    if (gui::open((int32)360, (int32)200, "Qt 事件回调") == 0) {
        panic("Qt 窗口创建失败");
    }
    gui::label((int32)10, (int32)20, (int32)20, (int32)320, (int32)26, "等待事件");

    Timer events = Timer::everyNanos(0);   /* 周期 0：不自动触发，只收 GUI 事件 */
    events.onInterrupt(onGuiEvent);
    if (gui::bindEvents(events.handle) == 0) {
        panic("GUI 事件登记失败");
    }
    gui::startEventTimer((int32)0);

    /* 长计算循环：每 64 条指令泵一次 Qt，周期事件在指令边界交付。 */
    gui::pumpEvery((int64)64);
    int64 i = 0;
    while (i < 20000) { busy = busy + 1; i = i + 1; }
    gui::pumpEvery((int64)0);

    /* 注入点击与关窗：走的是同一条「Qt/宿主事件 → 中断 → 处理函数」链。 */
    gui::postEvent((int32)1);
    gui::postEvent((int32)-1);
    while (busy < 21000) { busy = busy + 1; }

    gui::stopEventTimer();
    gui::unbindEvents();
    gui::close();
    println("clicks={} ticks={} closed={}",
    clicks > 0, ticks > 0, closed > 0);
    return 0;
}
