/* Magel 的简易 GUI 模块；实现由 WinAPI / Qt Widgets 共享库通过 C ABI 提供。
 * 所有尺寸与位置均是窗口客户区像素，控件 ID 在 1..65535 之间且不能重复。
 *
 * bindEvents 登记宿主事件标签，GUI 桥只向有界事件队列投递值。
 * 程序通过 std::event 显式接收并处理；队列满时 droppedEvents 记录未接收的投递。
 */
module gui;

import std::event;

/* ---- 窗口与控件 ---- */
int32 open(int32 width, int32 height, String title);
int32 label(int32 id, int32 x, int32 y, int32 width, int32 height, String text);
int32 button(int32 id, int32 x, int32 y, int32 width, int32 height, String text);
int32 textBox(int32 id, int32 x, int32 y, int32 width, int32 height, String text);
int32 setText(int32 id, String text);
String getText(int32 id);
int32 pollEvent();  /* 0 = 暂无事件，正数 = 被点击按钮的 ID，-1 = 窗口关闭。 */
int32 waitEvent();  /* 等一小段时间片；有事件返回事件，超时返回 0（返回程序显式处理事件）。 */
void close();

/* ---- 事件回调（WinAPI / Qt 后端） ---- */
/* 把一个 `std::event::int64` 登记为 GUI 事件标签；返回 1 表示成功。 */
int32 bindEvents(int64 tag);
/* 取消登记（窗口关闭 / 程序退出时用）。 */
int32 unbindEvents();
/* GUI 侧周期事件：每 intervalMillis 毫秒触发一次；事件 source 值是 0，
 * 0 表示「每个泵回合一次」，用单调时钟限速。 */
void startEventTimer(int32 intervalMillis);
void stopEventTimer();
/* 注入一个事件（测试 / 宿主脚本）：与真实事件一样派发回调并入队。 */
int32 postEvent(int32 event);
/* 处理一轮 GUI 事件（非阻塞）。 */
int32 pump();
/* 每 instructions 个执行边界（VM 指令）自动 pump 一次；长计算循环里保持 GUI 响应、
 * 程序之后显式接收排队事件。传 0 取消。 */
int32 pumpEvery(int64 instructions);

/* 返回本次登记后队列满或关闭导致的投递失败次数。 */
int64 droppedEvents();
