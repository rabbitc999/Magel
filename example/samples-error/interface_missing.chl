/* 继承了接口，但没有把要求的函数实现全（返回类型也要一样）。
 * 期望：编译期报出缺哪个函数、签名长什么样。 */

interface Shape {
    int64 area();
    String describe();
};

/* `area()` 写了，`describe()` 漏了 —— 而且 area 的返回类型也不对 */
struct Circle : Shape {
    int64 r;

    float64 area() { return 3.0 * (float64)r * (float64)r; }
};

int64 main() {
    Circle c;
    c.r = 1;
    return 0;
}
