/* 同一对操作数配了两个返回类型，而表达式没有目标类型（`auto`）—— 按规则报错，
 * 而不是悄悄挑一个。 */

struct Vec {
    int64 v;
};

struct A : Add<int64,int64>, Add<Vec,int64> {
    int64 v;

    int64 leftAdd(int64 other) { return self.v + other; }

    Vec leftAdd(int64 other) {
        Vec r;
        r.v = self.v + other;
        return r;
    }
};

int64 main() {
    A a;
    a.v = 5;
    auto z = a + 3;
    println("z = {}", z);
    return 0;
}
