/* 错误样例：变长形式的事件参数会按 std::lang::Any 装箱，装不了生命周期不属于自己的局部结构体。 */
import std::event;

struct Holder { int64 mut& slot; };

void onArguments(int64 event, std::lang::List<std::lang::Any> arguments) { }

int64 main() {
    int64 value = 3;
    Holder holder;
    holder.slot = &value;
    Timer events = Timer::everyNanos(0);
    std::event::bindEventArguments(events.handle, onArguments, holder);
    return 0;
}
