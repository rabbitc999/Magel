import std::net;
import std::sql;
import std::json;
import std::text;
import std::io;

/** @brief 学生记录；HTTP 输入不允许指定数据库主键。 */
struct Student { int64 id; String studentNo; String name; String email; int64 age; };
/** @brief 一次 HTTP 请求；status 非零表示解析失败。 */
struct Request { String method; String path; String body; String contentType; int64 status; };
/** @brief HTTP 响应的状态、内容类型与正文。 */
struct Response { int64 status; String contentType; String body; };

/** @brief 有界十进制解析，不接受符号、空白或隐式数值转换。
 * @param text 输入字节串。 @param maximum 允许的最大值。 @return 合法整数或 None。 */
Option<int64> decimal(String text, int64 maximum) {
    if (text=="") { return Option<int64>::None; }
    int64 value=0;
    for(int64 i=0;i<len(text);i=i+1){
        if(text[i]<'0' || text[i]>'9'){return Option<int64>::None;}
        int64 digit=(int64)text[i]-(int64)'0';
        if(value>(maximum-digit)/10){return Option<int64>::None;}
        value=value*10+digit;
    }
    return Option<int64>::Value(value);
}

/** @brief 输出 JSON 字符串字面量，转义引号、反斜杠及控制字节。
 * @param text UTF-8 文本。 @return 带双引号的 JSON 字符串。 */
String jsonString(String text){
    String out="\"";
    String hex="0123456789abcdef";
    int64 i=0;
    while(i<len(text)){
        int64 byte=(int64)(uint8)text[i];
        int64 width=1;
        if(byte>=240){width=4;}else {if(byte>=224){width=3;}else {if(byte>=192){width=2;}}}
        if(text[i]=='"'){out=out+"\\\"";}
        else {
            if(text[i]=='\\'){out=out+"\\\\";}
            else {
                if(byte<32){
                    int64 high=byte/16, low=byte%16;
                    out=out+"\\u00"+hex[high:high+1]+hex[low:low+1];
                } else {out=out+text[i:i+width];}
            }
        }
        i=i+width;
    }
    return out+"\"";
}

/** @brief 生成 JSON 响应。 @param status HTTP 状态。 @param body JSON 正文。 @return 响应值。 */
Response jsonResponse(int64 status,String body){
    Response response;response.status=status;response.contentType="application/json; charset=utf-8";
    response.body=body;return response;
}
/** @brief 生成统一错误响应。 @param status HTTP 状态。 @param message 公开说明。 @return 响应值。 */
Response errorResponse(int64 status,String message){return jsonResponse(status,"{\"error\":"+jsonString(message)+"}");}

/** @brief 读取一个 Content-Length 请求；每条连接只处理一次。
 * @param socket 可写连接引用。 @param authority 本地监听地址。 @return 请求及解析状态。 */
Request readRequest(TcpSocket mut& socket,String authority){
    Request request;
    String raw="";
    int64 split=-1;
    while(split<0){
        String chunk=socket.receive((int32)4096);
        if(chunk==""){request.status=400;return request;}
        raw=raw+chunk;split=Text::find(raw,"\r\n\r\n");
        if((split<0 && len(raw)>8192) || split>8192){request.status=431;return request;}
    }
    if(split==0){request.status=400;return request;}
    List<String> lines=Text::split(raw[0:split],"\r\n");
    List<String> start=Text::split(lines[0]," ");
    if(start.len()!=3){request.status=400;return request;}
    if((start[2]!="HTTP/1.1" && start[2]!="HTTP/1.0") || !Text::startsWith(start[1],"/")){
        request.status=400;return request;
    }
    request.method=start[0];request.path=start[1];
    int64 length=0;
    bool hasLength=false, hasHost=false;
    for(int64 i=1;i<lines.len();i=i+1){
        String line=lines[i];int64 colon=Text::find(line,":");
        if(colon<=0){request.status=400;return request;}
        String key=Text::toLower(line[0:colon]);
        String value=Text::trim(line[colon+1:]);
        if(key=="content-length"){
            if(hasLength){request.status=400;return request;}
            auto parsed=decimal(value,16384);
            if(parsed.isNone()){request.status=413;return request;}
            length=parsed.unwrap();hasLength=true;
        }
        if(key=="host"){
            if(hasHost || value!=authority){request.status=400;return request;}
            hasHost=true;
        }
        if(key=="origin" && value!="http://"+authority){request.status=403;return request;}
        if(key=="transfer-encoding"){request.status=501;return request;}
        if(key=="expect"){request.status=417;return request;}
        if(key=="content-type"){request.contentType=Text::toLower(value);}
    }
    if(start[2]=="HTTP/1.1" && !hasHost){request.status=400;return request;}
    if((request.method=="POST" || request.method=="PUT") && !hasLength){request.status=411;return request;}
    request.body=raw[split+4:];
    while(len(request.body)<length){
        String chunk=socket.receive((int32)4096);
        if(chunk==""){request.status=400;return request;}
        request.body=request.body+chunk;
    }
    request.body=request.body[0:length];
    return request;
}

/** @brief 校验 JSON 对象的四个学生字段，不接管文档生命周期。
 * @param root JSON 根节点引用。 @return 学生值或公开错误。 */
Result<Student,String> validateStudent(JsonValue const& root){
    if(!root.isObject() || root.len()!=4){return Result<Student,String>::Err("需要 studentNo、name、email、age 四个字段");}
    auto number=root.find("studentNo");auto name=root.find("name");
    auto email=root.find("email");auto age=root.find("age");
    if(number.isNone() || name.isNone() || email.isNone() || age.isNone()){
        return Result<Student,String>::Err("缺少学生字段");
    }
    auto numberText=number.unwrap().asString();auto nameText=name.unwrap().asString();
    auto emailText=email.unwrap().asString();auto ageValue=age.unwrap().asInt();
    if(numberText.isNone() || nameText.isNone() || emailText.isNone() || ageValue.isNone()){
        return Result<Student,String>::Err("文本字段必须为字符串，age 必须为整数；不接受零字节");
    }
    Student student;student.studentNo=Text::trim(numberText.unwrap());
    student.name=Text::trim(nameText.unwrap());student.email=Text::trim(emailText.unwrap());student.age=ageValue.unwrap();
    if(len(student.studentNo)<1 || len(student.studentNo)>32 || len(student.name)<1 || len(student.name)>120 ||
    len(student.email)<3 || len(student.email)>160 || !Text::contains(student.email,"@") || student.age<0 || student.age>150){
        return Result<Student,String>::Err("学号或姓名长度、邮箱、年龄不合法");
    }
    return Result<Student,String>::Ok(student);
}

/** @brief 解析学生 JSON，并在所有正常返回路径关闭文档。
 * @param body 请求正文。 @return 学生值或校验错误。 */
Result<Student,String> parseStudent(String body){
    auto parsed=std::json::parse(body);
    if(parsed.isErr()){return Result<Student,String>::Err("无效 JSON");}
    JsonValue root=parsed.unwrap();
    auto result=validateStudent(&root);root.close();return result;
}

/** @brief 序列化查询结果的一行。 @param rows SQL 结果引用。 @param index 行下标。 @return JSON 对象。 */
String rowJson(ResultSet const& rows,int64 index){
    return "{\"id\":"+format("{}",rows.intAt(index,0))+",\"studentNo\":"+jsonString(rows.textAt(index,1))+
    ",\"name\":"+jsonString(rows.textAt(index,2))+",\"email\":"+jsonString(rows.textAt(index,3))+
    ",\"age\":"+format("{}",rows.intAt(index,4))+"}";
}

/** @brief 查询一个学生。 @param db 数据库引用。 @param id 正整数主键。 @return JSON 或错误响应。 */
Response getStudent(Database mut& db,int64 id){
    ResultSet rows=db.exec("SELECT id,student_no,name,email,age FROM students WHERE id="+format("{}",id));
    if(!rows.ok){return errorResponse(500,"数据库查询失败");}
    if(rows.rowCount()==0){return errorResponse(404,"学生不存在");}
    return jsonResponse(200,rowJson(&rows,0));
}

/** @brief 分派静态页面、健康检查与学生增删改查。
 * @param db 数据库可写引用。 @param request 请求引用。 @param page 启动时读取的 HTML。 @return HTTP 响应。 */
Response route(Database mut& db,Request const& request,String page){
    if(request.status!=0){return errorResponse(request.status,"HTTP 请求格式或长度不受支持");}
    if(request.path=="/" && request.method=="GET"){
        Response response;response.status=200;response.contentType="text/html; charset=utf-8";response.body=page;return response;
    }
    if(request.path=="/api/health" && request.method=="GET"){
        ResultSet health=db.exec("SELECT 1");
        if(!health.ok){return errorResponse(503,"数据库不可用");}
        return jsonResponse(200,"{\"status\":\"ok\",\"database\":\"sqlite\"}");
    }
    bool collection=request.path=="/api/students";
    int64 id=0;
    if(!collection){
        if(!Text::startsWith(request.path,"/api/students/")){return errorResponse(404,"接口不存在");}
        auto parsed=decimal(request.path[14:],2147483647);
        if(parsed.isNone() || parsed.unwrap()==0){return errorResponse(400,"学生 id 必须为正整数");}
        id=parsed.unwrap();
    }
    if(request.method=="GET"){
        if(!collection){return getStudent(db,id);}
        ResultSet rows=db.exec("SELECT id,student_no,name,email,age FROM students ORDER BY id LIMIT 200");
        if(!rows.ok){return errorResponse(500,"数据库查询失败");}
        String items="[";
        for(int64 i=0;i<rows.rowCount();i=i+1){if(i>0){items=items+",";}items=items+rowJson(&rows,i);}
        return jsonResponse(200,items+"]");
    }
    if(request.method=="DELETE" && !collection){
        ResultSet deleted=db.exec("DELETE FROM students WHERE id="+format("{}",id));
        if(!deleted.ok){return errorResponse(500,"数据库删除失败");}
        if(deleted.affected==0){return errorResponse(404,"学生不存在");}
        return jsonResponse(200,"{\"deleted\":true}");
    }
    if(!((request.method=="POST" && collection) || (request.method=="PUT" && !collection))){
        return errorResponse(405,"该接口不支持此方法");
    }
    List<String> media=Text::split(request.contentType,";");
    if(media.len()==0 || Text::trim(media[0])!="application/json"){return errorResponse(415,"需要 application/json");}
    auto parsed=parseStudent(request.body);
    if(parsed.isErr()){return errorResponse(400,parsed.error());}
    Student student=parsed.unwrap();
    if(!collection){
        Response existing=getStudent(db,id);if(existing.status!=200){return existing;}
    }
    ResultSet duplicates=db.exec("SELECT id FROM students WHERE student_no="+db.quote(student.studentNo)+
    " AND id<>"+format("{}",id));
    if(!duplicates.ok){return errorResponse(500,"数据库查询失败");}
    if(duplicates.rowCount()>0){return errorResponse(409,"学号已存在");}
    String fields="student_no="+db.quote(student.studentNo)+",name="+db.quote(student.name)+
    ",email="+db.quote(student.email)+",age="+format("{}",student.age);
    String sql="UPDATE students SET "+fields+" WHERE id="+format("{}",id);
    if(collection){
        sql="INSERT INTO students(student_no,name,email,age) VALUES("+db.quote(student.studentNo)+","+
        db.quote(student.name)+","+db.quote(student.email)+","+format("{}",student.age)+")";
    }
    ResultSet saved=db.exec(sql);
    if(!saved.ok){return errorResponse(500,"数据库保存失败");}
    if(collection){
        ResultSet inserted=db.exec("SELECT last_insert_rowid()");
        if(!inserted.ok){return errorResponse(500,"数据库查询失败");}
        id=inserted.intAt(0,0);
    }
    Response response=getStudent(db,id);if(collection && response.status==200){response.status=201;}return response;
}

/** @brief 状态码的 HTTP 原因短语。 @param status 状态码。 @return ASCII 短语。 */
String reason(int64 status){
    if(status==200){return "OK";}if(status==201){return "Created";}
    if(status==400){return "Bad Request";}if(status==403){return "Forbidden";}if(status==404){return "Not Found";}
    if(status==405){return "Method Not Allowed";}if(status==409){return "Conflict";}if(status==411){return "Length Required";}
    if(status==413){return "Content Too Large";}if(status==415){return "Unsupported Media Type";}
    if(status==417){return "Expectation Failed";}if(status==431){return "Request Header Fields Too Large";}
    if(status==501){return "Not Implemented";}if(status==503){return "Service Unavailable";}return "Internal Server Error";
}

/** @brief 发送 UTF-8 响应；Content-Length 按字节计数。
 * @param socket 连接引用。 @param response 响应引用。 @return 是否完整发送。 */
bool sendResponse(TcpSocket mut& socket,Response const& response){
    String text="HTTP/1.1 "+format("{}",response.status)+" "+reason(response.status)+"\r\nContent-Type: "+
    response.contentType+"\r\nContent-Length: "+format("{}",len(response.body))+
    "\r\nConnection: close\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n"+response.body;
    return socket.send(text)==len(text);
}

/** @brief 启动本地学生管理服务。
 * @param args 数据库、端口、请求上限、页面路径、可选就绪文件。 @return 正常退出 0，启动失败 1。 */
int64 main(List<String> args){
    String path="students.db",htmlPath="magel/example/web-students/index.html",readyPath="";
    int64 port=8080,maximum=0;
    if(args.len()>5){println("参数过多");return 1;}
    if(args.len()>0){path=args[0];}
    if(args.len()>1){auto value=decimal(args[1],65535);if(value.isNone()){println("无效端口");return 1;}port=value.unwrap();}
    if(args.len()>2){auto value=decimal(args[2],1000000);if(value.isNone()){println("无效请求上限");return 1;}maximum=value.unwrap();}
    if(args.len()>3){htmlPath=args[3];}if(args.len()>4){readyPath=args[4];}
    auto opened=FileStream::open(htmlPath,"rb");
    if(opened.isErr()){println("无法读取页面：{}",htmlPath);return 1;}
    FileStream file=opened.unwrap();String page="";
    while(fileEof(file.handle)==0){
        auto line=file.read();
        if(line.isErr()){file.close();println("读取页面失败");return 1;}
        String text=line.unwrap();
        if(fileEof(file.handle)!=0 && text==""){break;}
        page=page+text+"\n";
    }
    file.close();
    Database db=Database::sqlite(path);
    if(!db.isOpen()){println("数据库连接失败：{}",db.lastError());return 1;}
    if(!db.execOk("CREATE TABLE IF NOT EXISTS students(id INTEGER PRIMARY KEY AUTOINCREMENT,student_no TEXT NOT NULL UNIQUE,name TEXT NOT NULL,email TEXT NOT NULL,age INTEGER NOT NULL CHECK(age BETWEEN 0 AND 150))")){
        println("建表失败：{}",db.lastError());db.close();return 1;
    }
    TcpListener listener=TcpListener::listen("127.0.0.1",(int32)port,(int32)16);
    if(!listener.isOpen()){println("监听失败：{}",listener.lastError());db.close();return 1;}
    String authority="127.0.0.1:"+format("{}",listener.localPort());
    if(readyPath!=""){
        auto ready=FileStream::open(readyPath,"wb");
        if(ready.isErr()){listener.close();db.close();println("无法写入就绪文件");return 1;}
        FileStream marker=ready.unwrap();auto written=marker.write(format("{}",listener.localPort()));marker.close();
        if(written.isErr()){listener.close();db.close();println("写入就绪文件失败");return 1;}
    }
    println("学生信息管理：http://{}",authority);
    int64 handled=0;
    while(maximum==0 || handled<maximum){
        TcpSocket socket=listener.accept((int32)1000);
        if(!socket.isOpen()){continue;}
        Request request=readRequest(&socket,authority);
        Response response=route(&db,&request,page);
        bool sent=sendResponse(&socket,&response);
        socket.close();handled=handled+1;
    }
    listener.close();db.close();println("服务器正常关闭：{} 个请求",handled);return 0;
}
