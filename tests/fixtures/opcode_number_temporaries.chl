BigInteger fib(int64 n)
{
    if (n <= 1)
    {
        return BigInteger(n);
    }
    return fib(n - 1) + fib(n - 2);
}

BigDecimal decimalValue()
{
    return BigDecimal(9) + BigDecimal(2);
}

struct Strings
{
    String first;
    String second;
};

struct Numbers
{
    BigInteger first;
    BigInteger second;
    BigDecimal decimal;
};

void main()
{
    String empty = String::new();
    assert(len(empty) == 0);
    assert(empty.length() == 0);
    assert(String::new().length() == 0);
    String const& emptyReference = &empty;
    assert(emptyReference.length() == 0);
    fib(10);
    decimalValue();
    String::new();
    Strings originalText;
    originalText.first = "hello";
    originalText.second = "world";
    Strings copiedText = originalText;
    copiedText.first[0] = 'H';
    assert(originalText.first == "hello");
    assert(originalText.first.length() == 5);
    assert(copiedText.first == "Hello");
    assert(copiedText.second == "world");
    Numbers originalNumbers;
    originalNumbers.first = BigInteger(5);
    originalNumbers.second = BigInteger(8);
    originalNumbers.decimal = BigDecimal(2);
    Numbers copiedNumbers = originalNumbers;
    copiedNumbers.first = copiedNumbers.first + BigInteger(1);
    assert(format("{} {} {}", originalNumbers.first, copiedNumbers.first, copiedNumbers.second) == "5 6 8");
    println("{}", fib(10));
    println("{}", decimalValue());
    {
        int64 i = 0;
        while (i < 20) {

        String text = format("{} {}", fib(10), decimalValue());
        assert(text == "55 11");
    
            i += 1;
        }
    }
    BigInteger original = fib(10);
    BigInteger copied = original;
    copied = copied + BigInteger(1);
    assert(format("{} {}", original, copied) == "55 56");

}
