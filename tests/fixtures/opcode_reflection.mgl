import std::reflect;
opcode Secret {new=__std_bint_from_int;drop=__std_bint_drop;copy=__std_bint_copy;};
@Reflect
struct Holder { Secret hidden; int64 visible; };
@Reflect
Secret makeSecret() { return Secret::new(7); }
int64 main() {
    auto info = std::reflect::getStructInfo<Holder>().unwrap();
    assert(info.fields.len() == 2);
    assert(info.fields[0].name == "hidden");
    assert(info.fields[1].name == "visible");
    assert(std::reflect::getFuncInfo("makeSecret").isValue());
    println("opcode reflection hidden");
    return 0;
}
