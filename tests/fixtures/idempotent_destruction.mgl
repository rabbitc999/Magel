int64 drops=0;
struct Item:Drop {
    int64 value;
    String text;
    void drop(){drops+=1;}
};
struct Pair {Item left;Item right;};
int64 indices=0;
int64 index(){indices+=1;return 0;}
int64 main(){
    {
        Item value;value.text="owned";
        Item mut& alias=&value;
        std::lang::Any boxed;boxed.set(&alias);
        Drop mut& protocol=boxed.getReference();
        protocol.drop();protocol.drop();value.drop();value.drop();alias.drop();
        std::lang::assert(drops==1);
    }
    std::lang::assert(drops==1);
    {
        Pair pair;pair.left.drop();pair.left.drop();pair.right.drop();
        std::lang::assert(drops==3);
    }
    std::lang::assert(drops==3);
    Item mut& first = heap Item;first.text="heap";
    Item mut& stale=first;
    delete first;delete first;delete stale;first.drop();stale.drop();
    std::lang::assert(drops==4);
    Item mut& second = heap Item;second.value=22;second.text="fresh";
    delete stale;delete first;
    std::lang::assert(second.value==22 && second.text=="fresh" && drops==4);
    second.drop();second.drop();delete second;delete second;second.drop();
    std::lang::assert(drops==5);
    Item nodes[]=new[2];nodes[0].text="zero";nodes[1].text="one";
    nodes[index()].drop();nodes[index()].drop();
    std::lang::assert(indices==2 && drops==6);
    delete nodes;delete nodes;
    std::lang::assert(drops==7);
    int64 data[]=new[2];data[0]=7;
    delete data;delete data;
    int64 mut& number = heap int64;delete number;
    int64 mut& fresh = heap int64;*fresh=99;
    delete number;std::lang::assert(*fresh==99);delete fresh;delete fresh;
    List<int64> list;list.push(1);delete list;delete list;
    std::lang::println("idempotent destruction ok {}",drops);
    return 0;
}
