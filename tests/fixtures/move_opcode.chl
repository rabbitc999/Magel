#NonCopyable
opcode Unique {
    new = __std_bint_from_int;
    drop = __std_bint_drop;
};

Unique relay(Unique value) {
    return move value;
}

void consume(Unique value) {}

void main() {
    Unique original = Unique::new(7);
    int64 before;
    memcpy(&before, &original, 8);
    Unique target = move original;
    Unique returned = relay(move target);
    int64 after;
    memcpy(&after, &returned, 8);
    assert(before == after);
    consume(move returned);
    Unique captured = Unique::new(9);
    let release = void fn move[captured]() {
        consume(move captured);
    };
    release();
    println("opcode move ok");

}
