bool __isNaN64(float64 value);
/** 判断数值是否为 isNaN 对应的特殊浮点值。 */
bool isNaN<T>(T value) { return __mathIsNaN(value); }
inline bool __mathIsNaN(int8 value) { return false; }
inline bool __mathIsNaN(uint8 value) { return false; }
inline bool __mathIsNaN(int16 value) { return false; }
inline bool __mathIsNaN(uint16 value) { return false; }
inline bool __mathIsNaN(int32 value) { return false; }
inline bool __mathIsNaN(uint32 value) { return false; }
inline bool __mathIsNaN(int64 value) { return false; }
inline bool __mathIsNaN(uint64 value) { return false; }
inline bool __mathIsNaN(float32 value) { return __isNaN64((float64)value); }
inline bool __mathIsNaN(float64 value) { return __isNaN64((float64)value); }
inline bool __mathIsNaN(BigInteger value) { return false; }
inline bool __mathIsNaN(BigDecimal value) { return false; }
