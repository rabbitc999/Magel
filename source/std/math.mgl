/** 判断数值是否为 isInf 对应的特殊浮点值。 */
bool isInf<T>(T value) { return __mathIsInf(value); }
inline bool __mathIsInf(int8 value) { return false; }
inline bool __mathIsInf(uint8 value) { return false; }
inline bool __mathIsInf(int16 value) { return false; }
inline bool __mathIsInf(uint16 value) { return false; }
