module std::math;
import std::cas;

BigDecimal __std_bfloat_math(BigDecimal value, int64 operation, BigDecimal other);
BigDecimal __std_bfloat_pi(int64 digits);
/** 按指定有效十进制位数计算圆周率。 */
BigDecimal pi(int64 digits = 50) { return __std_bfloat_pi(digits); }
float64 __sin64(float64 value);
/** 对普通数值、大十进制或符号表达式计算 sin。 */
let sin<T>(T value) { return __mathSin(value); }
inline float64 __mathSin(int8 value) { return (float64)__sin64((float64)value); }
inline float64 __mathSin(uint8 value) { return (float64)__sin64((float64)value); }
inline float64 __mathSin(int16 value) { return (float64)__sin64((float64)value); }
inline float64 __mathSin(uint16 value) { return (float64)__sin64((float64)value); }
inline float64 __mathSin(int32 value) { return (float64)__sin64((float64)value); }
inline float64 __mathSin(uint32 value) { return (float64)__sin64((float64)value); }
inline float64 __mathSin(int64 value) { return (float64)__sin64((float64)value); }
inline float64 __mathSin(uint64 value) { return (float64)__sin64((float64)value); }
inline float32 __mathSin(float32 value) { return (float32)__sin64((float64)value); }
inline float64 __mathSin(float64 value) { return (float64)__sin64((float64)value); }
inline BigDecimal __mathSin(BigInteger value) { return __std_bfloat_math(BigDecimal(value), 0, BigDecimal(value)); }
inline BigDecimal __mathSin(BigDecimal value) { return __std_bfloat_math(value, 0, value); }
inline Expr __mathSin(Expr value) { return value.sin(); }
