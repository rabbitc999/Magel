inline bool __mathIsInf(float64 value) { return __isInf64((float64)value); }
inline bool __mathIsInf(BigInteger value) { return false; }
inline bool __mathIsInf(BigDecimal value) { return false; }
/** 返回 `value` 的绝对值；整数最小值取负回绕后仍是自身，NaN 与负数零原样返回。 */
T abs<T>(T value)
{
    if (value < 0) { return (T)0 - value; }
    return value;
}

/** 任意数量实参中的最小值；单个实参给自身，相等时给后一个（与逐对比较的顺序一致）。 */
T min<T>(T... values)
{
    T best = values[0];
    int64 index = 1;
    while (index < values.len()) {
        if (!(best < values[index])) { best = values[index]; }
        index = index + 1;
    }
    return best;
}

/** 任意数量实参中的最大值；单个实参给自身，相等时给后一个（与逐对比较的顺序一致）。 */
T max<T>(T... values)
{
    T best = values[0];
    int64 index = 1;
    while (index < values.len()) {
        if (!(best > values[index])) { best = values[index]; }
        index = index + 1;
    }
    return best;
}

/** 把 `value` 夹进 `[low, high]`；`low > high` 直接停机（多半是写反了）。 */
int64 clamp(int64 value, int64 low, int64 high)
{
    if (!(low <= high)) {
        std::lang::panic("std::math::clamp 的 low 不能大于 high");
        return value;
    }
    if (value < low) { return low; }
    if (value > high) { return high; }
    return value;
}

/** 把 `value` 夹进 `[low, high]`；`low > high` 直接停机（多半是写反了）。 */
float64 clamp(float64 value, float64 low, float64 high)
{
    if (!(low <= high)) {
        std::lang::panic("std::math::clamp 的 low 不能大于 high");
        return value;
    }
    if (value < low) { return low; }
    if (value > high) { return high; }
    return value;
}
