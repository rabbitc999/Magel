module std::net;

/*
 * std::net —— ChaLi 语言连接**外部网络**的标准库模块（TCP + 极简 HTTP 客户端）。
 *
 * 套接字在宿主胶水（glue/std_net.hpp）里，ChaLi 一侧通过独占 opcode 管理连接：
 * Windows 运行期加载 ws2_32.dll，POSIX 平台直接调用同名接口，两边都不用改链接参数。
 *
 * 用法：
 *   import std::net;
 *
 *   // TCP 客户端
 *   std::net::TcpSocket socket = std::net::TcpSocket::connect("127.0.0.1", 8000);
 *   socket.send("ping\n");
 *   String line = socket.receiveLine(3000);
 *   socket.close();
 *
 *   // 监听 + 接受
 *   std::net::TcpListener listener = std::net::TcpListener::listen("127.0.0.1", 0);
 *   std::net::TcpSocket peer = listener.accept();
 *
 *   // HTTP 客户端（只支持 http://，不带 TLS）
 *   std::net::HttpResponse response = std::net::HttpClient::fetch("http://127.0.0.1:8080/");
 *
 * 读数据的约定：`receive` / `receiveLine` 返回空串时用 `status()` 区分原因——
 * `NET_CLOSED` 对端关闭、`NET_TIMEOUT` 超时、`NET_ERROR` 出错（细节看 `lastError()`）。
 */

import std::text;
import std::parse;

/* 套接字通过 opcode 持有宿主资源，作用域退出时自动关闭。 */
int64 __std_netNew();
void __std_netDrop(int64 handle);
TcpSocket __std_netConnect(String host, int32 port, int32 timeoutMs);
TcpListener __std_netListen(String host, int32 port, int32 backlog);
TcpSocket __std_netAccept(TcpListener mut& listener, int32 timeoutMs);
bool __std_netIsOpen(int64 handle);
String __std_netError(int64 handle);
int64 __std_netStatus(int64 handle);
int64 __std_netSend(TcpSocket mut& socket, String data);
String __std_netReceive(TcpSocket mut& socket, int32 maxBytes);
String __std_netReceiveLine(TcpSocket mut& socket, int32 timeoutMs);
void __std_netCloseSocket(TcpSocket mut& socket);
void __std_netCloseListener(TcpListener mut& listener);
int64 __std_netLocalPort(int64 handle);

TcpSocket __std_netConnectAsync(String host, int32 port, int32 timeoutMs);
int64 __std_netPollConnect(TcpSocket mut& socket);
TcpSocket __std_netAcceptAsync(TcpListener mut& listener);
int64 __std_netSendAsync(TcpSocket mut& socket, String data, int64 offset);
String __std_netReceiveAsync(TcpSocket mut& socket, int32 maxBytes);
String __std_netReceiveLineAsync(TcpSocket mut& socket);

const int64 NET_OK = 0;
const int64 NET_CLOSED = 1;
const int64 NET_TIMEOUT = 2;
const int64 NET_ERROR = 3;
/** @brief 非阻塞操作尚未就绪，调用方可用 std::thread::sleepFor 有界暂停后继续轮询。 */
const int64 NET_PENDING = 4;

/** @brief 独占 TCP 连接；复制被拒绝，显式 move 转移所有权。 */
#NonCopyable
opcode TcpSocket {
    new = std::net::__std_netNew;
    drop = std::net::__std_netDrop;
    static TcpSocket connect(String host, int32 port, int32 timeoutMs) {
        return __std_netConnect(host, port, timeoutMs);
    }
    static TcpSocket connect(String host, int32 port) {
        return TcpSocket::connect(host, port, (int32)5000);
    }
    /** @brief 发起数值 IPv4 的非阻塞连接；通过 pollConnect 推进，NET_PENDING 表示进行中。 */
    static TcpSocket connectAsync(String host, int32 port, int32 timeoutMs) {
        return __std_netConnectAsync(host, port, timeoutMs);
    }
    /** @brief 发起默认五秒超时的非阻塞数值 IPv4 连接。 */
    static TcpSocket connectAsync(String host, int32 port) {
        return TcpSocket::connectAsync(host, port, (int32)5000);
    }
    /** @brief 立即检查连接结果，返回 NET_PENDING、NET_OK、NET_TIMEOUT 或 NET_ERROR。 */
    int64 pollConnect() { return __std_netPollConnect(&self); }
    /** @brief 非阻塞发送，从 offset 开始；返回本次发送字节数，未就绪返回零并设置 NET_PENDING。 */
    int64 sendAsync(String data, int64 offset) { return __std_netSendAsync(&self, data, offset); }
    /** @brief 从零偏移开始执行一次非阻塞发送；长消息可能只发送一部分。 */
    int64 sendAsync(String data) { return self.sendAsync(data, 0); }
    /** @brief 非阻塞读取至多 maxBytes 字节；空串结合 status 区分未就绪、关闭及错误。 */
    String receiveAsync(int32 maxBytes) { return __std_netReceiveAsync(&self, maxBytes); }
    /** @brief 非阻塞读取一行；未完成的内容保留，NET_PENDING 不丢失行缓冲。 */
    String receiveLineAsync() { return __std_netReceiveLineAsync(&self); }
    bool isOpen() { if (self.opcode == 0) { return false; } return __std_netIsOpen(self.opcode); }
    String lastError() { if (self.opcode == 0) { return "连接未打开"; } return __std_netError(self.opcode); }
    int64 status() { return __std_netStatus(self.opcode); }
    void close() { if (self.opcode != 0) { __std_netCloseSocket(&self); } }
    int64 send(String data) { return __std_netSend(&self, data); }
    String receive(int32 maxBytes) { return __std_netReceive(&self, maxBytes); }
    String receiveLine(int32 timeoutMs) { return __std_netReceiveLine(&self, timeoutMs); }
};

/** @brief 独占 TCP 监听器；端口为零时由系统分配。 */
#NonCopyable
opcode TcpListener {
    new = std::net::__std_netNew;
    drop = std::net::__std_netDrop;
    static TcpListener listen(String host, int32 port, int32 backlog) {
        return __std_netListen(host, port, backlog);
    }
    static TcpListener listen(String host, int32 port) {
        return TcpListener::listen(host, port, (int32)8);
    }
    bool isOpen() { if (self.opcode == 0) { return false; } return __std_netIsOpen(self.opcode); }
    String lastError() { if (self.opcode == 0) { return "连接未打开"; } return __std_netError(self.opcode); }
    int64 localPort() { return __std_netLocalPort(self.opcode); }
    TcpSocket accept(int32 timeoutMs) { return __std_netAccept(&self, timeoutMs); }
    TcpSocket accept() { return self.accept((int32)5000); }
    /** @brief 非阻塞接受连接；返回未打开且状态为 NET_PENDING 的值表示暂无连接。 */
    TcpSocket acceptAsync() { return __std_netAcceptAsync(&self); }
    void close() { if (self.opcode != 0) { __std_netCloseListener(&self); } }
};

/** @brief 拆开的 HTTP 地址。 */
struct Url {
    bool ok;
    std::lang::String host;
    int64 port;
    std::lang::String path;
    std::lang::String error;
};

/** @brief HTTP 响应：状态码、原因、头部原文、正文。 */
struct HttpResponse {
    bool ok;
    int64 status;
    std::lang::String reason;
    std::lang::String headers;
    std::lang::String body;
    std::lang::String error;

    bool isSuccess() { return self.ok && self.status >= 200 && self.status < 300; }

    /** @brief 按名字取响应头（不分大小写），没有给空串。 */
    std::lang::String header(std::lang::String name) {
        std::lang::List<std::lang::String> lines = std::text::Text::split(self.headers, "\r\n");
        std::lang::String wanted = std::text::Text::toLower(name);
        {
            int64 i = 0;
            while (i < std::lang::len(lines)) {

            std::lang::String line = "";
            line = line + lines[i];
            int64 colon = std::text::Text::find(line, ":");
            if (colon < 0) { { i = i + 1; continue; } }
            std::lang::String key = std::text::Text::toLower(line[0:colon]);
            if (key == wanted) {
                std::lang::String value = line[(colon + 1):];
                return std::text::Text::trim(value);
            }
        
                i = i + 1;
            }
        }
        return "";
    }
};

/* ── 纯函数部分：地址、请求、响应都能脱离套接字单独测 ─────────────────── */

/** @brief 只支持 http:// 的极简地址解析。 */
std::lang::String httpScheme() { return "http://"; }

Url parseUrl(std::lang::String url) {
    Url result;
    result.ok = false;
    result.host = "";
    result.port = 80;
    result.path = "/";
    std::lang::String scheme = "http://";
    if (!std::text::Text::startsWith(url, scheme)) {
        result.error = "只支持 http:// 开头的地址";
        return result;
    }
    std::lang::String rest = url[7:];
    int64 slash = std::text::Text::find(rest, "/");
    /* ChaLi 字符串不要直接复制（`String a = b;` 会留下悬垂别名），一律从空串拼出来 */
    std::lang::String authority = "";
    authority = authority + rest;
    if (slash >= 0) {
        authority = "";
        authority = authority + rest[0:slash];
        result.path = rest[slash:];
    }
    int64 colon = std::text::Text::find(authority, ":");
    if (colon >= 0) {
        result.host = "";
        result.host = result.host + authority[0:colon];
        std::lang::String portText = authority[(colon + 1):];
        result.port = std::parse::Parse::parseInt64(portText).unwrapOr(80);
    } else {
        result.host = "";
        result.host = result.host + authority;
    }
    if (std::lang::len(result.host) == 0) {
        result.error = "地址里没有主机名";
        return result;
    }
    result.ok = true;
    return result;
}

/** @brief 拼一条 HTTP/1.1 请求文本；body 为空时按 GET 处理。 */
std::lang::String buildRequest(std::lang::String method, std::lang::String url, std::lang::String body, std::lang::String contentType) {
    Url target = parseUrl(url);
    std::lang::String request = "";
    if (!target.ok) { return request; }
    std::lang::String requestLine = method + " " + target.path + " HTTP/1.1\r\n";
    request = request + requestLine;
    std::lang::String hostLine = "Host: " + target.host + "\r\n";
    request = request + hostLine;
    request = request + "User-Agent: chali-std-net/1.0\r\n";
    request = request + "Accept: */*\r\n";
    request = request + "Connection: close\r\n";
    if (std::lang::len(body) > 0) {
        std::lang::String mediaType = "";
        mediaType = mediaType + contentType;
        if (std::lang::len(mediaType) == 0) { mediaType = "text/plain; charset=utf-8"; }
        std::lang::String typeLine = "Content-Type: " + mediaType + "\r\n";
        request = request + typeLine;
        std::lang::String lengthLine = std::lang::format("Content-Length: {}\r\n", std::lang::len(body));
        request = request + lengthLine;
    }
    request = request + "\r\n";
    request = request + body;
    return request;
}

/** @brief 解析一段完整的 HTTP 响应文本。 */
HttpResponse parseResponse(std::lang::String raw) {
    HttpResponse response;
    response.ok = false;
    response.status = 0;
    response.reason = "";
    response.headers = "";
    response.body = "";
    response.error = "";

    int64 split = std::text::Text::find(raw, "\r\n\r\n");
    /* 同上：局部串不要用形参直接初始化 */
    std::lang::String head = "";
    head = head + raw;
    if (split >= 0) {
        head = raw[0:split];
        /* 直接拿切片（新串）写进字段：`字段 = 局部串;` 是别名，局部串一释放字段就悬空。 */
        response.body = raw[(split + 4):];
    }
    int64 lineEnd = std::text::Text::find(head, "\r\n");
    std::lang::String statusLine = "";
    statusLine = statusLine + head;
    if (lineEnd >= 0) {
        statusLine = head[0:lineEnd];
        response.headers = head[(lineEnd + 2):];
    }
    int64 firstSpace = std::text::Text::find(statusLine, " ");
    if (firstSpace < 0) {
        response.error = "响应缺少状态行";
        return response;
    }
    std::lang::String codeText = statusLine[(firstSpace + 1):];
    int64 secondSpace = std::text::Text::find(codeText, " ");
    if (secondSpace >= 0) {
        response.reason = codeText[(secondSpace + 1):];
        codeText = codeText[0:secondSpace];
    }
    response.status = std::parse::Parse::parseInt64(codeText).unwrapOr(0);
    response.ok = true;
    return response;
}

/* ── 带套接字的客户端 ─────────────────────────────────────────────────── */

/** @brief 一条连接上的 HTTP 客户端；也提供一次性便捷方法 `fetch`/`submit`。 */
struct HttpClient {
    TcpSocket socket;
    bool connected;

    bool connect(std::lang::String host, int32 port, int32 timeoutMs) {
        self.socket = TcpSocket::connect(host, port, timeoutMs);
        self.connected = self.socket.isOpen();
        return self.connected;
    }

    /** @brief 读到对端关闭或超时为止（`Connection: close` 时正好是一整个响应）。 */
    std::lang::String readAll() {
        std::lang::String out = "";
        bool done = false;
        while (!done) {
            std::lang::String chunk = self.socket.receive((int32)4096);
            if (std::lang::len(chunk) == 0) { done = true; }
            else { out = out + chunk; }
        }
        return out;
    }

    /** @brief 在已连上的连接上发请求并读回响应。 */
    HttpResponse exchange(std::lang::String method, std::lang::String url, std::lang::String body, std::lang::String contentType) {
        HttpResponse response;
        response.ok = false;
        response.status = 0;
        response.error = "";
        if (!self.connected) {
            response.error = "没有连上服务器";
            return response;
        }
        std::lang::String request = buildRequest(method, url, body, contentType);
        if (std::lang::len(request) == 0) {
            response.error = "请求地址不合法";
            return response;
        }
        if (self.socket.send(request) < 0) {
            response.error = self.socket.lastError();
            return response;
        }
        std::lang::String raw = self.readAll();
        return parseResponse(raw);
    }

    void close() {
        self.socket.close();
        self.connected = false;
    }

    /** @brief 一次性 GET：连上、发请求、读响应、关闭。 */
    static HttpResponse fetch(std::lang::String url) {
        HttpResponse response;
        response.ok = false;
        response.status = 0;
        response.error = "";
        Url target = parseUrl(url);
        if (!target.ok) {
            /* `字段 = 别的字段;` 是别名，这里自己拼一块新串。 */
            std::lang::String message = "";
            message = message + target.error;
            response.error = message;
            return response;
        }
        HttpClient client;
        client.connected = false;
        if (!client.connect(target.host, (int32)target.port, (int32)5000)) {
            response.error = client.socket.lastError();
            return response;
        }
        response = client.exchange("GET", url, "", "");
        client.close();
        return response;
    }

    /** @brief 一次性 POST。 */
    static HttpResponse submit(std::lang::String url, std::lang::String body, std::lang::String contentType) {
        HttpResponse response;
        response.ok = false;
        response.status = 0;
        response.error = "";
        Url target = parseUrl(url);
        if (!target.ok) {
            std::lang::String message = "";
            message = message + target.error;
            response.error = message;
            return response;
        }
        HttpClient client;
        client.connected = false;
        if (!client.connect(target.host, (int32)target.port, (int32)5000)) {
            response.error = client.socket.lastError();
            return response;
        }
        response = client.exchange("POST", url, body, contentType);
        client.close();
        return response;
    }
};
