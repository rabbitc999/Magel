module std::watchdog;
/* VM 安全点直接检查超时，不依赖事件或用户回调。无宿主时钟时单位为逻辑指令。 */
enum WatchdogError { NotEnabled, InvalidWatermark, InvalidTimeout };
int64 __watchdogEnable(int64 watermarkBytes);
int64 __watchdogRequestRestart();
int64 __watchdogTimeout(int64 units);
int64 __watchdogKick();
bool __wdOn;
Result<int64, WatchdogError> enable(int64 watermarkBytes) {
    if (watermarkBytes < 0 || __watchdogEnable(watermarkBytes) != 0) { return Result<int64, WatchdogError>::Err(WatchdogError::InvalidWatermark); }
    __wdOn = true;
    return Result<int64, WatchdogError>::Ok(watermarkBytes);
}
Result<int64, WatchdogError> requestRestart() {
    if (!__wdOn || __watchdogRequestRestart() != 0) { return Result<int64, WatchdogError>::Err(WatchdogError::NotEnabled); }
    return Result<int64, WatchdogError>::Ok(0);
}
Result<int64, WatchdogError> enableTimeout(int64 units) {
    if (units <= 0) { return Result<int64, WatchdogError>::Err(WatchdogError::InvalidTimeout); }
    if (!__wdOn) { enable(0); }
    __watchdogTimeout(units);
    return Result<int64, WatchdogError>::Ok(units);
}
Result<int64, WatchdogError> enableTimeoutMillis(int64 millis) {
    if (millis <= 0 || millis > 9223372036854) { return Result<int64, WatchdogError>::Err(WatchdogError::InvalidTimeout); }
    return enableTimeout(millis * 1000000);
}
Result<bool, WatchdogError> kick() {
    if (__watchdogKick() != 0) { return Result<bool, WatchdogError>::Err(WatchdogError::NotEnabled); }
    return Result<bool, WatchdogError>::Ok(true);
}
void disableTimeout() { __watchdogTimeout(0); }
