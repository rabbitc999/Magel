module std::sql;

import std::json;
import std::reflect;

/** 将模型类型映射到数据库表。 */
@annotation ModelClass(table: String)
/** 指定列名、存储类型和主键；kind 为 auto/int/real/text/bool。 */
@annotation ModelField(column: String = "", kind: String = "auto", id: bool = false)

String __ipageBuild(String model, String operation, String options, String values);
int32 __sqlExecBound(int32 db, String sql, String parameters);

/** 可独立保存、查看并执行的 SQL 与参数，参数为 JSON 标量数组。 */
struct SqlStatement {
    /** 包含占位符的 SQL 文本，不含参数值。 */
    String sql;
    /** 按占位符顺序保存类型的 JSON 标量数组。 */
    String parameters;
};

/** 从反射元数据构造模型；没有 @Reflect 或 @ModelClass 时返回诊断。 */
Result<String,String> __model<T>() {
    std::reflect::requireReflection();
    auto reflected = std::reflect::getStructInfo<T>();
    if (reflected.isNone()) { return Result<String,String>::Err("SQL 模型需要 @Reflect"); }
    auto info = reflected.unwrap();
    auto classInfo = std::reflect::getAnnotationInfo("std::sql::ModelClass");
    auto fieldInfo = std::reflect::getAnnotationInfo("std::sql::ModelField");
    if (classInfo.isNone() || fieldInfo.isNone()) { return Result<String,String>::Err("SQL 注解元数据不可用"); }
    String table;
    for (std::reflect::Annotation annotation in info.annotations) {
        if (annotation.annotationId == classInfo.unwrap().typeId) { table = annotation.args.at(0).asText().unwrap(); }
    }
    if (table == "") { return Result<String,String>::Err("SQL 模型需要 @ModelClass(table)"); }
    String output = "{\"name\":" + std::reflect::__serdeQuote(info.name) + ",\"table\":" + std::reflect::__serdeQuote(table) + ",\"fields\":[";
    bool first = true;
    for (std::reflect::FieldInfo field in info.fields) {
        String column = field.name;
        String kind = "auto";
        bool primary = false;
        for (std::reflect::Annotation annotation in field.annotations) {
            if (annotation.annotationId == fieldInfo.unwrap().typeId) {
                String specified = annotation.args.at(0).asText().unwrap();
                if (specified != "") { column = specified; }
                kind = annotation.args.at(1).asText().unwrap();
                primary = annotation.args.at(2).asBool().unwrap();
            }
        }
        if (kind == "auto") {
            if (field.typeId == std::reflect::getTypeId<String>()) { kind = "text"; }
            elif (field.typeId == std::reflect::getTypeId<bool>()) { kind = "bool"; }
            elif (field.typeId == std::reflect::getTypeId<float32>() || field.typeId == std::reflect::getTypeId<float64>()) { kind = "real"; }
            elif (field.typeId == std::reflect::getTypeId<int8>() || field.typeId == std::reflect::getTypeId<int16>() || field.typeId == std::reflect::getTypeId<int32>() || field.typeId == std::reflect::getTypeId<int64>() || field.typeId == std::reflect::getTypeId<uint8>() || field.typeId == std::reflect::getTypeId<uint16>() || field.typeId == std::reflect::getTypeId<uint32>()) { kind = "int"; }
            else { return Result<String,String>::Err("无法推断 SQL 字段存储类型：" + field.name); }
        }
        if (!first) { output = output + ","; }
        first = false;
        output = output + "{\"name\":" + std::reflect::__serdeQuote(field.name) + ",\"column\":" + std::reflect::__serdeQuote(column) + ",\"kind\":" + std::reflect::__serdeQuote(kind) + ",\"id\":" + primary.toString() + "}";
    }
    return Result<String,String>::Ok(output + "]}");
}

/** 值语义的动态查询；复制后可独立修改条件。 */
struct Query {
    /** 从反射类型与注解构造的模型元数据 JSON。 */
    String model;
    /** 按添加顺序合取的参数化过滤条件。 */
    List<String> filters;
    /** 按添加顺序使用的字段排序声明。 */
    List<String> orders;
    /** 显式选择的模型字段，为空时选择全部字段。 */
    List<String> columns;
    /** 最大返回行数，零表示不限制。 */
    int64 limitValue;
    /** 分页跳过的行数。 */
    int64 offsetValue;

    /** 添加排序列；列必须出现在模型中。 */
    void orderBy(String field, bool descending = false) { self.orders.push("{\"field\":" + std::reflect::__serdeQuote(field) + ",\"desc\":" + descending.toString() + "}"); }
    /** 选择模型字段，默认选择全部字段。 */
    void select(String field) { self.columns.push(std::reflect::__serdeQuote(field)); }
    /** 设置非负分页参数。 */
    void page(int64 limit, int64 offset = 0) { self.limitValue = limit; self.offsetValue = offset; }
    /** 生成 SQL 与参数；UPDATE/DELETE 强制要求过滤条件。 */
    Result<SqlStatement,String> build(String operation = "select", String values = "{}") {
        if (self.limitValue < 0 || self.offsetValue < 0) { return Result<SqlStatement,String>::Err("分页参数不能为负数"); }
        String separator = ",";
        String options = "{\"filters\":[" + separator.join(self.filters) + "],\"orders\":[" + separator.join(self.orders) + "],\"columns\":[" + separator.join(self.columns) + "],\"limit\":" + self.limitValue.toString() + ",\"offset\":" + self.offsetValue.toString() + "}";
        auto parsed = std::json::parse(__ipageBuild(self.model, operation, options, values));
        if (parsed.isErr()) { return Result<SqlStatement,String>::Err(parsed.error()); }
        auto response = parsed.unwrap();
        String error = response.find("error").unwrap().asString().unwrap();
        if (error != "") { return Result<SqlStatement,String>::Err(error); }
        SqlStatement statement;
        statement.sql = response.find("sql").unwrap().asString().unwrap();
        statement.parameters = response.find("params").unwrap().dump();
        return Result<SqlStatement,String>::Ok(statement);
    }

};

/*
 * std::sql —— Magel 语言连接**外部 SQL 数据库**的标准库模块（MySQL / SQLite / PostgreSQL / SQL Server）。
 *
 * 这个模块不自己实现 SQL：语句解析、执行、事务、索引全部交给所选数据库引擎，
 * Magel 只负责把语句发过去、把结果搬回来。分层：
 *
 *   Magel 程序 (import std::sql;)
 *      ↓  std::sql::Database / ResultSet      ← 本文件
 *   C++ 胶水（glue/std_sql.hpp，随编译器一起编进来）
 *      ↓  __sql* 句柄接口
 *   外部 SQL 引擎（MySQL / SQLite / PostgreSQL libpq / SQL Server ODBC）
 *
 * 用法：
 *   import std::sql;
 *   std::sql::Database db = std::sql::Database::local("student_db");
 *   db.exec("CREATE TABLE IF NOT EXISTS t (id INT PRIMARY KEY, name VARCHAR(32))");
 *   db.exec("INSERT INTO t (id, name) VALUES (1, '张三')");
 *   std::sql::ResultSet rs = db.exec("SELECT id, name FROM t ORDER BY id");
 *   std::lang::println("{}", rs.render());
 *   db.close();
 *
 * 客户端库在运行期动态加载，不需要在构建时链接；找不到时 `lastError()` 会说明原因，
 * 也可以用环境变量 `MYSQL_LIBRARY` 指向具体的客户端库文件。
 * SQLite 使用 Database::sqlite(":memory:") 或文件路径，静态内置，无需动态库。
 * PostgreSQL 使用 postgres(options) 与 POSTGRES_LIBRARY；SQL Server 使用 sqlServer(options) 与 ODBC 驱动。
 * 跨后端构造字符串字面量使用 db.quote(text)，按各自 SQL 方言处理反斜杠。
 */

/* ── 宿主签名（由 glue/std_sql.hpp 注册） ─────────────────────────────── */
int32 __sqlConnect(std::lang::String host, std::lang::String user, std::lang::String password, std::lang::String database, int32 port);
int32 __sqlOpenSqlite(std::lang::String path);
int32 __sqlOpenPostgres(std::lang::String options);
int32 __sqlOpenOdbc(std::lang::String options);
int32 __sqlClose(int32 db);
int32 __sqlExec(int32 db, std::lang::String sql);
int64 __sqlAffected(int32 db);
std::lang::String __sqlError(int32 db);
int32 __sqlRowCount(int32 rs);
int32 __sqlColCount(int32 rs);
int64 __sqlResultAffected(int32 rs);
std::lang::String __sqlColName(int32 rs, int32 col);
std::lang::String __sqlCellText(int32 rs, int32 row, int32 col);
int64 __sqlCellInt(int32 rs, int32 row, int32 col);
float64 __sqlCellReal(int32 rs, int32 row, int32 col);
int32 __sqlCellKind(int32 rs, int32 row, int32 col);
int32 __sqlFree(int32 rs);

/* ── 格子取值类型编号 ─────────────────────────────────────────────────── */
const int64 CELL_NULL = 0;
const int64 CELL_INT = 1;
const int64 CELL_REAL = 2;
const int64 CELL_TEXT = 3;

/** @brief 结果集里的一个格子，保留类型与文本两种形态。 */
struct DataCell {
    int64 kind;        /**< CELL_NULL / CELL_INT / CELL_REAL / CELL_TEXT */
    int64 intValue;
    float64 realValue;
    std::lang::String textValue;

    bool isNull() { return self.kind == CELL_NULL; }
    bool isNumber() { return self.kind == CELL_INT || self.kind == CELL_REAL; }

    /** @brief 取文本形态；空值给 "NULL"。 */
    std::lang::String text() {
        if (self.kind == CELL_NULL) { return "NULL"; }
        return self.textValue;
    }

    int64 asInt() {
        if (self.kind == CELL_INT) { return self.intValue; }
        if (self.kind == CELL_REAL) { return (int64)self.realValue; }
        return 0;
    }

    float64 asReal() {
        if (self.kind == CELL_REAL) { return self.realValue; }
        if (self.kind == CELL_INT) { return (float64)self.intValue; }
        return 0.0;
    }
};

/** @brief 结果集的一行。 */
struct DataRow {
    std::lang::List<DataCell> cells;

    int64 size() { return std::lang::len(self.cells); }
    DataCell at(int64 index) { return self.cells[index]; }
};

/** @brief 一次 exec 的结果：状态、错误、影响行数、结果集。 */
struct ResultSet {
    bool ok;
    std::lang::String error;
    int64 affected;                    /**< 最近一次写的影响行数 */
    std::lang::List<std::lang::String> columns;
    std::lang::List<DataRow> rows;

    int64 rowCount() { return std::lang::len(self.rows); }
    int64 colCount() { return std::lang::len(self.columns); }
    bool isEmpty() { return std::lang::len(self.rows) == 0; }
    std::lang::String columnName(int64 index) { return self.columns[index]; }

    /** @brief 按列名找下标，找不到给 -1。 */
    int64 columnIndex(std::lang::String name) {
        {
            int64 i = 0;
            while (i < std::lang::len(self.columns)) {

            if (self.columns[i] == name) { return i; }
        
                i = i + 1;
            }
        }
        return -1;
    }

    DataCell at(int64 row, int64 column) { return self.rows[row].cells[column]; }
    std::lang::String textAt(int64 row, int64 column) { return self.rows[row].cells[column].text(); }
    int64 intAt(int64 row, int64 column) { return self.rows[row].cells[column].asInt(); }
    float64 realAt(int64 row, int64 column) { return self.rows[row].cells[column].asReal(); }

    /** @brief 第一行第一列文本（常用作标量查询）。 */
    std::lang::String scalar() {
        if (std::lang::len(self.rows) == 0 || std::lang::len(self.columns) == 0) { return ""; }
        return self.rows[0].cells[0].text();
    }

    /** @brief 第一行第一列整数。 */
    int64 count() {
        if (std::lang::len(self.rows) == 0 || std::lang::len(self.columns) == 0) { return 0; }
        return self.rows[0].cells[0].asInt();
    }

    /** @brief 补空格到指定显示宽度。 */
    std::lang::String pad(std::lang::String text, int64 width) {
        /* 注意：不要写 `String out = text;`（用形参初始化局部串会让运行时漏堆），
         * 先从空串拼接出副本，再逐格补空格。 */
        std::lang::String out = "";
        out = out + text;
        int64 current = displayWidth(text);
        while (current < width) {
            out = out + " ";
            current = current + 1;
        }
        return out;
    }

    /** @brief 把结果集渲染成等宽文本表格（方便命令行查看）。 */
    std::lang::String render() {
        if (!self.ok) { return "错误：" + self.error; }
        if (self.colCount() == 0) { return std::lang::format("影响 {} 行", self.affected); }

        std::lang::List<int64> widths;
        {
            int64 c = 0;
            while (c < self.colCount()) {

            int64 w = displayWidth(self.columnName(c));
            widths.push(w);
        
                c = c + 1;
            }
        }
        {
            int64 r = 0;
            while (r < self.rowCount()) {

            {
                int64 c = 0;
                while (c < self.colCount()) {

                int64 w = displayWidth(self.textAt(r, c));
                if (w > widths[c]) { widths[c] = w; }
            
                    c = c + 1;
                }
            }
        
                r = r + 1;
            }
        }
        std::lang::String bar = "+";
        {
            int64 c = 0;
            while (c < self.colCount()) {

            int64 limit = widths[c] + 2;
            {
                int64 k = 0;
                while (k < limit) {
 bar = bar + "-"; 
                    k = k + 1;
                }
            }
            bar = bar + "+";
        
                c = c + 1;
            }
        }
        std::lang::String out = bar + "\n";
        {
            int64 c = 0;
            while (c < self.colCount()) {

            std::lang::String raw = self.columnName(c);
            std::lang::String cell = self.pad(raw, widths[c]);
            out = out + "| " + cell + " ";
        
                c = c + 1;
            }
        }
        out = out + "|\n";
        out = out + bar + "\n";
        {
            int64 r = 0;
            while (r < self.rowCount()) {

            {
                int64 c = 0;
                while (c < self.colCount()) {

                std::lang::String raw = self.textAt(r, c);
                std::lang::String cell = self.pad(raw, widths[c]);
                out = out + "| " + cell + " ";
            
                    c = c + 1;
                }
            }
            out = out + "|\n";
            out = out + bar + "\n";
        
                r = r + 1;
            }
        }
        return out;
    }
};

/** @brief std::sql 支持的数据库引擎。 */
enum Driver { MySQL, SQLite, PostgreSQL, SqlServer, Odbc, MariaDB };

int64 __sqlOwnerNew();
void __sqlOwnerDrop(int64 owner);
Database __sqlOwn(int32 connection, int64 driver);
int64 __sqlOwnerState(int64 owner, int64 operation);
String __sqlOwnerError(int64 owner);
void __sqlOwnerUpdate(int64 owner, String text, int64 affected);

/** 独占数据库连接；借用可观察同一状态，普通赋值或传参不能复制连接。 */
#NonCopyable
opcode Database {
    new = std::sql::__sqlOwnerNew;
    drop = std::sql::__sqlOwnerDrop;

    /** 连接 MySQL，返回拥有连接或失败诊断的独占值。 */
    static Database mysql(String host, String user, String password, String database, int32 port) {
        return __sqlOwn(__sqlConnect(host, user, password, database, port), 0);
    }
    /** 打开 SQLite 文件或独立的内存数据库。 */
    static Database sqlite(String path) { return __sqlOwn(__sqlOpenSqlite(path), 1); }
    /** 使用连接串打开 PostgreSQL。 */
    static Database postgres(String options) { return __sqlOwn(__sqlOpenPostgres(options), 2); }
    /** 使用 Unicode ODBC 连接串连接数据源。 */
    static Database odbc(String options) { return __sqlOwn(__sqlOpenOdbc(options), 4); }
    /** 使用已安装的 ODBC 驱动连接 SQL Server。 */
    static Database sqlServer(String options) { return __sqlOwn(__sqlOpenOdbc(options), 3); }
    /** 当前连接声明的数据库驱动。 */
    Driver driver() {
        int64 value = __sqlOwnerState(self.opcode, 1);
        if (value == 1) { return Driver::SQLite; }
        if (value == 2) { return Driver::PostgreSQL; }
        if (value == 3) { return Driver::SqlServer; }
        if (value == 4) { return Driver::Odbc; }
        if (value == 5) { return Driver::MariaDB; }
        return Driver::MySQL;
    }

    /** @brief 按当前数据库规则生成字符串字面量。 */
    std::lang::String quote(std::lang::String text) {
        match (self.driver()) {
            Driver::MySQL => { return std::sql::quote(text, true); }
            Driver::MariaDB => { return std::sql::quote(text, true); }
            Driver::SqlServer => { return "N" + std::sql::quote(text, false); }
            _ => { return std::sql::quote(text, false); }
        }
    }

    /** @brief 返回当前数据库后端名称。 */
    std::lang::String backendName() {
        match (self.driver()) {
            Driver::MySQL => { return "mysql"; }
            Driver::MariaDB => { return "mariadb"; }
            Driver::SQLite => { return "sqlite"; }
            Driver::PostgreSQL => { return "postgresql"; }
            Driver::SqlServer => { return "sqlserver"; }
            Driver::Odbc => { return "odbc"; }
        }
        return "";
    }

    /** @brief 默认端口 3306 的连接。 */
    static Database mysql(std::lang::String host, std::lang::String user, std::lang::String password, std::lang::String database) {
        return Database::mysql(host, user, password, database, (int32)3306);
    }

    /** @brief 使用兼容的 MySQL/MariaDB 客户端连接 MariaDB，默认端口 3306。 */
    static Database maria(String host, String user, String password, String database, int32 port = (int32)3306) {
        return __sqlOwn(__sqlConnect(host, user, password, database, port), 5);
    }

    /** @brief 本机开发用的默认连接：127.0.0.1:3306，用户 root，口令 123456。 */
    static Database local(std::lang::String database) {
        return Database::mysql("127.0.0.1", "root", "123456", database, (int32)3306);
    }

    bool isOpen() { return __sqlOwnerState(self.opcode, 3) != 0; }
    std::lang::String lastError() { return __sqlOwnerError(self.opcode); }
    int64 affectedRows() { return __sqlOwnerState(self.opcode, 2); }

    /** @brief 关闭连接；重复调用安全。 */
    void close() { int64 ignored = __sqlOwnerState(self.opcode, 4); }

    /**
     * @brief 执行一条（或一段）SQL。
     * @param sql SQL 文本；可以包含多条语句，用分号分隔。
     * @return 结果集；`ok` 为假时 `error` 里是服务器给出的诊断。
     */
    ResultSet exec(std::lang::String sql) {
        int32 rs = __sqlExec((int32)__sqlOwnerState(self.opcode, 0), sql);
        return self.__result(rs);
    }
    /** 执行生成的参数化语句；值通过驱动绑定。 */
    ResultSet exec(SqlStatement statement) {
        int32 rs = __sqlExecBound((int32)__sqlOwnerState(self.opcode, 0), statement.sql, statement.parameters);
        return self.__result(rs);
    }
    /** 从宿主结果句柄提取独立拥有的结果并更新连接状态。 */
    ResultSet __result(int32 rs) {
        ResultSet result;
        result.ok = false;
        result.affected = 0;
        if (!self.isOpen()) {
            result.error = "数据库未连接";
            __sqlOwnerUpdate(self.opcode, result.error, -1);
            return result;
        }
        if (rs < 0) {
            result.error = __sqlError((int32)__sqlOwnerState(self.opcode, 0));
            __sqlOwnerUpdate(self.opcode, result.error, -1);
            return result;
        }
        result.ok = true;
        result.error = "";
        __sqlOwnerUpdate(self.opcode, "", -1);
        result.affected = (int64)__sqlResultAffected(rs);
        __sqlOwnerUpdate(self.opcode, "", result.affected);

        int64 columns = (int64)__sqlColCount(rs);
        int64 rows = (int64)__sqlRowCount(rs);
        {
            int64 c = 0;
            while (c < columns) {

            result.columns.push(__sqlColName(rs, (int32)c));
        
                c = c + 1;
            }
        }
        {
            int64 r = 0;
            while (r < rows) {

            DataRow row;
            {
                int64 c = 0;
                while (c < columns) {

                int32 kind = __sqlCellKind(rs, (int32)r, (int32)c);
                DataCell cell;
                cell.kind = (int64)kind;
                if (kind != CELL_NULL) {
                    cell.textValue = __sqlCellText(rs, (int32)r, (int32)c);
                    cell.intValue = (int64)__sqlCellInt(rs, (int32)r, (int32)c);
                    cell.realValue = __sqlCellReal(rs, (int32)r, (int32)c);
                }
                row.cells.push(cell);
            
                    c = c + 1;
                }
            }
            result.rows.push(row);
        
                r = r + 1;
            }
        }
        __sqlFree(rs);
        return result;
    }

    /** @brief 执行并只关心成败。 */
    bool execOk(std::lang::String sql) {
        ResultSet result = self.exec(sql);
        return result.ok;
    }

    /** @brief 执行一个"取一行一列"的查询，返回文本。 */
    std::lang::String scalar(std::lang::String sql) {
        ResultSet result = self.exec(sql);
        if (!result.ok) { return ""; }
        return result.scalar();
    }

    /** @brief 执行一个 `SELECT COUNT(...)` 之类的查询，返回整数。 */
    int64 count(std::lang::String sql) {
        ResultSet result = self.exec(sql);
        if (!result.ok) { return 0; }
        return result.count();
    }

    /** @brief 当前所选库里表是否存在。 */
    bool hasTable(std::lang::String tableName) {
        std::lang::String name = self.quote(tableName);
        match (self.driver()) {
            Driver::SQLite => {
                return self.count("SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = " + name) > 0;
            }
            Driver::PostgreSQL => {
                return self.count("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = current_schema() AND table_name = " + name) > 0;
            }
            Driver::SqlServer => {
                return self.count("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = SCHEMA_NAME() AND table_name = " + name) > 0;
            }
            Driver::Odbc => {
                __sqlOwnerUpdate(self.opcode, "通用 ODBC 的表元数据随数据库而异，请执行对应的元数据查询", -1);
                return false;
            }
            _ => { }
        }
        std::lang::String sql = "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE()"
                     " AND table_name = " + name;
        return self.count(sql) > 0;
    }
};

/* ── 辅助函数 ─────────────────────────────────────────────────────────── */

/** @brief 把文本包成 SQL 字符串字面量，始终转义单引号，可选择转义反斜杠。 */
std::lang::String quote(std::lang::String text, bool escapeBackslash) {
    std::lang::String out = "'";
    int64 start = 0, i = 0;
    while (i < std::lang::len(text)) {
        char c = text[i];
        if (c == '\'' || (escapeBackslash && c == '\\')) {
            out = out + text[start:i];
            if (c == '\'') { out = out + "''"; }
            else { out = out + "\\\\"; }
            start = i + 1;
        }
        int64 byte = (int64)c;
        if (byte >= 240) { i += 4; }
        elif (byte >= 224) { i += 3; }
        elif (byte >= 192) { i += 2; }
        else { i += 1; }
    }
    out = out + text[start:std::lang::len(text)];
    out = out + "'";
    return out;
}

/** @brief 按 MySQL 规则转义；跨后端代码请调用 db.quote(text)。 */
std::lang::String quote(std::lang::String text) { return quote(text, true); }

/** @brief 把整数写成 SQL 字面量。 */
std::lang::String intLiteral(int64 value) { return std::lang::format("{}", value); }

/** @brief 把实数写成 SQL 字面量。 */
std::lang::String realLiteral(float64 value) { return std::lang::format("{}", value); }

/** @brief 按终端显示宽度算长度：ASCII 一列，中日韩等宽字符两列。 */
int64 displayWidth(std::lang::String text) {
    int64 width = 0;
    int64 i = 0;
    while (i < std::lang::len(text)) {
        int64 byte = (int64)text[i];
        if (byte >= 240) { width += 2; i += 4; }
        elif (byte >= 224) { width += 2; i += 3; }
        elif (byte >= 192) { width += 1; i += 2; }
        else { width += 1; i += 1; }
    }
    return width;
}

    /** 从带模型注解的反射类型创建查询。 */
    Result<Query,String> query<T>() {
        auto metadata = __model<T>();
        if (metadata.isErr()) { return Result<Query,String>::Err(metadata.error()); }
        Query query;
        query.model = metadata.unwrap();
        return Result<Query,String>::Ok(query);
    }
    /** 添加参数化条件；操作符编号与 ipage OperatorType 一致，默认相等。 */
    Result<bool,String> filter<V>(Query mut& query, String field, V value, int64 operation = 0) {
        auto encoded = std::json::serialize<V>(&value);
        if (encoded.isErr()) { return Result<bool,String>::Err(encoded.error()); }
        query.filters.push("{\"field\":" + std::reflect::__serdeQuote(field) + ",\"op\":" + operation.toString() + ",\"values\":[" + encoded.unwrap() + "]}");
        return Result<bool,String>::Ok(true);
    }
    /** 添加 IN 或 NOT IN 等多参数条件。 */
    Result<bool,String> filterMany<V>(Query mut& query, String field, List<V> values, int64 operation = 11) {
        auto encoded = std::json::serialize<List<V>>(&values);
        if (encoded.isErr()) { return Result<bool,String>::Err(encoded.error()); }
        query.filters.push("{\"field\":" + std::reflect::__serdeQuote(field) + ",\"op\":" + operation.toString() + ",\"values\":" + encoded.unwrap() + "}");
        return Result<bool,String>::Ok(true);
    }

    /** 使用模型值生成参数化 INSERT。 */
    Result<SqlStatement,String> insert<T>(Query mut& query, T const& value) {
        auto encoded = std::json::serialize<T>(value);
        if (encoded.isErr()) { return Result<SqlStatement,String>::Err(encoded.error()); }
        return query.build("insert", encoded.unwrap());
    }
    /** 使用模型值生成参数化 UPDATE，主键不会被修改。 */
    Result<SqlStatement,String> update<T>(Query mut& query, T const& value) {
        auto encoded = std::json::serialize<T>(value);
        if (encoded.isErr()) { return Result<SqlStatement,String>::Err(encoded.error()); }
        return query.build("update", encoded.unwrap());
    }
