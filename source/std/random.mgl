module std::random;

Random randomWithSeed(uint64 seed);
Random randomFromEntropy();
uint64 randomNextUInt64(uint64 handle);
int64 randomNextInt(uint64 handle, int64 minimum, int64 maximum);
float64 randomNextFloat64(uint64 handle);
float64 randomNextRange(uint64 handle, float64 minimum, float64 maximum);
bool randomNextBool(uint64 handle);
void randomDrop(uint64 handle);
uint64 __randomCopy(uint64 handle);

/** 拥有当前随机序列位置；普通复制获得相同位置的独立序列。 */
opcode Random {
    new = std::random::randomFromEntropy;
    copy = std::random::__randomCopy;
    drop = std::random::randomDrop;

    /** 使用可复现的种子建立独立生成器。 */
    static Random withSeed(uint64 seed) { return randomWithSeed(seed); }
    /** 使用宿主熵源建立独立生成器。 */
    static Random fromEntropy() { return randomFromEntropy(); }
    uint64 nextUInt64() { return randomNextUInt64((uint64)self.opcode); }
    int64 nextInt(int64 minimum, int64 maximum) { return randomNextInt((uint64)self.opcode, minimum, maximum); }
    float64 nextFloat64() { return randomNextFloat64((uint64)self.opcode); }
    float64 nextRange(float64 minimum, float64 maximum) { return randomNextRange((uint64)self.opcode, minimum, maximum); }
    bool nextBool() { return randomNextBool((uint64)self.opcode); }
};
