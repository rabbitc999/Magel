module std::serialization;
import std::json;
import std::reflect;

String __transcode(String input, bool tomlOutput);
List<uint8> __pack(String text, uint64 typeId);
String __unpack(List<uint8> bytes, uint64 typeId);

/** 将反射值编码为带稳定类型标识和版本的独立字节流。 */
Result<List<uint8>,String> serialize<T>(T const& value) {
    auto encoded = std::json::serialize<T>(value);
    if (encoded.isErr()) { return Result<List<uint8>,String>::Err(encoded.error()); }
    return Result<List<uint8>,String>::Ok(__pack(encoded.unwrap(), std::reflect::getTypeId<T>()));
}
/** 严格验证类型、版本和长度后恢复独立拥有的值。 */
Result<T,String> deserialize<T>(List<uint8> bytes) {
    String unpacked = __unpack(bytes, std::reflect::getTypeId<T>());
    if (!unpacked.startsWith("1")) { return Result<T,String>::Err(unpacked.removePrefix("0")); }
    return std::json::deserialize<T>(unpacked.removePrefix("1"));
}
