module std::tree;
int64 __bstNew();
int64 __generalNew();
int64 __heapNew();
int64 __treeCopy(int64 handle);
void __treeDrop(int64 handle);
int64 __treeOp(int64 handle, int64 operation, int64 value, int64 extra);
List<int64> __treeValues(int64 handle, int64 mode, int64 start);
BinarySearchTree __treeAsBinary(int64 handle);
GeneralTree __treeAsGeneral(int64 handle);

/** 独立节点快照，live 标识有效槽；空孩子及空根使用 -1。 */
struct TreeSnapshot {
    List<int64> keys; ///< 各节点槽的键值。
    List<int64> lefts; ///< 左孩子下标，空孩子为 -1。
    List<int64> rights; ///< 右孩子下标，空孩子为 -1。
    List<int64> live; ///< 有效节点槽标记，1 表示有效。
    int64 root; ///< 根下标，空树为 -1。
    int64 count; ///< 有效节点数量。
};
/** 独立通用树快照，首孩子与次兄弟保留原节点号。 */
struct GeneralTreeSnapshot {
    List<int64> values; ///< 各节点槽的值。
    List<int64> firstChild; ///< 首孩子下标，空孩子为 -1。
    List<int64> nextSibling; ///< 次兄弟下标，空兄弟为 -1。
    List<int64> live; ///< 有效节点槽标记，1 表示有效。
    int64 root; ///< 根下标，空树为 -1。
    int64 count; ///< 有效节点数量。
};
/** 独立拥有宿主节点的二叉搜索集合，普通复制深复制。 */
opcode BinarySearchTree {
    new = std::tree::__bstNew;
    copy = std::tree::__treeCopy;
    drop = std::tree::__treeDrop;
    /** 创建空容器。 */
    static BinarySearchTree create() { return BinarySearchTree::new(); }
    /** 有效元素数。 */
    int64 len() { return __treeOp(self.opcode, 0, 0, 0); }
    /** 清空所有节点和回收槽。 */
    void clear() { __treeOp(self.opcode, 1, 0, 0); }
    /** 插入键，重复键返回 false。 */
    bool insert(int64 value) { return __treeOp(self.opcode, 2, value, 0) != 0; }
    /** 删除键，不存在返回 false。 */
    bool remove(int64 value) { return __treeOp(self.opcode, 3, value, 0) != 0; }
    /** 查询键是否存在。 */
    bool contains(int64 value) { return __treeOp(self.opcode, 4, value, 0) != 0; }
    /** 最小键，空树返回 None。 */
    Option<int64> min() { if (self.len() == 0) { return Option<int64>::None; } return Option<int64>::Value(__treeOp(self.opcode, 5, 0, 0)); }
    /** 最大键，空树返回 None。 */
    Option<int64> max() { if (self.len() == 0) { return Option<int64>::None; } return Option<int64>::Value(__treeOp(self.opcode, 6, 0, 0)); }
    /** 最大路径节点数，空树为零。 */
    int64 height() { return __treeOp(self.opcode, 7, 0, 0); }
    /** 独立中序键快照。 */
    List<int64> inorder() { return __treeValues(self.opcode, 0, 0); }
    /** 独立先序键快照。 */
    List<int64> preorder() { return __treeValues(self.opcode, 1, 0); }
    /** 独立后序键快照。 */
    List<int64> postorder() { return __treeValues(self.opcode, 2, 0); }
    /** 显式导出独立节点结构。 */
    TreeSnapshot snapshot() {
        TreeSnapshot result;
        result.keys = __treeValues(self.opcode, 10, 0); result.lefts = __treeValues(self.opcode, 11, 0);
        result.rights = __treeValues(self.opcode, 12, 0); result.live = __treeValues(self.opcode, 13, 0);
        result.root = __treeOp(self.opcode, 14, 0, 0); result.count = self.len(); return result;
    }
};

int64 __redBlackNew();
int64 __redBlackCopy(int64 handle);
void __redBlackDrop(int64 handle);
int64 __redBlackOp(int64 handle, int64 operation, int64 key);
List<int64> __redBlackSnapshot(int64 handle);

/** 独立拥有宿主节点的红黑集合，插入和删除原地修复，普通复制深复制状态。 */
opcode RedBlackTree {
    new = std::tree::__redBlackNew;
    copy = std::tree::__redBlackCopy;
    drop = std::tree::__redBlackDrop;

    /** 创建空红黑树。 */
    static RedBlackTree create() { return RedBlackTree::new(); }
    /** 插入不存在的键；重复键返回 false。 */
    bool insert(int64 value) { return __redBlackOp(self.opcode, 0, value) != 0; }
    /** 删除键并修复黑高与颜色；不存在时返回 false。 */
    bool remove(int64 value) { return __redBlackOp(self.opcode, 1, value) != 0; }
    /** 查询键是否存在。 */
    bool contains(int64 value) { return __redBlackOp(self.opcode, 2, value) != 0; }
    /** 当前有效键数。 */
    int64 len() { return __redBlackOp(self.opcode, 3, 0); }
    /** 树高，空树为零。 */
    int64 height() { return __redBlackOp(self.opcode, 4, 0); }
    /** 清空节点及回收槽。 */
    void clear() { __redBlackOp(self.opcode, 5, 0); }
    /** 最小键；空树返回 None。 */
    Option<int64> min() {
        if (self.len() == 0) { return Option<int64>::None; }
        return Option<int64>::Value(__redBlackOp(self.opcode, 6, 0));
    }
    /** 最大键；空树返回 None。 */
    Option<int64> max() {
        if (self.len() == 0) { return Option<int64>::None; }
        return Option<int64>::Value(__redBlackOp(self.opcode, 7, 0));
    }
    /** 检查排序、父指针、根颜色、连续红节点和黑高约束。 */
    bool validate() { return __redBlackOp(self.opcode, 8, 0) != 0; }
    /** 显式导出独立升序键快照。 */
    List<int64> inorder() { return __redBlackSnapshot(self.opcode); }
};

/** 独立拥有宿主堆数组的最小优先队列。 */
opcode MinHeap {
    new = std::tree::__heapNew;
    copy = std::tree::__treeCopy;
    drop = std::tree::__treeDrop;
    /** 创建空容器。 */
    static MinHeap create() { return MinHeap::new(); }
    /** 有效元素数。 */
    int64 len() { return __treeOp(self.opcode, 0, 0, 0); }
    /** 清空所有节点和回收槽。 */
    void clear() { __treeOp(self.opcode, 1, 0, 0); }
    /** 原地插入一个值。 */
    void push(int64 value) { __treeOp(self.opcode, 8, value, 0); }
    /** 弹出最小值，空堆返回 None。 */
    Option<int64> pop() { if (self.len() == 0) { return Option<int64>::None; } return Option<int64>::Value(__treeOp(self.opcode, 9, 0, 0)); }
    /** 读取最小值，空堆返回 None。 */
    Option<int64> peek() { if (self.len() == 0) { return Option<int64>::None; } return Option<int64>::Value(__treeOp(self.opcode, 10, 0, 0)); }
    /** 是否为空。 */
    bool isEmpty() { return self.len() == 0; }
    /** 显式导出独立堆数组。 */
    List<int64> snapshot() { return __treeValues(self.opcode, 14, 0); }
};

/** 独立拥有首孩子、次兄弟表示的通用树。 */
opcode GeneralTree {
    new = std::tree::__generalNew;
    copy = std::tree::__treeCopy;
    drop = std::tree::__treeDrop;
    /** 创建空容器。 */
    static GeneralTree create() { return GeneralTree::new(); }
    /** 有效元素数。 */
    int64 len() { return __treeOp(self.opcode, 0, 0, 0); }
    /** 清空所有节点和回收槽。 */
    void clear() { __treeOp(self.opcode, 1, 0, 0); }
    /** 仅空树可建立根，否则返回 -1。 */
    int64 addRoot(int64 value) { return __treeOp(self.opcode, 11, value, 0); }
    /** 在父节点末尾追加孩子，无效父节点返回 -1。 */
    int64 addChild(int64 cursor, int64 value) { return __treeOp(self.opcode, 12, cursor, value); }
    /** 读取有效节点值，越界报错。 */
    int64 valueAt(int64 cursor) { return __treeOp(self.opcode, 13, cursor, 0); }
    /** 当前根节点号，空树为 -1。 */
    int64 rootNode() { return __treeOp(self.opcode, 14, 0, 0); }
    /** 独立孩子节点号列表，无效节点返回空列表。 */
    List<int64> children(int64 cursor) { return __treeValues(self.opcode, 5, cursor); }
    /** 独立先序节点号列表。 */
    List<int64> preorder() { return __treeValues(self.opcode, 3, 0); }
    /** 独立层序节点号列表。 */
    List<int64> levelOrder() { return __treeValues(self.opcode, 4, 0); }
    /** 根到叶的最大节点数，空树为零。 */
    int64 height() { return __treeOp(self.opcode, 7, 0, 0); }
    /** 独立转换首孩子为左孩子、次兄弟为右孩子；不保证键有序。 */
    BinarySearchTree toBinary() { return __treeAsBinary(self.opcode); }
    /** 独立复制二叉表示，保持源根节点号及有效槽。 */
    static GeneralTree fromBinary(BinarySearchTree tree) { return __treeAsGeneral(tree.opcode); }
    /** 显式导出独立首孩子、次兄弟结构。 */
    GeneralTreeSnapshot snapshot() {
        GeneralTreeSnapshot result;
        result.values = __treeValues(self.opcode, 10, 0); result.firstChild = __treeValues(self.opcode, 11, 0);
        result.nextSibling = __treeValues(self.opcode, 12, 0); result.live = __treeValues(self.opcode, 13, 0);
        result.root = self.rootNode(); result.count = self.len(); return result;
    }
};
