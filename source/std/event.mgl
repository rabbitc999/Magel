module std::event;
import std::concurrency;
/* 事件只在显式 receive 时返回，绝不自动调用用户代码。默认邮箱容量 256。 */
int64 __receive(int64 millis);
int64 __timer(int64 nanos, bool repeat);
void __destroy(int64 handle);
int64 __source();
int64 __tag();
int64 __missed();
int64 __id();
int64 __post(int64 tag, int64 source);
void __close();
struct Event {
    int64 timer;
    int64 tag;
    int64 source;
    int64 missed;
};
std::concurrency::Receive<Event> receiveFor(int64 millis) {
    std::concurrency::Receive<Event> result;
    result.status = __receive(millis);
    if (result.isReady()) {
        result.value.timer = __id();
        result.value.tag = __tag();
        result.value.source = __source();
        result.value.missed = __missed();
    }
    return result;
}
std::concurrency::Receive<Event> receive() { return receiveFor(-1); }
std::concurrency::Receive<Event> tryReceive() { return receiveFor(0); }
int64 post(int64 tag, int64 source) { return __post(tag, source); }
void close() { __close(); }
/* 定时源独占释放责任，使用共享队列的截止时间服务，不创建定时器线程。 */
struct Timer : Drop {
    int64 handle;
    static Timer everyNanos(int64 nanos) { Timer result; result.handle = __timer(nanos, true); return result; }
    static Timer afterNanos(int64 nanos) { Timer result; result.handle = __timer(nanos, false); return result; }
    static Timer everyMillis(int64 millis) {
        Timer result;
        if (millis > 0 && millis <= 9223372036854) { result.handle = __timer(millis * 1000000, true); }
        return result;
    }
    static Timer afterMillis(int64 millis) {
        Timer result;
        if (millis > 0 && millis <= 9223372036854) { result.handle = __timer(millis * 1000000, false); }
        return result;
    }
    bool isValid() { return self.handle != 0; }
    void stop() { __destroy(self.handle); self.handle = 0; }
    void drop() { self.stop(); }
};
