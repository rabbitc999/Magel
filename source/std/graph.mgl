module std::graph;

/* 图论标准库：有向 / 无向带权图与并查集，全部算法实现在宿主胶水（glue/std_graph.hpp）。
 *
 * 图采用"链式前向星"邻接存储：head[v] 是顶点 v 的第一条边下标（-1 表示没有），
 * edgeTo[e] / edgeNext[e] / edgeWeight[e] 分别是边 e 的终点、同起点下一条边与边权。
 * 顶点编号 0..n-1，键全部为 int64。
 *
 * BFS / DFS 输出可达顶点访问序；拓扑排序有环时输出空表；
 * Dijkstra 要求边权非负，不可达顶点距离为 -1；
 * 最小生成树（Kruskal）只对无向图有意义，图不连通返回 -1。
 */

/** 图算法胶水回执；槽布局必须与 glue/std_graph.hpp 的 GraphReply 一致。 */
struct GraphReply {
    String error; ///< 错误说明；成功时为空串。
    int64 value; ///< 标量结果：分量个数或生成树总权值。
    int64 flag; ///< 布尔结果：1 = 无环 / 有环（按入口语义）。
    List<int64> order; ///< 访问序或拓扑序。
    List<int64> dist; ///< Dijkstra 距离表，不可达为 -1。
}

/** 带权图：有向 / 无向由构造时的 directed 决定；重边与自环都允许。 */
struct GraphSnapshot {
    int64 vertexCount; ///< 顶点数量。
    bool directed; ///< 是否为有向图。
    int64 edgeCount; ///< 逻辑边数，不计镜像邻接。
    List<int64> head; ///< 各顶点首条邻接记录下标。
    List<int64> edgeTo; ///< 邻接记录终点。
    List<int64> edgeNext; ///< 同起点的下一条邻接记录。
    List<int64> edgeWeight; ///< 邻接记录权重。
};

int64 __graphNew();
Graph __graphCreate(int64 vertices, bool directed);
int64 __graphCopy(int64 handle);
void __graphDrop(int64 handle);
int64 __graphState(int64 handle, int64 operation);
void __graphAdd(int64 handle, int64 from, int64 to, int64 weight);
void __graphQuery(int64 handle, int64 operation, int64 start, GraphReply mut& reply);
List<int64> __graphSnapshot(int64 handle, int64 part);

/** 拥有持久邻接数组的图，普通复制深复制，算法只导出结果。 */
opcode Graph {
    new = std::graph::__graphNew;
    copy = std::graph::__graphCopy;
    drop = std::graph::__graphDrop;
    /** 创建指定顶点数及方向的图。 */
    static Graph create(int64 vertexCount, bool directed) { return __graphCreate(vertexCount, directed); }
    /** 原地添加边；无向图同时登记反向邻接。 */
    void addEdge(int64 from, int64 to, int64 weight) { __graphAdd(self.opcode, from, to, weight); }
    /** 顶点数。 */
    int64 vertexCount() { return __graphState(self.opcode, 0); }
    /** 是否有向。 */
    bool isDirected() { return __graphState(self.opcode, 1) != 0; }
    /** 添加的逻辑边数。 */
    int64 len() { return __graphState(self.opcode, 2); }
    /** 广度优先访问序列。 */
    List<int64> bfs(int64 start) { GraphReply reply; __graphQuery(self.opcode, 0, start, &reply); return reply.order; }
    /** 深度优先访问序列。 */
    List<int64> dfs(int64 start) { GraphReply reply; __graphQuery(self.opcode, 1, start, &reply); return reply.order; }
    /** 无向口径的连通分量数。 */
    int64 connectedComponents() { GraphReply reply; __graphQuery(self.opcode, 2, 0, &reply); return reply.value; }
    /** 拓扑顺序，有环时为空。 */
    List<int64> topologicalSort() { GraphReply reply; __graphQuery(self.opcode, 3, 0, &reply); return reply.order; }
    /** 单源非负权最短路，不可达距离为 -1。 */
    List<int64> dijkstra(int64 start) { GraphReply reply; __graphQuery(self.opcode, 4, start, &reply); return reply.dist; }
    /** 按图方向检测环。 */
    bool hasCycle() { GraphReply reply; __graphQuery(self.opcode, 5, 0, &reply); return reply.flag != 0; }
    /** 无向最小生成树权重，不连通时为 -1。 */
    int64 minimumSpanningTreeWeight() { GraphReply reply; __graphQuery(self.opcode, 6, 0, &reply); return reply.value; }
    /** 显式导出完整独立邻接快照。 */
    GraphSnapshot snapshot() {
        GraphSnapshot result;
        result.vertexCount = self.vertexCount(); result.directed = self.isDirected(); result.edgeCount = self.len();
        result.head = __graphSnapshot(self.opcode, 0); result.edgeTo = __graphSnapshot(self.opcode, 1);
        result.edgeNext = __graphSnapshot(self.opcode, 2); result.edgeWeight = __graphSnapshot(self.opcode, 3);
        return result;
    }
};

int64 __std_unionNew();
UnionFind __std_unionCreate(int64 count);
int64 __std_unionCopy(int64 handle);
void __std_unionDrop(int64 handle);
int64 __std_unionOp(int64 handle, int64 operation, int64 left, int64 right);
List<int64> __std_unionSnapshot(int64 handle, bool sizes);

/** 拥有独立数组的并查集；普通复制深复制状态，查询和合并原地执行。 */
opcode UnionFind {
    new = std::graph::__std_unionNew;
    copy = std::graph::__std_unionCopy;
    drop = std::graph::__std_unionDrop;

    /** 创建 n 个单元素集合。 */
    static UnionFind create(int64 n) { return __std_unionCreate(n); }
    /** 带路径压缩查询根；不复制或导出内部数组。 */
    int64 find(int64 x) { return __std_unionOp(self.opcode, 0, x, 0); }
    /** 按大小原地合并；发生合并时返回 true。 */
    bool unionSets(int64 a, int64 b) { return __std_unionOp(self.opcode, 1, a, b) != 0; }
    /** 判断两个元素是否属于同一集合。 */
    bool connected(int64 a, int64 b) { return __std_unionOp(self.opcode, 2, a, b) != 0; }
    /** 查询元素所在集合的大小。 */
    int64 sizeOf(int64 x) { return __std_unionOp(self.opcode, 3, x, 0); }
    /** 当前连通分量个数。 */
    int64 count() { return __std_unionOp(self.opcode, 4, 0, 0); }
    /** 总元素个数。 */
    int64 len() { return __std_unionOp(self.opcode, 5, 0, 0); }
    /** 显式导出独立父指针快照。 */
    List<int64> parents() { return __std_unionSnapshot(self.opcode, false); }
    /** 显式导出独立集合大小快照；仅根对应的值有集合大小含义。 */
    List<int64> sizes() { return __std_unionSnapshot(self.opcode, true); }
};
