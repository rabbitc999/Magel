module std::cli;
import std::parse;

/** 参数错误保留原始参数及可供用户阅读的原因。 */
struct CliError { String argument; String message; };
/** 一个选项；shortName 为零时没有短名称，takesValue=false 表示布尔开关。 */
struct CliOption { String name; char shortName; bool takesValue; bool required; String defaultValue; String description; };
/** 解析结果；选项使用长名称作为键，位置参数保持输入顺序。 */
struct CliArguments {
    Map<String,String> options; List<String> positional; bool helpRequested;
    /** 查询选项值；未定义的名称返回 None。 */
    Option<String> get(String name) {
        if (self.options.has(name)==0) { return Option<String>::None; }
        return Option<String>::Value(self.options[name]);
    }
    /** 严格转换整数参数，失败返回带参数名的错误。 */
    Result<int64,CliError> getInt(String name) {
        CliError error; error.argument=name; error.message="expected an integer option";
        if (self.options.has(name)==0) { return Result<int64,CliError>::Err(error); }
        auto parsed=Parse::parseInt64(self.options[name]);
        if (!parsed.isOk()) { return Result<int64,CliError>::Err(error); }
        return Result<int64,CliError>::Ok(parsed.unwrap());
    }
};
/** @brief 生成参数诊断。 */
CliError cliError(String argument, String message) { CliError result; result.argument=argument; result.message=message; return result; }
/** @brief 从字节位置 start 复制命令行参数后缀。 */
String cliTail(String text,int64 start) { List<uint8> bytes=stringBytes(text);String result="";for(int64 i=start;i<bytes.len();i=i+1){result=result+format("{}",(char)bytes[i]);}return result; }
/** 命令行选项定义与解析器；不调用 exit、不打印帮助，由应用决定交互行为。 */
struct CliParser {
    String program; String description; List<CliOption> definitions;
    /** 登记选项；拒绝重复名称、保留的 help/h、非法名称及带值开关的歧义。 */
    bool add(CliOption option) {
        if (len(option.name)==0 || option.name=="help" || option.shortName=='h') { return false; }
        List<uint8> optionName=stringBytes(option.name);
        for (int64 i=0;i<optionName.len();i=i+1) {
            char ch=(char)optionName[i];
            if (!((ch>='a' && ch<='z') || (ch>='A' && ch<='Z') || (ch>='0' && ch<='9') || ch=='-')) { return false; }
        }
        if (option.name[0]=='-') { return false; }
        if (option.shortName!=(char)0 && !((option.shortName>='a' && option.shortName<='z') || (option.shortName>='A' && option.shortName<='Z'))) { return false; }
        for (CliOption existing in self.definitions) {
            if (existing.name==option.name || (option.shortName!=(char)0 && existing.shortName==option.shortName)) { return false; }
        }
        self.definitions.push(option); return true;
    }
    /** 自动生成使用说明和长短选项帮助。 */
    String help() {
        String result="Usage: "+self.program+" [options] [arguments]\n"+self.description+"\n  -h, --help  Show help\n";
        for (CliOption option in self.definitions) {
            result=result+"  ";
            if (option.shortName!=(char)0) { result=result+"-"+format("{}",option.shortName)+", "; }
            result=result+"--"+option.name;
            if (option.takesValue) { result=result+" VALUE"; }
            if (option.required) { result=result+" (required)"; }
            if (len(option.defaultValue)>0) { result=result+" [default: "+option.defaultValue+"]"; }
            result=result+"  "+option.description+"\n";
        }
        return result;
    }
    /** 解析长选项、短选项组合、附着值与 --；重复选项采用最后一次的值。 */
    Result<CliArguments,CliError> parse(List<String> arguments) {
        CliArguments result; Map<String,bool> seen;
        for (CliOption option in self.definitions) {
            String initial=option.defaultValue;
            if (!option.takesValue && len(initial)==0) { initial="false"; }
            result.options[option.name]=initial;
        }
        bool positional=false;
        for (int64 i=0;i<arguments.len();i=i+1) {
            String argument=arguments[i]; List<uint8> argumentBytes=stringBytes(argument);
            if (positional || len(argument)<2 || argument[0]!='-') { result.positional.push(argument); continue; }
            if (argument=="--") { positional=true; continue; }
            if (argument=="--help" || argument=="-h") { result.helpRequested=true; continue; }
            if (argument[1]=='-') {
                String name=""; String value=""; bool assigned=false;
                for (int64 j=2;j<len(argument);j=j+1) {
                    if ((char)argumentBytes[j]=='=' && !assigned) { assigned=true; }
                    elif (assigned) { value=value+format("{}",(char)argumentBytes[j]); }
                    else { name=name+format("{}",(char)argumentBytes[j]); }
                }
                int64 found=-1;
                for (int64 j=0;j<self.definitions.len();j=j+1) { if (self.definitions[j].name==name) { found=j; break; } }
                if (found<0) { return Result<CliArguments,CliError>::Err(cliError(argument,"unknown option")); }
                CliOption option=self.definitions[found];
                if (option.takesValue) {
                    if (!assigned) {
                        if (i+1>=arguments.len()) { return Result<CliArguments,CliError>::Err(cliError(argument,"missing value")); }
                        i=i+1; value=arguments[i];
                    }
                } else {
                    if (assigned) { return Result<CliArguments,CliError>::Err(cliError(argument,"flag does not accept a value")); }
                    value="true";
                }
                result.options[name]=value; seen[name]=true;
            } else {
                for (int64 j=1;j<len(argument);j=j+1) {
                    if ((char)argumentBytes[j]=='h') { result.helpRequested=true; continue; }
                    int64 found=-1;
                    for (int64 k=0;k<self.definitions.len();k=k+1) {
                        if (self.definitions[k].shortName==(char)argumentBytes[j]) { found=k; break; }
                    }
                    if (found<0) { return Result<CliArguments,CliError>::Err(cliError(argument,"unknown short option")); }
                    CliOption option=self.definitions[found]; String value="true";
                    if (option.takesValue) {
                        value="";
                        if (j+1<len(argument)) { value=cliTail(argument,j+1); }
                        if (j+1==len(argument)) {
                            if (i+1>=arguments.len()) { return Result<CliArguments,CliError>::Err(cliError(argument,"missing value")); }
                            i=i+1; value=arguments[i];
                        }
                        j=len(argument);
                    }
                    result.options[option.name]=value; seen[option.name]=true;
                }
            }
        }
        if (!result.helpRequested) {
            for (CliOption option in self.definitions) {
                if (option.required && seen.has(option.name)==0) { return Result<CliArguments,CliError>::Err(cliError(option.name,"required option is missing")); }
            }
        }
        return Result<CliArguments,CliError>::Ok(result);
    }
};
