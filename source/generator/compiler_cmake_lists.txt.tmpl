cmake_minimum_required(VERSION 3.16)
project(magel_compiler LANGUAGES C CXX)
if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
endif()
find_package(Threads REQUIRED)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/runtime/core_sources.txt")
file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/runtime/core_sources.txt" STACKVM_CORE_SOURCES)
list(TRANSFORM STACKVM_CORE_SOURCES PREPEND "${CMAKE_CURRENT_SOURCE_DIR}/runtime/")
add_library(magel_vm_core STATIC ${STACKVM_CORE_SOURCES})
file(GLOB MAGEL_STANDARD_SOURCES CONFIGURE_DEPENDS glue/std_*.cpp)
list(REMOVE_ITEM MAGEL_STANDARD_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/glue/std_demo.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/caspp/core_sources.txt")
file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/caspp/core_sources.txt" MAGEL_CAS_SOURCES)
list(TRANSFORM MAGEL_CAS_SOURCES PREPEND "${CMAKE_CURRENT_SOURCE_DIR}/caspp/")
if(NO_MAGEL_STD OR NO_MAGEL_STD_CAS OR NO_MAGEL_BIG_INT)
    set(MAGEL_CAS_SOURCES "")
endif()
add_library(magel_host_records STATIC ${MAGEL_STANDARD_SOURCES} ${MAGEL_CAS_SOURCES} ipage/sql.cpp ipage/dialect.cpp runtime/bigint.cpp runtime/bigint_multiplication.cpp runtime/bigint_division.cpp runtime/bigint_number_theory.cpp runtime/bigint_bits.cpp runtime/bigint_modular.cpp runtime/bigint_conversion.cpp runtime/bigfloat.cpp runtime/bigfloat_roots.cpp runtime/bigfloat_transcendental.cpp runtime/bigfloat_trigonometry.cpp
    sqlite/sqlite3.c json/json.cpp toml/toml.cpp toml/toml_source.cpp)
add_library(magel_runtime STATIC runtime/simple_ast.cpp runtime/ast_type.cpp runtime/ast_node.cpp runtime/ast_data.cpp runtime/preprocess.cpp lztext/lztext.cpp
    miniz/miniz_tinfl.c dap/dap_server.cpp)
target_link_libraries(magel_runtime PUBLIC magel_vm_core magel_host_records Threads::Threads)

# 反射的前端与运行时默认同时编入；单次编译使用 --no-reflection 关闭。
option(MAGEL_WITH_REFLECTION "启用注解与反射前端支持" ON)
option(STACKVM_WITH_REFLECTION "启用注解与反射运行时支持" ON)
foreach(target magel_vm_core magel_host_records magel_runtime)
    target_include_directories(${target} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/runtime
        ${CMAKE_CURRENT_SOURCE_DIR}/json ${CMAKE_CURRENT_SOURCE_DIR}/toml ${CMAKE_CURRENT_SOURCE_DIR}/caspp/include)
    target_compile_definitions(${target} PUBLIC MAGEL_CUSTOM_ALLOCATOR=1
        MAGEL_WITH_REFLECTION=$<BOOL:${MAGEL_WITH_REFLECTION}>
        STACKVM_WITH_REFLECTION=$<BOOL:${STACKVM_WITH_REFLECTION}>)
endforeach()

# 裁剪定义 PUBLIC 传播到前端和运行时，避免配置不一致。
foreach(feature NO_MAGEL_BIG_INT NO_MAGEL_BIG_FLOAT NO_MAGEL_DEFAULT_POOL NO_MAGEL_STD NO_MAGEL_STD_CAS NO_MAGEL_STD_MATH NO_MAGEL_STD_RANDOM NO_MAGEL_STD_REGEX NO_MAGEL_STD_SIGNAL NO_MAGEL_STD_JSON NO_MAGEL_STD_TOML NO_MAGEL_STD_BINARY NO_MAGEL_STD_LINALG NO_MAGEL_STD_PARSE NO_MAGEL_STD_PROCESS)
    option(${feature} "裁剪 ${feature} 对应功能" OFF)
    if(${feature})
        target_compile_definitions(magel_runtime PUBLIC ${feature})
    endif()
endforeach()

file(GLOB MAGEL_MACRO_SOURCES CONFIGURE_DEPENDS macro/*.cpp literals/*.cpp syntax/*.cpp editor/*.cpp)
add_library(magel_parser STATIC magel_parser.cpp magel_resource_cleanup.cpp magel_generic.cpp magel_lambda.cpp
    magel_generic_closure.cpp magel_package.cpp magel_report.cpp magel_stdlib_embedded.cpp)
target_sources(magel_parser PRIVATE ${MAGEL_MACRO_SOURCES})
target_include_directories(magel_parser PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
target_link_libraries(magel_parser PUBLIC magel_runtime)

add_executable(magel magel_main.cpp)
target_link_libraries(magel PRIVATE magel_parser magel_runtime)
configure_file(std/lang.mgl ${CMAKE_CURRENT_BINARY_DIR}/std/lang.mgl COPYONLY)
if(WIN32)
    target_link_libraries(magel PRIVATE winhttp)
endif()
if(NOT WIN32)
    target_link_libraries(magel PRIVATE m)
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_libraries(magel PRIVATE dl)
endif()
if(MSVC)
    target_compile_options(magel_runtime PRIVATE /utf-8)
    target_compile_options(magel_vm_core PRIVATE /utf-8)
    target_compile_options(magel_host_records PRIVATE /utf-8)
    target_compile_options(magel_parser PRIVATE /utf-8 /bigobj)
    target_compile_options(magel PRIVATE /utf-8)
endif()

# MinGW 调试/低优化构建的解析器与驱动可能超过普通 COFF 节数量上限。
if(MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_compile_options(magel_vm_core PRIVATE -pthread)
    target_link_options(magel PRIVATE -static -pthread)
    # GCC 11 的 COFF 字符串表在大型 O0 单元中也会溢出；保留 -g，Debug 的两个生成目标使用 O1。
    foreach(target magel_parser magel)
        target_compile_options(${target} PRIVATE -Wa,-mbig-obj $<$<CONFIG:Debug>:-O1>)
    endforeach()
endif()
