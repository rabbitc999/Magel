/* magel_token.gram —— MAGEL 语言的词法声明（从 magel.gram 抽出的 %trivia /
 * %token / %define / %right / %left）。由 magel.gram 通过 %include 引入。 */
%trivia "//[^\n]*"
%trivia "/\\*[\\s\\S]*?\\*/"

%token ANNOTATION "@annotation"
%token AT "@"

%define STRUCT "struct"
%define ENUM "enum"
%define INT8 "int8"
%define INT16 "int16"
%define INT32 "int32"
%define INT64 "int64"
%define VOID "void"
%define BOOL "bool"
%define CHAR_T "char"
%define TRUE "true"
%define FALSE "false"
%define CONST "const"
%define MUT "mut"
%define NEW "new"
%define HEAP "heap"
%define DELETE "delete"
%define DROP "drop"
%define STATIC "static"
%token EXPORT "export"
%token FN "fn"
%define AUTO "auto"
%token COPY "copy"
%token MOVE "move"
/* f 后紧跟双引号的词法归一化标记，不登记 f 为关键字。 */
%token FSTRING "__magel_fstring"
%token TYPECHECK "__magel_typecheck"
%define INLINE "inline"
%define IMPL "impl"
%define TYPE_KW "type"
%define ABI_KW "abi"
%define MODULE "module"
%define IMPORT "import"
%define CAST_KW "cast"
%define UINT8 "uint8"
%define UINT16 "uint16"
%define UINT32 "uint32"
%define UINT64 "uint64"
%define FLOAT32 "float32"
%define FLOAT64 "float64"
%define IF "if"
%define ELIF "elif"
%define ELSE "else"
%define WHILE "while"
%define FOR "for"
%define IN "in"
%define LOOP "loop"
%define RETURN "return"
%define MATCH "match"
%define DO "do"
%define BREAK "break"
%token DERIVE "#derive"
%token YIELD "yield"
%define CONTINUE "continue"
%token DEFER "defer"
%token SCOPE_EXIT "scope"
%define WILDCARD "_"
%define INTERFACE "interface"
%define TYPE_TAG "__typeTag"
%token INCREMENT "++"
%token DECREMENT "--"
%define PLUS "+"
%define MINUS "-"
%define STAR "*"
%define SLASH "/"
%define PERCENT "%"
%define ASSIGN "="
%token ADD_ASSIGN "+="
%token SUB_ASSIGN "-="
%token MUL_ASSIGN "*="
%token DIV_ASSIGN "/="
%token MOD_ASSIGN "%="
%token AND_ASSIGN "&="
%token OR_ASSIGN "\|="
%token XOR_ASSIGN "^="
%token SHL_ASSIGN "<<="
%token SHR_ASSIGN ">>="
%define EQ "=="
%define NE "!="
%define LE "<="
%define GE ">="
%define LT "<"
%define GT ">"
%define AND "&&"
%define OR "\|\|"
%define NOT "!"
%define ARROW "->"
%define ELLIPSIS "..."
%define DOT "."
%define LPAREN "("
%define RPAREN ")"
%define LBRACE "{"
%define RBRACE "}"
%define LBRACKET "["
%define RBRACKET "]"
%define SEMI ";"
%define COMMA ","
%define COLON ":"
%define SCOPE "::"
%define AMP "&"
%define PIPE "\|"
%define CARET "^"
%define TILDE "~"
%define SHL "<<"
%define SHR ">>"
%define FATARROW "=>"
%define QUESTION "?"

%token regex FLIT   "[0-9]+(\\.[0-9]+([eE][-+]?[0-9]+)?|[eE][-+]?[0-9]+)[f]?|[0-9]+f"
%token regex ULIT   "[0-9]+u"
%token regex HEXLIT "0[xX][A-Za-z0-9_]*"
%token regex BINLIT "[bB]_?[0-9][A-Za-z0-9_]*"
%token regex STRING "\"([^\"\\\\]|\\\\.)*\""
%token regex CHRLIT "'([^'\\\\]|\\\\.)+'"

%right FN
%right SEMI
%right CONST MUT
%left OR
%left AND
%left PIPE
%left CARET
%left AMP
%left EQ NE
%left LT LE GT GE
%left SHL SHR
%left PLUS MINUS
%left STAR SLASH PERCENT
%right TILDE
%right NOT
%left AT ANNOTATION
%left LPAREN

/* 泛型归一化后的内部标点；不登记任何容器名关键字。 */
%token TYPE_ARGS_BEGIN "@<"
%token TYPE_ARGS_END "@>"
