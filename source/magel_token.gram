/* magel_token.gram —— MAGEL 语言的词法声明（从 magel.gram 抽出的 %trivia /
 * %token / %identifier / %space / %right / %left）。由 magel.gram 通过 %include 引入。 */
%identifier "[A-Za-z_][A-Za-z0-9_]*"
%space " \t\r\n"
%token regex NUMBER "[0-9]+"

%trivia "//[^\n]*"
%trivia "/\\*[\\s\\S]*?\\*/"

%token ANNOTATION "@annotation"
%token AT "@"

/* 编译期 AST 宏：关键字单独登记，调用名保留美元前缀。 */
%token MACRO_DEFINE "$macro"
%token MACRO_REPLACE "$replace"
%token MACRO_END "$end_macro"
%token MACRO_BODY "@!macrobody"
%token MACRO_MATCH "$match"
%token MACRO_ELSE "$else"
%token MACRO_END_MATCH "$end_match"
%token MACRO_REGEX "$regex"
%token MACRO_END_REGEX "$end_regex"
%token MACRO_FOR "$for"
%token MACRO_END_FOR "$end_for"
%token MACRO_IS "is"
%token MACRO_EXPR "expr"
%token MACRO_IDENT "ident"
%token MACRO_BLOCK "block"
%token MACRO_STMT "stmt"
%token MACRO_PARSE_EXPR "@!macroparse_expr"
%token MACRO_PARSE_IDENT "@!macroparse_ident"
%token MACRO_PARSE_TYPE "@!macroparse_type"
%token MACRO_PARSE_BLOCK "@!macroparse_block"
%token MACRO_PARSE_STMT "@!macroparse_stmt"
%token regex MACRO_NAME "\\$[A-Za-z_][A-Za-z0-9_]*(@![0-9]+)?"
%token regex MACRO_FRAGMENT "@!macrofragment[0-9]+_[0-9]+"

%token STRUCT "struct"
%token OPCODE "opcode"
%token NONCOPYABLE "#NonCopyable"
%token ENUM "enum"
%token INT8 "int8"
%token INT16 "int16"
%token INT32 "int32"
%token INT64 "int64"
%token VOID "void"
%token BOOL "bool"
%token CHAR_T "char"
%token TRUE "true"
%token FALSE "false"
%token CONST "const"
%token MUT "mut"
%token NEW "new"
%token HEAP "heap"
%token DROP "drop"
%token STATIC "static"
%token FN "fn"
%token AUTO "auto"
%token COPY "copy"
%token MOVE "move"
%token INLINE "inline"
%token IMPL "impl"
%token TYPE_KW "type"
%token ABI_KW "abi"
%token MODULE "module"
%token IMPORT "import"
%token CAST_KW "cast"
%token UINT8 "uint8"
%token UINT16 "uint16"
%token UINT32 "uint32"
%token UINT64 "uint64"
%token FLOAT32 "float32"
%token FLOAT64 "float64"
%token IF "if"
%token ELIF "elif"
%token ELSE "else"
%token WHILE "while"
%token FOR "for"
%token IN "in"
%token LOOP "loop"
%token RETURN "return"
%token MATCH "match"
%token BREAK "break"
%token DERIVE "#derive"
%token YIELD "yield"
%token CONTINUE "continue"
%token DEFER "defer"
%token SCOPE_EXIT "scope"
%token WILDCARD "_"
%token INTERFACE "interface"
%token TYPE_TAG "__typeTag"
%token INCREMENT "++"
%token DECREMENT "--"
%token PLUS "+"
%token MINUS "-"
%token STAR "*"
%token SLASH "/"
%token PERCENT "%"
%token ASSIGN "="
%token ADD_ASSIGN "+="
%token SUB_ASSIGN "-="
%token MUL_ASSIGN "*="
%token DIV_ASSIGN "/="
%token MOD_ASSIGN "%="
%token AND_ASSIGN "&="
%token OR_ASSIGN "\|="
%token XOR_ASSIGN "^="
%token SHL_ASSIGN "<<="
%token SHR_ASSIGN ">>="
%token EQ "=="
%token NE "!="
%token LE "<="
%token GE ">="
%token LT "<"
%token GT ">"
%token AND "&&"
%token OR "\|\|"
%token NOT "!"
%token ARROW "->"
%token ELLIPSIS "..."
%token DOUBLE_DOT ".."
%token DOT "."
%token LPAREN "("
%token RPAREN ")"
%token LBRACE "{"
%token RBRACE "}"
%token LBRACKET "["
%token RBRACKET "]"
%token SEMI ";"
%token COMMA ","
%token COLON ":"
%token SCOPE "::"
%token AMP "&"
%token PIPE "\|"
%token CARET "^"
%token TILDE "~"
%token SHL "<<"
%token SHR ">>"
%token FATARROW "=>"
%token QUESTION "?"

%token regex FLIT   "[0-9]+(\\.[0-9]+([eE][-+]?[0-9]+)?|[eE][-+]?[0-9]+)[f]?|[0-9]+f"
%token regex ULIT   "[0-9]+u"
%token regex HEXLIT "0[xX][A-Za-z0-9_]*"
%token regex BINLIT "[bB]_?[0-9][A-Za-z0-9_]*"
%token regex STRING "\"([^\"\\\\]|\\\\.)*\""
%token regex CHRLIT "'([^'\\\\]|\\\\.)+'"

%right FN
%right SEMI
%right CONST MUT
%left OR
%left AND
%left PIPE
%left CARET
%left AMP
%left EQ NE
%left LT LE GT GE
%left SHL SHR
%left PLUS MINUS
%left STAR SLASH PERCENT
%right TILDE
%right NOT
%left AT ANNOTATION
%left LPAREN
%left LBRACKET LBRACE

/* f 后紧跟双引号的词法归一化标记，不登记 f 为关键字。 */
%token FSTRING "__magel_fstring"
%token TYPECHECK "__magel_typecheck"

/* 泛型归一化后的内部标点；不登记任何容器名关键字。 */
%token TYPE_ARGS_BEGIN "@<"
%token TYPE_ARGS_END "@>"

/* 显式闭包类型选择使用独立边界，避免与容器类型归约混淆。 */
%token CLOSURE_ARGS_BEGIN "@!<"
%token CLOSURE_ARGS_END "@!>"
