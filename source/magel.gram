/* ============================================================
 * magel/magel.gram —— MAGEL 语言（C 风格虚拟机语言）的文法。
 *
 * 三段分工：
 *   ① 文法在归约时建 C 语法树（节点池 + 下标当语义值，语义值是 POD int）；
 *   ② %epilogue 的 M_Lower 把 C 语法树降级成 simple_ast 的 AST；
 *   ③ %main：解析 → 降级 → generate → 落 .quad/.data/.layout →
 *      stackvm 组装执行，直接出结果。
 *
 * 词法声明（%trivia / %token / %identifier / %space / %right / %left）已抽到
 * magel_token.gram，本文件用 %include 引入；产生式从下方开始。
 * 完整语言范围见 README.md。
 * ============================================================ */

%mode lalr
%cpp_lexer std
%namespace magel
%value_type int
%max_stack_depth 4096

%include "magel_token.gram"

%start program

%expect 0

program := top_list { M_SetProgram($1); $$ = $1; } ;

top_list := %empty { $$ = M_List(); }
          | top_list top { M_ListAdd($1, $2); $$ = $1; } ;

top := annotation_decl { $$ = $1; }
     | annotation_list top_decl { $$ = M_Annotated($1, $2); }
     | top_decl { $$ = $1; } ;

top_decl := struct_decl type_decl_end { $$ = $1; }
     | opcode_decl type_decl_end { $$ = $1; }
     | NONCOPYABLE opcode_decl type_decl_end { $$ = M_NonCopyableOpcode($2); }
     | derive_directive struct_decl type_decl_end { $$ = M_Derived($1, $2); }
     | derive_directive enum_decl type_decl_end { $$ = M_Derived($1, $2); }
     | MODULE module_name SEMI { $$ = M_Module($2); }
     | IMPORT module_name SEMI { $$ = M_Import($2); }
     | enum_decl type_decl_end { $$ = $1; }
     | interface_decl type_decl_end { $$ = $1; }
     | func_def     { $$ = $1; }
     | INLINE func_def { $$ = M_Inline($2); }
     | host_func_decl { $$ = $1; }
     | abi_block { $$ = $1; }
     | host_type_decl { $$ = $1; }
     | host_impl_decl { $$ = $1; }
     | operator_def { $$ = $1; }

     | global_decl  { $$ = $1; } ;

/* 带花括号的类型声明在右花括号处结束；顶层兼容其后的可选分号。 */
type_decl_end := %empty { $$ = -1; }
               | SEMI { $$ = -1; } ;

/* 编译器指令仅修饰类型声明，白名单和字段接口约束由语义层检查。 */
derive_directive := DERIVE LPAREN iface_list RPAREN { $$ = $3; } ;

/* 不透明胶水对象显式绑定创建、销毁及可选复制方法。 */
opcode_decl := OPCODE name_token LBRACE opcode_methods RBRACE
    { $$ = M_Opcode($2, $4); } ;
opcode_methods := %empty { $$ = M_List(); }
    | opcode_methods opcode_method { M_ListAdd($1, $2); $$ = $1; } ;
opcode_method := NEW ASSIGN module_name SEMI { $$ = M_OpcodeMethod(0, $3); }
    | DROP ASSIGN module_name SEMI { $$ = M_OpcodeMethod(1, $3); }
    | COPY ASSIGN module_name SEMI { $$ = M_OpcodeMethod(2, $3); }
    | member { $$ = $1; } ;

/* ---- 编译期注解：声明只在顶层，使用只包裹声明，不进入语句/表达式文法。 ---- */
annotation_decl := ANNOTATION module_name
    { $$ = M_AnnotationDecl($1, $2, M_List()); }
  | ANNOTATION module_name LPAREN annotation_params RPAREN
    { $$ = M_AnnotationDecl($1, $2, $4); } ;
annotation_params := %empty { $$ = M_List(); }
  | annotation_param_items { $$ = $1; } ;
annotation_param_items := annotation_param { $$ = M_List1($1); }
  | annotation_param_items COMMA annotation_param { M_ListAdd($1, $3); $$ = $1; } ;
annotation_param := name_token COLON element_type
    { $$ = M_AnnotationParam($1, $3, -1); }
  | name_token COLON element_type ASSIGN expr
    { $$ = M_AnnotationParam($1, $3, $5); } ;
annotation_list := annotation_use { $$ = M_List1($1); }
  | annotation_list annotation_use { M_ListAdd($1, $2); $$ = $1; } ;
annotation_use := AT module_name { $$ = M_AnnotationUse($1, $2, M_List()); }
  | AT module_name LPAREN annotation_args RPAREN { $$ = M_AnnotationUse($1, $2, $4); } ;
annotation_args := %empty { $$ = M_List(); }
  | annotation_arg_items { $$ = $1; } ;
annotation_arg_items := annotation_arg { $$ = M_List1($1); }
  | annotation_arg_items COMMA annotation_arg { M_ListAdd($1, $3); $$ = $1; } ;
annotation_arg := expr { $$ = M_AnnotationArg(-1, $1); }
  | name_token COLON expr { $$ = M_AnnotationArg($1, $3); } ;

module_name := name_token { $$ = $1; }
             | module_name SCOPE name_token { $$ = M_QualifiedName($1, $3); } ;

/* ---- interface：编译期契约 ---- */
interface_decl := INTERFACE name_token LBRACE iface_member_list RBRACE
    { $$ = M_Interface($2, $4); }
  | INTERFACE name_token COLON iface_list LBRACE iface_member_list RBRACE
    { $$ = M_InterfaceInherit($2, $4, $6); } ;

iface_member_list := %empty { $$ = M_List(); }
                   | iface_member_list iface_member { M_ListAdd($1, $2); $$ = $1; } ;

/* 接口方法可以仅声明，也可以给出默认实现；接口本身不能有字段。 */
iface_member := annotation_list iface_member_decl { $$ = M_Annotated($1, $2); }
  | iface_member_decl { $$ = $1; } ;

iface_member_decl := STATIC type name_token LPAREN param_list RPAREN SEMI
    { $$ = M_StaticIfaceMethod($2, $3, $5); }
  | TYPE_KW name_token SEMI { $$ = M_AssociatedDecl($2); }
  | type name_token LPAREN param_list RPAREN SEMI
    { $$ = M_IfaceMethod($1, $2, $4, -1); }
  | type name_token LPAREN param_list RPAREN block
    { $$ = M_IfaceMethod($1, $2, $4, $6); }
  | type DROP LPAREN param_list RPAREN SEMI
    { $$ = M_IfaceMethod($1, M_KeywordName(1), $4, -1); }
  | type DROP LPAREN param_list RPAREN block
    { $$ = M_IfaceMethod($1, M_KeywordName(1), $4, $6); }
  | ptr_type name_token LPAREN param_list RPAREN SEMI
    { $$ = M_IfaceMethod($1, $2, $4, -1); }
  | ptr_type name_token LPAREN param_list RPAREN block
    { $$ = M_IfaceMethod($1, $2, $4, $6); }
  | type name_token SEMI { $$ = M_InterfaceFieldRejected($2); }
  | ptr_type name_token SEMI { $$ = M_InterfaceFieldRejected($2); } ;

/* struct X : A, B { … } 里继承的那串接口名 */
iface_list := name_token                     { $$ = M_List1($1); }
            | iface_list COMMA name_token    { M_ListAdd($1, $3); $$ = $1; } ;

/* ---- 类型 ---- */
type := builtin_type { $$ = $1; }
      | name_token     { $$ = M_TypeStruct($1); }
      | qualified_ref { $$ = M_QualifiedType($1); }
      | container_type { $$ = $1; }
      | tuple_type     { $$ = $1; }
      | function_type { $$ = $1; }
      | LPAREN function_type RPAREN %prec FN { $$ = $2; } ;

/* 异构定长元组：至少两个元素；单元素括号仍只是普通分组。 */
tuple_type := LPAREN tuple_items RPAREN { $$ = M_TypeTupleSyntax($2); } ;

/* 先共享括号内容，见到后续声明/表达式上下文再解释类型或值 */
tuple_items := tuple_item COMMA tuple_item { $$ = M_List2($1, $3); }
             | tuple_items COMMA tuple_item { M_ListAdd($1, $3); $$ = $1; } ;
tuple_item := expr { $$ = $1; }
            | band_expr AMP { $$ = M_TupleTypeItem(M_ReadOnlyReferenceType($1)); }
            | builtin_type { $$ = M_TupleTypeItem($1); }
            | container_type { $$ = M_TupleTypeItem($1); }
            | function_type { $$ = M_TupleTypeItem($1); }
            | ptr_type { $$ = M_TupleTypeItem($1); } ;

/* 容器与元组可保存非拥有元素引用；限定词不能产生引用的引用。 */
element_type := type { $$ = $1; }
              | type AMP { $$ = M_TypePtr($1); }
              | type CONST AMP { $$ = M_TypePtr($1); }
              | type MUT AMP { $$ = M_TypePtrMut($1); } ;

/* 普通标识符的类型实参由泛型归一化层标记边界；原始 < / > 保持比较语义。 */
container_type := name_token TYPE_ARGS_BEGIN element_type TYPE_ARGS_END
                    { $$ = M_ImplicitContainer($1, $3, -1); }
                | name_token TYPE_ARGS_BEGIN element_type COMMA element_type TYPE_ARGS_END
                    { $$ = M_ImplicitContainer($1, $3, $5); }
                | qualified_ref TYPE_ARGS_BEGIN element_type TYPE_ARGS_END
                    { $$ = M_QualifiedContainer($1, $3, -1); }
                | qualified_ref TYPE_ARGS_BEGIN element_type COMMA element_type TYPE_ARGS_END
                    { $$ = M_QualifiedContainer($1, $3, $5); } ;

/* 内建类型单独登记 */
builtin_type := INT8    { $$ = M_TypeIntBits(8, 0); }
              | INT16   { $$ = M_TypeIntBits(16, 0); }
              | INT32   { $$ = M_TypeIntBits(32, 0); }
              | INT64   { $$ = M_TypeIntBits(64, 0); }
              | UINT8   { $$ = M_TypeIntBits(8, 1); }
              | UINT16  { $$ = M_TypeIntBits(16, 1); }
              | UINT32  { $$ = M_TypeIntBits(32, 1); }
              | UINT64  { $$ = M_TypeIntBits(64, 1); }
              | FLOAT64 { $$ = M_TypeFloatBits(64); }
              | FLOAT32 { $$ = M_TypeFloatBits(32); }
              | BOOL    { $$ = M_TypeBool(); }
              | CHAR_T  { $$ = M_TypeChar(); }
              | VOID    { $$ = M_TypeVoid(); }
              ;

/* ---- 引用与运行时数组 ---- */
ptr_type := type AMP                 { $$ = M_TypePtr($1); }
          | type CONST AMP           { $$ = M_TypePtr($1); }
          | type MUT AMP             { $$ = M_TypePtrMut($1); }
          | array_type AMP           { $$ = M_TypePtr($1); }
          | array_type CONST AMP     { $$ = M_TypePtr($1); }
          | array_type MUT AMP       { $$ = M_TypePtrMut($1); }
          ;

/* T[] a = …; —— 中括号写在类型这一侧 */
array_type := type LBRACKET RBRACKET { $$ = M_TypeRuntimeArray($1); } ;

/* ---- struct：定义时写 `struct 名字`（引用类型时只写名字）---- */
struct_decl := STRUCT name_token LBRACE member_list RBRACE
    { $$ = M_Struct($2, $4, -1); }
  | STRUCT name_token COLON iface_list LBRACE member_list RBRACE
    { $$ = M_Struct($2, $6, $4); }
  | STRUCT name_token name_token LBRACE member_list RBRACE
    { $$ = M_PackedStruct($2, $3, $5, -1); }
  | STRUCT name_token name_token COLON iface_list LBRACE member_list RBRACE
    { $$ = M_PackedStruct($2, $3, $7, $5); } ;

/* ---- enum：带标签联合体 ---- */
enum_decl := ENUM name_token LBRACE enum_variant_list RBRACE
    { $$ = M_Enum($2, $4); }
  | ENUM name_token LBRACE enum_variant_list SEMI member_list RBRACE
    { $$ = M_EnumWithMethods($2, $4, $6, -1); }
  | ENUM name_token COLON iface_list LBRACE enum_variant_list SEMI member_list RBRACE
    { $$ = M_EnumWithMethods($2, $6, $8, $4); } ;

enum_variant_list := enum_variant { $$ = M_List1($1); }
                   | enum_variant_list COMMA enum_variant
                       { M_ListAdd($1, $3); $$ = $1; } ;

enum_variant := name_token { $$ = M_EnumVariant($1, -1); }
              | name_token LPAREN param_list RPAREN { $$ = M_EnumVariant($1, $3); } ;

member_list := %empty { $$ = M_List(); }
             | member_list member { M_ListAdd($1, $2); $$ = $1; } ;

member := annotation_list member_decl { $$ = M_Annotated($1, $2); }
  | member_decl { $$ = $1; } ;

member_decl := AUTO name_token ASSIGN expr SEMI { $$ = M_ClosureField($2, $4); }
        | type name_token SEMI            { $$ = M_Field($1, $2); }
        | type name_token LBRACKET expr RBRACKET SEMI { $$ = M_ArrayField($1, $2, M_Dims1($4)); }
        | type name_token LBRACKET expr RBRACKET LBRACKET expr RBRACKET SEMI { $$ = M_ArrayField($1, $2, M_Dims2($4, $7)); }
        | TYPE_KW name_token ASSIGN element_type SEMI { $$ = M_AssociatedDef($2, $4); }
        | ptr_type name_token SEMI        { $$ = M_Field($1, $2); }   /* `Cell mut& next;` */
        | STATIC type name_token SEMI     { $$ = M_StaticField($2, $3); }
        | STATIC ptr_type name_token SEMI { $$ = M_StaticField($2, $3); }
        | type name_token LPAREN param_list RPAREN block
            { $$ = M_Method($1, $2, -1, $4, $6); }
        | ptr_type name_token LPAREN param_list RPAREN block
            { $$ = M_Method($1, $2, -1, $4, $6); }
        | array_type name_token LPAREN param_list RPAREN block
            { $$ = M_Method($1, $2, -1, $4, $6); }
        | type DROP LPAREN param_list RPAREN block
            { $$ = M_Method($1, M_KeywordName(1), -1, $4, $6); }
        | STATIC type name_token LPAREN param_list RPAREN block
            { $$ = M_StaticMethod($2, $3, $5, $7); }
        | STATIC ptr_type name_token LPAREN param_list RPAREN block
            { $$ = M_StaticMethod($2, $3, $5, $7); }
        | STATIC array_type name_token LPAREN param_list RPAREN block
            { $$ = M_StaticMethod($2, $3, $5, $7); }
        | name_token LPAREN param_list RPAREN block
            { $$ = M_Constructor($1, $3, $5); } ;

/* 重载声明里的运算符名 */
OPNAME := PLUS    { $$ = M_Op(0); }  | MINUS { $$ = M_Op(1); }
        | STAR    { $$ = M_Op(2); }  | SLASH { $$ = M_Op(3); }
        | PERCENT { $$ = M_Op(4); }  | EQ    { $$ = M_Op(5); }
        | NE      { $$ = M_Op(6); }  | LT    { $$ = M_Op(7); }
        | LE      { $$ = M_Op(8); }  | GT    { $$ = M_Op(9); }
        | GE      { $$ = M_Op(10); } | AMP   { $$ = M_Op(11); }
        | PIPE    { $$ = M_Op(12); } | CARET { $$ = M_Op(13); }
        | SHL     { $$ = M_Op(14); } | SHR   { $$ = M_Op(15); } ;

/* ---- 运算符重载：顶层的自由函数，左 / 右操作数都显式写出来 ---- */
operator_def := type name_token OPNAME LPAREN param COMMA param RPAREN block
    { $$ = M_OperatorDef($1, $2, $3, M_List2($5, $7), $9); } ;

/* ---- 函数 ---- */
func_def := type name_token LPAREN param_list RPAREN block
    { $$ = M_Func($1, $2, $4, $6); }
    /* 返回引用的函数：`Cell mut& push_front(Cell mut& head, int64 value)` */
  | ptr_type name_token LPAREN param_list RPAREN block
    { $$ = M_Func($1, $2, $4, $6); }
  | array_type name_token LPAREN param_list RPAREN block
    { $$ = M_Func($1, $2, $4, $6); }
  | AUTO name_token LPAREN param_list RPAREN block
    { $$ = M_Func(-1, $2, $4, $6); } ;

/* ---- C++ 胶水声明 ---- */
host_type_decl := TYPE_KW name_token ASSIGN type SEMI
    { $$ = M_HostType($2, $4); }
  | TYPE_KW name_token ASSIGN ptr_type SEMI
    { $$ = M_HostType($2, $4); } ;

host_func_decl := type name_token LPAREN param_list RPAREN SEMI
    { $$ = M_ExternFunc($1, $2, $4); }
  | ptr_type name_token LPAREN param_list RPAREN SEMI
    { $$ = M_ExternFunc($1, $2, $4); }
  | type YIELD LPAREN param_list RPAREN SEMI
    { $$ = M_ExternFunc($1, M_YieldName(), $4); }
  | ptr_type YIELD LPAREN param_list RPAREN SEMI
    { $$ = M_ExternFunc($1, M_YieldName(), $4); } ;

/* 同一 C ABI 动态库的签名集中声明；右侧是实际导出符号。 */
abi_block := ABI_KW STRING LBRACE abi_func_list RBRACE
    { $$ = M_AbiBlock($2, $4); } ;
abi_func_list := %empty { $$ = M_List(); }
               | abi_func_list abi_func { M_ListAdd($1, $2); $$ = $1; } ;
abi_func := type name_token LPAREN param_list RPAREN ASSIGN STRING LBRACKET STRING RBRACKET SEMI
    { $$ = M_AbiOwned(M_AbiFunc($1, $2, $4, $7), $9); }
          | ptr_type name_token LPAREN param_list RPAREN ASSIGN STRING LBRACKET STRING RBRACKET SEMI
    { $$ = M_AbiOwned(M_AbiFunc($1, $2, $4, $7), $9); }
          | array_type name_token LPAREN param_list RPAREN ASSIGN STRING LBRACKET name_token COMMA STRING RBRACKET SEMI
    { $$ = M_AbiOwned(M_AbiBufferFunc($1, $2, $4, $7, $9), $11); }
          | array_type name_token LPAREN param_list RPAREN ASSIGN STRING LBRACKET name_token RBRACKET SEMI
    { $$ = M_AbiBufferFunc($1, $2, $4, $7, $9); }
          | array_type name_token LPAREN param_list RPAREN LBRACKET name_token RBRACKET SEMI
    { $$ = M_AbiBufferFunc($1, $2, $4, -1, $7); }
          | type name_token LPAREN param_list RPAREN ASSIGN STRING SEMI
    { $$ = M_AbiFunc($1, $2, $4, $7); }
          | ptr_type name_token LPAREN param_list RPAREN ASSIGN STRING SEMI
    { $$ = M_AbiFunc($1, $2, $4, $7); }
          | type name_token LPAREN param_list RPAREN SEMI
    { $$ = M_AbiFunc($1, $2, $4, -1); }
          | ptr_type name_token LPAREN param_list RPAREN SEMI
    { $$ = M_AbiFunc($1, $2, $4, -1); } ;

/* 宿主类型实现一个单方法接口。泛型接口在进入文法前已单态化成普通标识符。 */
host_impl_decl := IMPL type COLON name_token ASSIGN name_token SEMI
    { $$ = M_HostImpl($2, $4, $6); }
  | IMPL ptr_type COLON name_token ASSIGN name_token SEMI
    { $$ = M_HostImpl($2, $4, $6); } ;

/* 0.12.0 仅接受返回类型前置语法；形参仅包含类型。 */
function_type := fn_signature { $$ = M_FnSignatureType($1); } ;
fn_signature := type FN LPAREN function_params RPAREN { $$ = M_FnSignature($1, $4); }
    | ptr_type FN LPAREN function_params RPAREN { $$ = M_FnSignature($1, $4); }
    | LPAREN array_type RPAREN FN LPAREN function_params RPAREN { $$ = M_FnSignature($2, $6); }
    | LPAREN function_type RPAREN FN LPAREN function_params RPAREN { $$ = M_FnSignature($2, $6); } ;
function_params := %empty { $$ = M_List(); }
                 | function_params_nonempty { $$ = $1; } ;
function_params_nonempty := function_param { $$ = M_List1($1); }
                          | function_params_nonempty COMMA function_param
                            { M_ListAdd($1, $3); $$ = $1; } ;
function_param := param { $$ = $1; }
                | type { $$ = M_FunctionParameter($1, 0); }
                | ptr_type { $$ = M_FunctionParameter($1, 0); }
                | array_type { $$ = M_FunctionParameter($1, 0); }
                | type ELLIPSIS { $$ = M_FunctionParameter($1, 1); }
                | ptr_type ELLIPSIS { $$ = M_FunctionParameter($1, 1); } ;

param_list := %empty { $$ = M_List(); }
            | param_list_nonempty { $$ = $1; } ;

param_list_nonempty := param                            { $$ = M_List1($1); }
                     | param_list_nonempty COMMA param { M_ListAdd($1, $3); $$ = $1; } ;

/* `int64[] a` 与 `int64 a[]` 两种写法都归到**运行时长度数组**：长度跟着实参走，
 * 函数里 `a[i]` 一样能查越界（不需要再额外传长度）。 */
param := type name_token ASSIGN expr { $$ = M_DefaultParam(M_Param($1, $2), $4); }
       | ptr_type name_token ASSIGN expr { $$ = M_DefaultParam(M_Param($1, $2), $4); }
       | array_type name_token ASSIGN expr { $$ = M_DefaultParam(M_Param($1, $2), $4); }
       | type name_token LBRACKET RBRACKET ASSIGN expr { $$ = M_DefaultParam(M_Param(M_TypeRuntimeArray($1), $2), $6); }
       | type name_token               { $$ = M_Param($1, $2); }
       | type ELLIPSIS name_token      { $$ = M_VariadicParam($1, $3); }
       | ptr_type name_token           { $$ = M_Param($1, $2); }
       | ptr_type ELLIPSIS name_token  { $$ = M_VariadicParam($1, $3); }
       | array_type name_token         { $$ = M_Param($1, $2); }
       | type name_token LBRACKET RBRACKET { $$ = M_Param(M_TypeRuntimeArray($1), $2); } ;

/* ---- 变量声明（可带初值，逗号多声明）---- */
global_decl := type declarator_list SEMI
                 { M_SetDeclType($2, $1, 0); $$ = M_GlobalDecl($1, $2, 0); }
             | ptr_type declarator_list SEMI
                 { M_SetDeclType($2, $1, 0); $$ = M_GlobalDecl($1, $2, 0); }
             | CONST type declarator_list SEMI
                 { M_SetDeclType($3, $2, 1); $$ = M_GlobalDecl($2, $3, 1); }
             | CONST ptr_type declarator_list SEMI
                 { M_SetDeclType($3, $2, 1); $$ = M_GlobalDecl($2, $3, 1); }
             | AUTO declarator_list SEMI
                 { M_SetDeclType($2, -1, 0); $$ = M_GlobalDecl(-1, $2, 0); } ;

declarator_list := declarator                          { $$ = M_List1($1); }
                 | declarator_list COMMA declarator { M_ListAdd($1, $3); $$ = $1; } ;

/* 第二个参数是"维度表节点"：-1 表示**不是数组**（数组的维度表由 M_Dims1 / M_Dims2 造）。 */
declarator := name_token                       { $$ = M_Decl($1, -1, -1); }
            | name_token LBRACKET expr RBRACKET
                { $$ = M_Decl2($1, M_Dims1($3), -1); }
            | name_token LBRACKET expr RBRACKET LBRACKET expr RBRACKET
                { $$ = M_Decl2($1, M_Dims2($3, $6), -1); }
            | name_token ASSIGN expr           { $$ = M_Decl($1, -1, $3); }
            | name_token LBRACKET expr RBRACKET ASSIGN expr
                { $$ = M_Decl2($1, M_Dims1($3), $6); }
            | name_token LBRACKET expr RBRACKET LBRACKET expr RBRACKET ASSIGN expr
                { $$ = M_Decl2($1, M_Dims2($3, $6), $9); }
            /* `T a[] = new T[N];`（中括号写在名字这一侧的运行时数组写法） */
            | name_token LBRACKET RBRACKET
                { $$ = M_Decl($1, -2, -1); }
            | name_token LBRACKET RBRACKET ASSIGN expr
                { $$ = M_Decl($1, -2, $5); } ;

/* ---- 语句 ---- */
block := LBRACE RBRACE { $$ = M_Block(M_List()); }
       | LBRACE nonempty_stmt_list RBRACE { $$ = M_Block($2); } ;
nonempty_stmt_list := stmt { $$ = M_List1($1); }
                   | nonempty_stmt_list stmt { M_ListAdd($1, $2); $$ = $1; } ;

stmt_list := %empty { $$ = M_List(); }
           | stmt_list stmt { M_ListAdd($1, $2); $$ = $1; } ;

stmt := block                  { $$ = $1; }
      | decl_stmt              { $$ = $1; }
      | DEFER stmt             { $$ = M_Defer($2); }
      | SCOPE_EXIT LPAREN name_token RPAREN block { $$ = M_ScopeExit($3, $5); }
      | if_stmt                { $$ = $1; }
      | while_stmt             { $$ = $1; }
      | loop_stmt              { $$ = $1;}
      | for_in_stmt            { $$ = $1; }
      | match_stmt %prec SEMI  { $$ = $1; }
      | match_stmt SEMI        { $$ = $1; }
      | RETURN expr SEMI       { $$ = M_ReturnValue($2); }
      | RETURN tuple_items SEMI { $$ = M_Return(M_Tuple($2)); }
      | RETURN SEMI            { $$ = M_Return(-1); }

      | BREAK SEMI             { $$ = M_Break(-1); }
      | YIELD expr SEMI        { $$ = M_Break($2); }
      | BREAK name_token SEMI  { $$ = M_NameIsAll($2) ? M_BreakLevel(-1) : M_ParseBadBreakAllSugar(); }
      | BREAK name_token NUMBER SEMI { $$ = M_NameIsLevel($2) ? M_BreakLevel($3) : M_ParseBadLevelSugar(); }
      | BREAK name_token name_token SEMI { $$ = (M_NameIsLevel($2) && M_NameIsAll($3)) ? M_BreakLevel(-1) : M_ParseBadLevelAllSugar(); }
      | CONTINUE SEMI          { $$ = M_Continue(); }
      | expression_items SEMI { $$ = M_AssignTuple($1); } ;

/* match 不穿透，也不写 break；`_` 是兜底模式。 */
match_stmt := MATCH LPAREN expr RPAREN LBRACE match_item_list RBRACE
    { $$ = M_Match($3, $6); } ;

match_item_list := %empty                         { $$ = M_List(); }
                 | match_item_list match_item     { M_ListAdd($1, $2); $$ = $1; } ;

match_item := match_patterns IF expr FATARROW if_block
                { $$ = M_CaseBlock($1, $3, $5); }
            | WILDCARD IF expr FATARROW if_block
                { $$ = M_CaseBlock(-1, $3, $5); }
            | match_patterns FATARROW if_block
                { $$ = M_CaseBlock($1, -1, $3); }
            | WILDCARD FATARROW if_block
                { $$ = M_CaseBlock(-1, -1, $3); } ;

/* 模式位置的 | 表示备选模式；普通表达式中的 | 仍是位或。 */
match_patterns := match_pattern { $$ = M_List1($1); }
                | match_patterns PIPE match_pattern { M_ListAdd($1, $3); $$ = $1; } ;
match_pattern := bxor_expr { $$ = $1; } ;

/* 局部变量 */
decl_stmt := AUTO LPAREN destructure_items RPAREN ASSIGN expr SEMI
               { $$ = M_Destructure($3, $6); }
           /* 具名闭包只属于声明语句；返回类型是参数和函数体的类型锚点。 */
           | type name_token LPAREN param_list RPAREN block
               { $$ = M_NamedFunction($1, $2, $4, $6, 0); }
           | type name_token LPAREN param_list RPAREN MUT block
               { $$ = M_NamedFunction($1, $2, $4, $7, 1); }
           | type name_token LPAREN param_list RPAREN COPY block
               { $$ = M_NamedFunction($1, $2, $4, $7, 2); }
           | type name_token LPAREN param_list RPAREN MOVE block
               { $$ = M_NamedFunction($1, $2, $4, $7, 3); }
           | type name_token LPAREN param_list RPAREN SEMI
               { $$ = M_NamedFunction($1, $2, $4, -1, 0); }
           | ptr_type name_token LPAREN param_list RPAREN block
               { $$ = M_NamedFunction($1, $2, $4, $6, 0); }
           | ptr_type name_token LPAREN param_list RPAREN SEMI
               { $$ = M_NamedFunction($1, $2, $4, -1, 0); }
           /* 与位与表达式共享前缀，见到初始化的 = 后才确定具名引用声明。 */
           | band_expr AMP name_token ASSIGN expr SEMI
               { $$ = M_ReadOnlyReferenceDecl($1, $3, $5); }
           | band_expr AMP name_token ASSIGN expr COMMA declarator_list SEMI
               { $$ = M_ReadOnlyReferenceDecl($1, $3, $5, $7); }
           | type declarator_list SEMI
               { M_SetDeclType($2, $1, 0); $$ = M_LocalDecl($1, $2, 0); }
           | ptr_type declarator_list SEMI
               { M_SetDeclType($2, $1, 0); $$ = M_LocalDecl($1, $2, 0); }
           | CONST type declarator_list SEMI
               { M_SetDeclType($3, $2, 1); $$ = M_LocalDecl($2, $3, 1); }
           | CONST ptr_type declarator_list SEMI
               { M_SetDeclType($3, $2, 1); $$ = M_LocalDecl($2, $3, 1); }
           | AUTO declarator_list SEMI
               { M_SetDeclType($2, -1, 0); $$ = M_LocalDecl(-1, $2, 0); } ;

/* 解构使用现有 auto；只声明局部变量，嵌套括号对应嵌套元组。 */
destructure_items := destructure_binding COMMA destructure_binding { $$ = M_List2($1, $3); }
                   | destructure_items COMMA destructure_binding { M_ListAdd($1, $3); $$ = $1; } ;
destructure_binding := name_token { $$ = M_Var($1); }
                     | WILDCARD { $$ = M_DestructureIgnore(); }
                     | LPAREN destructure_items RPAREN { $$ = $2; } ;

/* if / elif / else：else 后面**必须**是大括号 —— 悬空 else 从文法上就不存在 */
if_block := block { $$ = $1; }
          | LBRACE expr RBRACE { $$ = M_ValueBlock($2); } ;

if_stmt := IF LPAREN expr RPAREN if_block elif_list else_part
    { $$ = M_If($3, $5, $6, $7); } ;

elif_list := %empty { $$ = M_List(); }
           | elif_list ELIF LPAREN expr RPAREN if_block { M_ListAdd($1, M_Elif($4, $6)); $$ = $1; } ;

else_part := %empty             { $$ = -1; }
           | ELSE if_block      { $$ = $2; } ;

while_stmt := WHILE LPAREN expr RPAREN block { $$ = M_While($3, $5); } ;
loop_stmt := LOOP block { $$ = M_Loop($2); } ;

loop_expr := LOOP block { $$ = M_Loop($2); }
           | WHILE LPAREN expr RPAREN if_block ELSE if_block
               { $$ = M_BlockValue(M_Block(M_List2(M_While($3, $5), $7))); }
           | FOR LPAREN name_token IN for_in_source RPAREN if_block ELSE if_block
               { $$ = M_BlockValue(M_Block(M_List2(M_Foreach(-1, $3, -1, $5, $7), $9))); }
           | FOR LPAREN AUTO name_token IN for_in_source RPAREN if_block ELSE if_block
               { $$ = M_BlockValue(M_Block(M_List2(M_Foreach(-1, $4, -1, $6, $8), $10))); }
           | FOR LPAREN type name_token IN for_in_source RPAREN if_block ELSE if_block
               { $$ = M_BlockValue(M_Block(M_List2(M_Foreach($3, $4, -1, $6, $8), $10))); }
           | FOR LPAREN ptr_type name_token IN for_in_source RPAREN if_block ELSE if_block
               { $$ = M_BlockValue(M_Block(M_List2(M_Foreach($3, $4, -1, $6, $8), $10))); } ;

/* for (x in src) / for (auto x in src) / for (T x in src) / for (T* x in src) */
for_in_stmt := FOR LPAREN name_token IN for_in_source RPAREN block
                  { $$ = M_Foreach(-1, $3, -1, $5, $7); }
  | FOR LPAREN AUTO name_token IN for_in_source RPAREN block
                  { $$ = M_Foreach(-1, $4, -1, $6, $8); }
  | FOR LPAREN type name_token IN for_in_source RPAREN block
                  { $$ = M_Foreach($3, $4, -1, $6, $8); }
  | FOR LPAREN ptr_type name_token IN for_in_source RPAREN block
                  { $$ = M_Foreach($3, $4, -1, $6, $8); } ;

/* 区间作为内部 Iterator<T>，和普通迭代源共用 for-in。 */
for_in_source := expr { $$ = $1; } ;

/* new/heap 糖的类型位 */
heap_type := name_token { $$ = $1; }
           | builtin_type { $$ = $1; } ;


/* ---- 表达式 ---- */
expr := assign_expr { $$ = M_CheckUpdates($1); } ;

assign_expr := or_expr                    { $$ = $1; }
             | unary ASSIGN assign_expr   { $$ = M_Assign($1, $3); }
             | unary ADD_ASSIGN assign_expr { $$ = M_CompoundAssign(8, $1, $3); }
             | unary SUB_ASSIGN assign_expr { $$ = M_CompoundAssign(9, $1, $3); }
             | unary MUL_ASSIGN assign_expr { $$ = M_CompoundAssign(10, $1, $3); }
             | unary DIV_ASSIGN assign_expr { $$ = M_CompoundAssign(11, $1, $3); }
             | unary MOD_ASSIGN assign_expr { $$ = M_CompoundAssign(12, $1, $3); }
             | unary AND_ASSIGN assign_expr { $$ = M_CompoundAssign(13, $1, $3); }
             | unary OR_ASSIGN assign_expr { $$ = M_CompoundAssign(14, $1, $3); }
             | unary XOR_ASSIGN assign_expr { $$ = M_CompoundAssign(15, $1, $3); }
             | unary SHL_ASSIGN assign_expr { $$ = M_CompoundAssign(16, $1, $3); }
             | unary SHR_ASSIGN assign_expr { $$ = M_CompoundAssign(17, $1, $3); } ;

or_expr := or_expr OR and_expr  { $$ = M_BinOp(0, $1, $3); }
         | and_expr             { $$ = $1; } ;

and_expr := and_expr AND bor_expr { $$ = M_BinOp(1, $1, $3); }
          | bor_expr             { $$ = $1; } ;

/* 位运算按 C 的优先级：`|` < `^` < `&`（都在 == / 比较之下、&& 之上） */
bor_expr := bor_expr PIPE bxor_expr { $$ = M_BinOp(14, $1, $3); }
          | bxor_expr               { $$ = $1; } ;

bxor_expr := bxor_expr CARET band_expr { $$ = M_BinOp(15, $1, $3); }
           | band_expr                 { $$ = $1; } ;

band_expr := band_expr AMP eq_expr { $$ = M_BinOp(13, $1, $3); }
           | eq_expr               { $$ = $1; } ;

eq_expr := eq_expr EQ rel_expr { $$ = M_BinOp(2, $1, $3); }
         | eq_expr NE rel_expr { $$ = M_BinOp(3, $1, $3); }
         | rel_expr            { $$ = $1; } ;

rel_expr := rel_expr LT shift_expr { $$ = M_BinOp(4, $1, $3); }
          | rel_expr LE shift_expr { $$ = M_BinOp(5, $1, $3); }
          | rel_expr GT shift_expr { $$ = M_BinOp(6, $1, $3); }
          | rel_expr GE shift_expr { $$ = M_BinOp(7, $1, $3); }
          | shift_expr             { $$ = $1; } ;

/* 移位比加减低一级（与 C 一致） */
shift_expr := shift_expr SHL add_expr { $$ = M_BinOp(16, $1, $3); }
            | shift_expr SHR add_expr { $$ = M_BinOp(17, $1, $3); }
            | add_expr                { $$ = $1; } ;

add_expr := add_expr PLUS mul_expr  { $$ = M_BinOp(8, $1, $3); }
          | add_expr MINUS mul_expr { $$ = M_BinOp(9, $1, $3); }
          | mul_expr                { $$ = $1; } ;

mul_expr := mul_expr STAR mul_expr2    { $$ = M_BinOp(10, $1, $3); }
          | mul_expr SLASH mul_expr2   { $$ = M_BinOp(11, $1, $3); }
          | mul_expr PERCENT mul_expr2 { $$ = M_BinOp(12, $1, $3); }
          | mul_expr2                  { $$ = $1; } ;

mul_expr2 := unary { $$ = $1; } ;

unary := INCREMENT unary { $$ = M_Update(1, 1, $2); }
       | DECREMENT unary { $$ = M_Update(-1, 1, $2); }
       | NOT unary        { $$ = M_UnOp(0, $2); }
       | MINUS unary      { $$ = M_UnOp(1, $2); }
       | PLUS unary       { $$ = M_UnOp(5, $2); }   /* 一元 `+x`（用户类型可重载） */
       | TILDE unary      { $$ = M_UnOp(3, $2); }   /* 按位取反 `~x` */
       | STAR unary       { $$ = M_UnOp(2, $2); }   /* 解引用 `*p` */
       | AMP unary        { $$ = M_UnOp(4, $2); }   /* 取地址 `&x`（得到只读引用） */
       /* 分配语法：删除裸 new; 与裸 new(args)，改为显式写出类型：
        *   heap T           ≡ 原 new;（堆上分配 T，类型由左值推导）
        *   new T(args)      ≡ 原 new(args);（按目标类型构造，类型显式写出）
        *   heap new T(args) ≡ 原 new(args);（堆上构造）
        * 数组仍以 new [n] 形式保留（元素类型由左值推导）。 */
       | NEW LBRACKET expr RBRACKET { $$ = M_NewPtr($3); }
       | NEW heap_type LPAREN call_args RPAREN { $$ = M_Construct(-1, $4, -1); }
       | HEAP heap_type { $$ = M_HeapSugar($2); }
       | HEAP NEW heap_type LPAREN call_args RPAREN { $$ = M_HeapNewSugar($3, $5); }
       | cast_expr        { $$ = $1; } ;

/* new 一个对象 / new [n]  */
cast_expr := LPAREN builtin_type RPAREN unary  { $$ = M_Cast($2, $4); }
           | LPAREN band_expr AMP RPAREN unary { $$ = M_Cast(M_ReadOnlyReferenceType($2), $5); }
           | LPAREN ptr_type RPAREN unary      { $$ = M_Cast($2, $4); }
           | CAST_KW LT type GT LPAREN expr RPAREN { $$ = M_Cast($3, $6); }
           | postfix                       { $$ = $1; } ;

/* 字符串值与引用的 [] 统一访问字符；显式 Index 调用访问缓冲区元素。 */
closure_type_arguments := element_type { $$ = M_List1(M_TupleTypeItem($1)); }
                        | closure_type_arguments COMMA element_type { M_ListAdd($1, M_TupleTypeItem($3)); $$ = $1; } ;

postfix := postfix CLOSURE_ARGS_BEGIN closure_type_arguments CLOSURE_ARGS_END { $$ = M_ClosureSelect($1, $3); }
         | postfix INCREMENT { $$ = M_Update(1, 0, $1); }
         | postfix DECREMENT { $$ = M_Update(-1, 0, $1); }
         | postfix LBRACKET expr RBRACKET { $$ = M_Index($1, $3); }
         | postfix QUESTION                    { $$ = M_Try($1); }
         | postfix LBRACKET expr COLON expr RBRACKET { $$ = M_Slice($1, $3, $5); }
         | postfix LBRACKET expr COLON RBRACKET      { $$ = M_Slice($1, $3, -1); }
         | postfix DOT name_token              { $$ = M_Member($1, $3); }
         | postfix DOT NUMBER                { $$ = M_TupleMember($1, $3); }
         | postfix ARROW name_token            { $$ = M_Arrow($1, $3); }
         | postfix DOT DROP                  { $$ = M_Member($1, M_KeywordName(1)); }
         | postfix ARROW DROP                { $$ = M_Arrow($1, M_KeywordName(1)); }
         | postfix DOT OPCODE                { $$ = M_Member($1, M_KeywordName(5)); }
         | postfix ARROW OPCODE              { $$ = M_Arrow($1, M_KeywordName(5)); }
         | postfix LPAREN call_args RPAREN { $$ = M_CallOn($1, $3); }
         | primary                        { $$ = $1; } ;

call_args := %empty { $$ = M_List(); }
           | call_args_nonempty { $$ = $1; } ;

call_args_nonempty := expr                                { $$ = M_List1($1); }
                    | call_args_nonempty COMMA expr { M_ListAdd($1, $3); $$ = $1; } ;

/* 调用只有"后缀"一条路径 */
primary := name_token                         { $$ = M_Var($1); }
         | lambda_expr                     { $$ = $1; }
         | qualified_ref                    { $$ = $1; }
         | NUMBER                        { $$ = $1; }
         | ULIT                          { $$ = $1; }
         | HEXLIT                        { $$ = $1; }
         | BINLIT                        { $$ = $1; }
         | FLIT                          { $$ = $1; }
         | string_literal                 { $$ = M_Str($1); }
         | interpolated_string            { $$ = $1; }
         | TYPECHECK LPAREN element_type COMMA expr RPAREN { $$ = M_CheckType($3, $5); }
         | CHRLIT                        { $$ = M_Char($1); }
         | TRUE                          { $$ = M_Bool(1); }
         | FALSE                         { $$ = M_Bool(0); }
         | loop_expr                     { $$ = $1; }
         | z_block_value                 { $$ = $1; }
         | z_if_value                    { $$ = $1; }
         | z_match_value                 { $$ = $1; }
         | TYPE_TAG LPAREN element_type RPAREN { $$ = M_TypeTagType($3); }
         | collection_literal           { $$ = $1; }
         | LPAREN tuple_items RPAREN { $$ = M_Tuple($2); }
         | LPAREN expr RPAREN            { $$ = $2; } ;

/* 语句归约先于有值适配，保留无分号的普通 if 语句。 */
z_if_value := if_stmt { $$ = M_IfValue($1); } ;
z_match_value := match_stmt %prec SEMI { $$ = M_MatchValue($1); } ;

/* 非空语句块可作为表达式；空花括号保留集合字面量含义。 */
z_block_value := LBRACE nonempty_stmt_list RBRACE { $$ = M_BlockValue(M_Block($2)); } ;

/* 插值边界由词法层归一化，完整表达式与嵌套仍由文法解析。 */
interpolated_string := FSTRING LPAREN call_args RPAREN { $$ = M_FString($3); } ;

/* lambda 的块、表达式体、参数及返回签名均由生成解析器识别。 */
name_token := VARIABLE { $$ = $1; } | COPY { $$ = M_KeywordName(3); } | MOVE { $$ = M_KeywordName(4); } ;
lambda_capture := %empty { $$ = 0; }
                | CONST { $$ = 0; }
                | MUT { $$ = 1; }
                | COPY { $$ = 2; }
                | MOVE { $$ = 3; } ;
lambda_keyword := FN { $$ = 0; } ;
/* 模板归一化前的泛型闭包保留参数、约束、捕获和完整函数体的结构。 */
generic_closure_parameter := name_token { $$ = M_GenericClosureParameter($1, -1, -1); }
    | name_token COLON element_type { $$ = M_GenericClosureParameter($1, $3, -1); }
    | name_token ASSIGN element_type { $$ = M_GenericClosureParameter($1, -1, $3); }
    | name_token COLON element_type ASSIGN element_type { $$ = M_GenericClosureParameter($1, $3, $5); } ;
generic_closure_parameters := generic_closure_parameter { $$ = M_List1($1); }
    | generic_closure_parameters COMMA generic_closure_parameter { M_ListAdd($1, $3); $$ = $1; } ;
generic_closure_head := FN LT generic_closure_parameters GT { $$ = $3; } ;

lambda_expr := fn_signature lambda_body { $$ = M_FnSignatureLambda($1, $2); }
    | generic_closure_head lambda_capture LPAREN lambda_params RPAREN lambda_body
    { $$ = M_GenericClosureSyntax(-1, $1, $4, $6, -1, $2); }
    | generic_closure_head lambda_capture_groups lambda_capture LPAREN lambda_params RPAREN lambda_body
    { $$ = M_GenericClosureSyntax(-1, $1, $5, $7, $2, $3); }
    | lambda_keyword lambda_capture LPAREN lambda_params RPAREN lambda_body
    { $$ = M_Lambda(-1, $4, $6, $2); }
    | type lambda_keyword lambda_capture LPAREN lambda_params RPAREN lambda_body
    { $$ = M_Lambda($1, $5, $7, $3); }
    | ptr_type lambda_keyword lambda_capture LPAREN lambda_params RPAREN lambda_body
    { $$ = M_Lambda($1, $5, $7, $3); }
    | lambda_keyword lambda_capture_groups lambda_capture LPAREN lambda_params RPAREN lambda_body
    { $$ = M_LambdaListed(-1, $5, $7, $2, $3); }
    | type lambda_keyword lambda_capture_groups lambda_capture LPAREN lambda_params RPAREN lambda_body
    { $$ = M_LambdaListed($1, $6, $8, $3, $4); }
    | ptr_type lambda_keyword lambda_capture_groups lambda_capture LPAREN lambda_params RPAREN lambda_body
    { $$ = M_LambdaListed($1, $6, $8, $3, $4); } ;
lambda_capture_groups := lambda_capture_group { $$ = M_List1($1); }
                       | lambda_capture_groups lambda_capture_group { M_ListAdd($1, $2); $$ = $1; } ;
lambda_capture_group := CONST LBRACKET lambda_capture_names RBRACKET { $$ = M_CaptureGroup(0, $3); }
                      | MUT LBRACKET lambda_capture_names RBRACKET { $$ = M_CaptureGroup(1, $3); }
                      | COPY LBRACKET lambda_capture_names RBRACKET { $$ = M_CaptureGroup(2, $3); }
                      | MOVE LBRACKET lambda_capture_names RBRACKET { $$ = M_CaptureGroup(3, $3); } ;
lambda_capture_names := %empty { $$ = M_List(); }
                      | lambda_capture_names_nonempty { $$ = $1; } ;
lambda_capture_names_nonempty := name_token { $$ = M_List1($1); }
                               | lambda_capture_names_nonempty COMMA name_token { M_ListAdd($1, $3); $$ = $1; } ;
lambda_params := %empty { $$ = M_List(); }
               | lambda_params_nonempty { $$ = $1; } ;
lambda_params_nonempty := lambda_param { $$ = M_List1($1); }
                        | lambda_params_nonempty COMMA lambda_param { M_ListAdd($1, $3); $$ = $1; } ;
lambda_param := param { $$ = $1; }
              | name_token { $$ = M_Param(-1, $1); } ;
lambda_body := block { $$ = $1; }
             | LBRACE expr RBRACE { $$ = $2; } ;

/* 与 C 一样，连续字符串字面量在编译期直接合并  */
string_literal := STRING { $$ = $1; }
                | string_literal STRING { $$ = M_ConcatStringLiterals($1, $2); } ;

/* 花括号表达式完整描述 Set 元素、Map 键值、空值与可选末尾逗号。 */
collection_literal := LBRACE RBRACE { $$ = M_CollectionLiteral(0, M_List()); }
                    | LBRACE expression_items RBRACE { $$ = M_CollectionLiteral(1, $2); }
                    | LBRACE expression_items COMMA RBRACE { $$ = M_CollectionLiteral(1, $2); }
                    | LBRACE map_literal_items RBRACE { $$ = M_CollectionLiteral(2, $2); }
                    | LBRACE map_literal_items COMMA RBRACE { $$ = M_CollectionLiteral(2, $2); }
                    | LBRACKET RBRACKET { $$ = M_CollectionLiteral(3, M_List()); }
                    | LBRACKET expression_items RBRACKET { $$ = M_CollectionLiteral(3, $2); }
                    | LBRACKET expression_items COMMA RBRACKET { $$ = M_CollectionLiteral(3, $2); } ;
expression_items := expr { $$ = M_List1($1); }
                   | expression_items COMMA expr { M_ListAdd($1, $3); $$ = $1; } ;
map_literal_items := expr COLON expr { $$ = M_List2($1, $3); }
                   | map_literal_items COMMA expr COLON expr
                       { M_ListAdd($1, $3); M_ListAdd($1, $5); $$ = $1; } ;

qualified_ref := name_token SCOPE name_token
                   { $$ = M_EnumCtor($1, $3, M_List()); }
               | name_token SCOPE YIELD
                   { $$ = M_EnumCtor($1, M_YieldName(), M_List()); }
               | YIELD SCOPE name_token
                   { $$ = M_EnumCtor(M_YieldName(), $3, M_List()); }
               | YIELD SCOPE YIELD
                   { $$ = M_EnumCtor(M_YieldName(), M_YieldName(), M_List()); }
               | name_token SCOPE NEW
                   { $$ = M_EnumCtor($1, M_KeywordName(2), M_List()); }
               | YIELD SCOPE NEW
                   { $$ = M_EnumCtor(M_YieldName(), M_KeywordName(2), M_List()); }
               | qualified_ref SCOPE name_token
                   { $$ = M_QualifiedRef($1, $3); }
               | qualified_ref SCOPE YIELD
                   { $$ = M_QualifiedRef($1, M_YieldName()); } ;

