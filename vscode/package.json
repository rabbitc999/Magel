{
  "name": "chali-editor",
  "displayName": "ChaLi",
  "description": "ChaLi（.chl）语言支持：用编译器自带的 `chali lsp` 提供诊断、悬停、补全、跳转定义、文档大纲、格式化与宏块折叠。 支持在线模块依赖下载、共享缓存与离线校验。",
  "version": "1.0.0",
  "publisher": "rabbitc999",
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "author": {
    "name": "小兔糖糖OvO",
    "email": "rabbitc999@outlook.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "chali",
    "chl",
    "parseengine",
    "stackvm"
  ],
  "main": "./extension.js",
  "scripts": {
    "embed": "node tools/embed-compiler.js",
    "check": "node tools/check-manifest.js",
    "test": "node test/smoke.js && node test/dependencies.js && node test/macros.js && node test/lspCancellation.js && node test/semanticProviders.js && node test/macroHighlighting.js",
    "vscode:prepublish": "node tools/embed-compiler.js",
    "package": "node tools/package.js"
  },
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:chali",
    "onDebugResolve:chali",
    "onCommand:chali.installDependencies",
    "onCommand:chali.checkDependencies",
    "onCommand:chali.openLibraries",
    "onCommand:chali.previewMacroExpansion"
  ],
  "contributes": {
    "languages": [
      {
        "id": "chali",
        "aliases": [
          "ChaLi",
          "chali"
        ],
        "extensions": [
          ".chl"
        ],
        "configuration": "./chali-language-configuration.json"
      },
      {
        "id": "chali-svmb",
        "aliases": [
          "ChaLi 字节码",
          "ChaLi Bytecode"
        ],
        "extensions": [
          ".svmb"
        ]
      }
    ],
    "grammars": [
      {
        "language": "chali",
        "scopeName": "source.chali",
        "path": "./syntaxes/chali.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "chali",
        "label": "ChaLi",
        "languages": [
          "chali"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "要调试的 .chl 文件（缺省是当前打开的文件）。",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "传给被调试程序的命令行参数。",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "工作目录；缺省用源文件所在目录。",
                "default": "${fileDirname}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "chali",
            "request": "launch",
            "name": "ChaLi：调试当前文件",
            "program": "${file}",
            "cwd": "${fileDirname}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "ChaLi：调试当前文件",
            "description": "用编译器自带的调试器跑当前 .chl。",
            "body": {
              "type": "chali",
              "request": "launch",
              "name": "ChaLi：调试当前文件",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${fileDirname}\""
            }
          }
        ]
      }
    ],
    "configurationDefaults": {
      "[chali]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.suggest.showWords": false,
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "chali.restartServer",
        "title": "ChaLi: 重启语言服务器"
      },
      {
        "command": "chali.showServerLog",
        "title": "ChaLi: 显示语言服务器日志"
      },
      {
        "command": "chali.openDoc",
        "title": "ChaLi: 打开语言文档"
      },
      {
        "command": "chali.run",
        "title": "ChaLi: 运行当前文件",
        "icon": "$(play)"
      },
      {
        "command": "chali.installDependencies",
        "title": "ChaLi: 下载并锁定模块依赖"
      },
      {
        "command": "chali.checkDependencies",
        "title": "ChaLi: 离线校验模块依赖"
      },
      {
        "command": "chali.openLibraries",
        "title": "ChaLi: 打开在线依赖缓存"
      },
      {
        "command": "chali.previewMacroExpansion",
        "title": "ChaLi: 预览宏展开"
      }
    ],
    "configuration": {
      "title": "ChaLi",
      "properties": {
        "chali.path": {
          "type": "string",
          "default": "",
          "description": "chali 编译器路径（语言服务器内嵌在它里面：`chali lsp`）；留空时先用插件自带的 `bin/chali`（打包时内嵌），再在工作区与 PATH 里自动探测。"
        },
        "chali.traceServer": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages"
          ],
          "description": "把与 chali lsp 的协议消息写进输出面板，排查问题时打开。"
        },
        "chali.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "显示 let、for-in 元素与上下文匿名函数参数的推断类型；仍受编辑器内联提示设置控制。"
        }
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "chali.run",
          "when": "resourceLangId == chali",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "chali.run",
          "when": "resourceLangId == chali",
          "group": "navigation@1"
        },
        {
          "command": "chali.installDependencies",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.checkDependencies",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.openLibraries",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.previewMacroExpansion",
          "when": "editorLangId == chali && resourceScheme == file",
          "group": "chali@2"
        }
      ],
      "explorer/context": [
        {
          "command": "chali.installDependencies",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.checkDependencies",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        },
        {
          "command": "chali.openLibraries",
          "when": "resourceFilename == chali.toml",
          "group": "chaliDependencies"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rabbitc999/ChaLi.git"
  },
  "chaliCompilerVersion": "0.28.1"
}
