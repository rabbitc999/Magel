/* list —— 动态数组：push 400,000 个元素再遍历累乘，压的是容器增长与堆分配。 */

import std::clock;

const int64 N = 400000;
const int64 REPS = 5;

int64 work(int64 seed) {
    List<int64> xs;
    int64 i = 0;
    while (i < N) {
        xs.push(i * 3 + seed);
        i = i + 1;
    }
    int64 total = seed;
    i = 0;
    while (i < N) {
        total = (total * 31 + xs[i]) & 2147483647;
        i = i + 1;
    }
    return total;
}

void main() {
    int64 sink = work(0);
    int64 t[REPS];
    int64 r = 0;
    while (r < REPS) {
        int64 t0 = std::clock::nowNanos();
        sink = sink + work(r);
        int64 t1 = std::clock::nowNanos();
        t[r] = t1 - t0;
        r = r + 1;
    }
    r = 0;
    while (r < REPS) {
        println("rep {}", t[r]);
        r = r + 1;
    }
    println("sink {}", sink);
}
